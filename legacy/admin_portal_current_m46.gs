  function parseBreakTimeMinutesLooseV553(v){
    var raw=String(v==null?'':v);
    if(raw.normalize) raw=raw.normalize('NFKC');
    raw=raw.replace(/[\u00A0\u202F\u2007\u2060\ufeff]/g,' ')
      .replace(/[\u2010\u2011\u2012\u2013\u2014]/g,'-')
      .replace(/\./g,'')
      .trim();
    if(!raw)return null;
    // Keep stored minute values such as 570 usable, but treat 930/0930 as 9:30.
    var compact=raw.replace(/\s+/g,'');
    var m;
    if(/^\d{3,4}$/.test(compact)){
      var h=Number(compact.slice(0, compact.length-2));
      var mm=Number(compact.slice(-2));
      if(h>=0 && h<24 && mm>=0 && mm<60) return h*60+mm;
    }
    if(/^\d{1,2}$/.test(compact)){
      var hh=Number(compact);
      if(hh>=0 && hh<24) return hh*60;
    }
    if(/^\d+$/.test(compact)){
      var n=Number(compact);
      if(isFinite(n) && n>=0 && n<1440) return n;
    }
    m=raw.match(/(\d{1,2})\s*[:h]\s*([0-5]\d)\s*([AaPp])?\s*[Mm]?/);
    if(m){
      var hour=Number(m[1]), min=Number(m[2]), ap=(m[3]||'').toUpperCase();
      if(hour>=0 && hour<=24 && min>=0 && min<60){
        if(ap==='P' && hour<12) hour+=12;
        if(ap==='A' && hour===12) hour=0;
        if(hour===24) hour=0;
        return hour*60+min;
      }
    }
    m=raw.match(/(\d{1,2})\s*([AaPp])\s*[Mm]?/);
    if(m){
      var h2=Number(m[1]), ap2=m[2].toUpperCase();
      if(h2>=1 && h2<=12){
        if(ap2==='P' && h2<12) h2+=12;
        if(ap2==='A' && h2===12) h2=0;
        return h2*60;
      }
    }
    return null;
  }
