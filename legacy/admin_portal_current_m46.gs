  </style></head><body><h2>Staff Manager</h2>
  <div class="grid"><div><label>Search Staff</label><input id="search" oninput="buildStaffDropdown()" placeholder="Type to filter staff"></div><div><label>Existing Staff</label><select id="staffSelect" onchange="loadSelectedStaff()"></select></div><div class="nameBox"><label>Name</label><input id="name" placeholder="Staff name"></div><div><label>Support Type</label><select id="supportStaffType"></select></div><div><label>Status</label><select id="statusField"></select></div><div><label>Overtime Interest</label><select id="overtime"></select></div><div><label>Absent Today</label><input id="absent" readonly disabled aria-readonly="true" title="Read-only from Attendance Manager" value="No"></div><div><label>Total Absences</label><input id="totalAbsences" disabled></div></div>
