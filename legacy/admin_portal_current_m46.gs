function saveCalendarMonthFromManagerV5(payload) {
  const ss = getActiveSpreadsheetV5_();
  ensureCoreSheetsV5_(ss);
  ensureCalendarHeadersV5_(ss);
  const sheet = ss.getSheetByName(V5.SHEETS.CALENDAR);
  if (!sheet) throw new Error('Calendar Manager save failed: could not find the Calendar sheet/tab after header setup.');
  const days = Array.isArray(payload && payload.days) ? payload.days : [];
  const incoming = {};
  days.forEach(function(d) {
    const iso = clean_((d && (d.dateIso || d.iso)) || '');
    if (!/^\d{4}-\d{2}-\d{2}$/.test(iso)) return;
    incoming[iso] = {
      scheduleType: clean_(d && d.scheduleType),
      notes: clean_(d && d.notes)
    };
  });
  const isoKeys = Object.keys(incoming);
  if (!isoKeys.length) return getCalendarManagerDataV5(payload && payload.year, payload && payload.month);
  const header = sheet.getRange(1, 1, 1, Math.max(sheet.getLastColumn(), 6)).getDisplayValues()[0];
  function findCol(names, fallback) {
    const lower = header.map(function(h){return String(h || '').trim().toLowerCase();});
    for (let i = 0; i < names.length; i++) {
      const idx = lower.indexOf(String(names[i]).toLowerCase());
      if (idx >= 0) return idx + 1;
    }
    return fallback;
  }
  const colDate = findCol(['Date','ISO Date','School Date'], 1);
  const colSched = findCol(['Schedule Type','Bell Schedule','Schedule'], 2);
  const colNotes = findCol(['Notes','Note'], 3);
  const lastRow = sheet.getLastRow();
  if (lastRow >= 2) {
    const dateDisplay = sheet.getRange(2, colDate, lastRow - 1, 1).getDisplayValues();
    for (let r = dateDisplay.length - 1; r >= 0; r--) {
      const iso = calendarIsoFromValueV5_(dateDisplay[r][0], dateDisplay[r][0]);
      if (iso && Object.prototype.hasOwnProperty.call(incoming, iso)) sheet.deleteRow(r + 2);
    }
  }
  const width = Math.max(sheet.getLastColumn(), 6, colDate, colSched, colNotes);
  const rows = [];
  isoKeys.sort().forEach(function(iso) {
    const item = incoming[iso] || {};
    if (!item.scheduleType && !item.notes) return;
    const row = new Array(width).fill('');
    row[colDate - 1] = iso;
    row[colSched - 1] = item.scheduleType || '';
    row[colNotes - 1] = item.notes || '';
    rows.push(row);
  });
  if (rows.length) sheet.getRange(sheet.getLastRow() + 1, 1, rows.length, width).setValues(rows);
  try { sortCalendarSheetV5_(sheet); } catch (e) {}
  try { if (!(typeof getDatabaseStabilizedAtV5341_ === 'function' && getDatabaseStabilizedAtV5341_())) setupDataValidationV5_(ss); } catch (e) {}
  return getCalendarManagerDataV5(payload && payload.year, payload && payload.month);
}

