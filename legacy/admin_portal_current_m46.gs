// V5.1.402 Attendance Manager standardized staff dropdown source.
// Lightweight endpoint used only to populate the Admin Attendance staff dropdown from the
// selected school database's canonical/current staff list. This avoids waiting for the
// full Attendance Manager data object before the dropdown becomes usable.
// =====================================================================================
function getSchoolStaffListForAttendanceV5402(options) {
  options = options || {};
  const ss = getActiveSpreadsheetV5_();
  ensureCoreSheetsV5_(ss);
  const includeNonActive = !!options.showNonActive;
  const seen = {};
  let names = [];
  try {
    names = getCurrentStaffRowsV5340_(ss, includeNonActive).map(function(r) { return clean_(r && r.name); });
  } catch (err) {
    names = [];
  }
  if (!names.length) {
    // Fallback to the standardized Staff sheet name column if the canonical helper cannot
    // resolve current rows for an older/partially migrated school database.
    const sheet = ss.getSheetByName(V5.SHEETS.STAFF) || ss.getSheetByName('Staff') || ss.getSheetByName('Staff Manager');
    if (sheet && sheet.getLastRow() >= 2) {
      const headers = getHeaderMap_(sheet);
      const nameCol = findHeaderCol_(headers, ['name', 'staff name', 'staff'], 1);
      const statusCol = findHeaderCol_(headers, ['status', 'staff status', 'active status', 'active'], 0);
      const width = Math.max(sheet.getLastColumn(), nameCol, statusCol || 1);
      const values = sheet.getRange(2, 1, sheet.getLastRow() - 1, width).getDisplayValues();
      values.forEach(function(row) {
        const name = clean_(row[nameCol - 1]);
        if (!name) return;
        const status = statusCol ? normalizeName_(row[statusCol - 1]) : '';
        if (!includeNonActive && status && /^(inactive|not active|deleted|archived|former|removed)$/i.test(status)) return;
        names.push(name);
      });
    }
  }
  names = names.filter(function(name) {
    name = clean_(name);
    const key = normalizeName_(name);
    if (!key || seen[key]) return false;
    seen[key] = true;
    return true;
  }).sort(function(a, b) { return String(a).localeCompare(String(b)); });
  return {
    ok: true,
    version: '5.1.402',
    spreadsheetId: ss.getId(),
    spreadsheetName: ss.getName(),
    includeNonActive: includeNonActive,
    count: names.length,
    names: names,
    staff: names
  };
}



