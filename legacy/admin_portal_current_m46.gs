    ensureCampusPropertySheetHeaderV5264_(sheet);
    return sheet;
  }

  // Multiple Staff Portal/admin calls can arrive at the same time. Without a lock, two
  // executions may both see no _V5Properties sheet and then both try to insert it,
  // causing: "A sheet with the name _V5Properties already exists."
  let lock = null, locked = false;
  try {
    lock = LockService.getScriptLock();
    locked = lock.tryLock(8000);
  } catch (lockErr) {}

  try {
    sheet = ss.getSheetByName(V5263_CAMPUS_PROPERTY_SHEET);
    if (!sheet) {
      try {
        sheet = ss.insertSheet(V5263_CAMPUS_PROPERTY_SHEET);
      } catch (insertErr) {
        // If another execution created it after our second check, reuse that sheet.
        sheet = ss.getSheetByName(V5263_CAMPUS_PROPERTY_SHEET);
        if (!sheet) throw insertErr;
