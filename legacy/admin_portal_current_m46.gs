function buildStaffDataContributionSummaryV5288_(ss) {
  const studentSheet = ss.getSheetByName(V5.SHEETS.STUDENTS);
  if (!studentSheet || studentSheet.getLastRow() < 2) return {};
  const headers = getHeaderMap_(studentSheet);
  const linkCol = findHeaderCol_(headers, ['data files'], 37);
  const urls = studentSheet.getRange(2, linkCol, studentSheet.getLastRow() - 1, 1).getDisplayValues().flat().map(clean_);
  const staffNames = getStaffNamesV5288_(ss);
  const stats = {};
  staffNames.forEach(function(n){ stats[normalizeName_(n)] = { name:n, count:0, lastSubmittedMs:0, lastSubmitted:'' }; });
  urls.forEach(function(url) {
    if (!url || !/docs\.google\.com\/forms/i.test(url)) return;
    try {
      const form = FormApp.openByUrl(url);
      (form.getResponses() || []).forEach(function(resp) {
        const ts = resp.getTimestamp && resp.getTimestamp();
        if (!ts || !isOnOrAfterSchoolYearStartV5288_(ts)) return;
        const who = inferSubmittedStaffV5288_(resp, staffNames);
        if (!who.matchedStaff) return;
        const key = normalizeName_(who.matchedStaff);
        if (!stats[key]) stats[key] = { name:who.matchedStaff, count:0, lastSubmittedMs:0, lastSubmitted:'' };
        stats[key].count++;
        const ms = ts.getTime();
        if (ms > (stats[key].lastSubmittedMs || 0)) {
          stats[key].lastSubmittedMs = ms;
          stats[key].lastSubmitted = formatDateMmDdYyV5305_(ts, true);
        }
      });
    } catch (e) {}
  });
  try {
    const compact = {};
    Object.keys(stats).forEach(function(k){ compact[k] = { name:stats[k].name, count:stats[k].count, lastSubmitted:stats[k].lastSubmitted || '' }; });
    const json = JSON.stringify(compact);
    if (json.length < 9000) getV5PublishProps_().setProperty('V5_STAFF_DATA_STATS_V5288', json);
    getDocumentCacheV650_().put('V5_STAFF_DATA_STATS_V5288', json, 21600);
  } catch (e2) {}
  return stats;
}

