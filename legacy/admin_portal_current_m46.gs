function getCalendarManagerDataV5(year, month) {
  const ss = getActiveSpreadsheetV5_();
  ensureCoreSheetsV5_(ss);
  setupScheduleTemplateSheetV5_(ss);
  refreshV5ValidationHelpers();

  const today = new Date();
  const y = Number(year) || today.getFullYear();
  const m = Number(month) || (today.getMonth() + 1); // 1-12
  const first = new Date(y, m - 1, 1);
  const last = new Date(y, m, 0);
  const start = new Date(first);
  start.setDate(first.getDate() - first.getDay());
  const end = new Date(last);
  end.setDate(last.getDate() + (6 - last.getDay()));

  const cal = ss.getSheetByName(V5.SHEETS.CALENDAR);
  const values = cal.getDataRange().getValues();
  const display = cal.getDataRange().getDisplayValues();
  const byDate = {};
  for (let r = 1; r < values.length; r++) {
    const iso = calendarIsoFromValueV5_(values[r][0], display[r][0]);
    if (!iso) continue;
    byDate[iso] = {
      dateIso: iso,
      scheduleType: clean_(display[r][1] || values[r][1]),
      notes: clean_(display[r][2] || values[r][2]),
      rowIndex: r + 1
    };
  }

  const scheduleNames = getEffectiveScheduleTypesV5_(ss.getSheetByName(V5.SHEETS.CONFIG))
    .filter(Boolean);

  const days = [];
  const cur = new Date(start);
  while (cur <= end) {
    const iso = dateKeyV5_(cur);
    const rec = byDate[iso] || { dateIso: iso, scheduleType: '', notes: '' };
    days.push({
      dateIso: iso,
      day: cur.getDate(),
      inMonth: cur.getMonth() === (m - 1),
      isToday: iso === dateKeyV5_(today),
      scheduleType: rec.scheduleType || '',
      notes: rec.notes || ''
    });
    cur.setDate(cur.getDate() + 1);
  }

  return {
    year: y,
    month: m,
    monthName: Utilities.formatDate(first, 'America/Los_Angeles', 'MMMM yyyy'),
    todayIso: dateKeyV5_(today),
    scheduleNames: scheduleNames,
    days: days
  };
}

function saveCalendarMonthFromManagerV5(payload) {
  if (!payload || !payload.days) throw new Error('Missing calendar data.');
  const ss = getActiveSpreadsheetV5_();
  ensureCoreSheetsV5_(ss);
  ensureCalendarHeadersV5_(ss);
  const cal = ss.getSheetByName(V5.SHEETS.CALENDAR);
  if (!cal) throw new Error('Calendar Manager save failed: could not find the Calendar sheet/tab after header setup.');

  const values = cal.getDataRange().getValues();
  const display = cal.getDataRange().getDisplayValues();
  const rowByIso = {};
  for (let r = 1; r < values.length; r++) {
    const iso = calendarIsoFromValueV5_(values[r][0], display[r][0]);
    if (iso) rowByIso[iso] = r + 1;
  }

  const rowsToDelete = [];
  (payload.days || []).forEach(function(day) {
    const iso = clean_(day.dateIso);
    if (!iso) return;
    const scheduleType = clean_(day.scheduleType || '');
    const notes = clean_(day.notes || '');
    const rowIndex = rowByIso[iso];
    if (!scheduleType && !notes) {
      if (rowIndex) rowsToDelete.push(rowIndex);
      return;
    }
    const date = dateFromIsoV5_(iso);
    if (rowIndex) {
      cal.getRange(rowIndex, 1, 1, 3).setValues([[date, scheduleType, notes]]);
    } else {
      cal.appendRow([date, scheduleType, notes]);
    }
  });

  rowsToDelete.sort(function(a, b) { return b - a; }).forEach(function(row) { cal.deleteRow(row); });
  sortCalendarSheetV5_(cal);
  setupDataValidationV5_(ss);
  return getCalendarManagerDataV5(payload.year, payload.month);
}

function deleteCalendarDayFromManagerV5(dateIso) {
  const ss = getActiveSpreadsheetV5_();
  const cal = ss.getSheetByName(V5.SHEETS.CALENDAR);
  const values = cal.getDataRange().getValues();
  const display = cal.getDataRange().getDisplayValues();
  for (let r = values.length - 1; r >= 1; r--) {
    const iso = calendarIsoFromValueV5_(values[r][0], display[r][0]);
    if (iso === dateIso) cal.deleteRow(r + 1);
  }
  return { ok: true };
}

function sortCalendarSheetV5_(sheet) {
  const lastRow = sheet.getLastRow();
  if (lastRow > 2) sheet.getRange(2, 1, lastRow - 1, Math.max(3, sheet.getLastColumn())).sort([{ column: 1, ascending: true }]);
}

function calendarIsoFromValueV5_(value, display) {
  if (value instanceof Date && !isNaN(value.getTime())) return dateKeyV5_(value);
  const s = clean_(display || value);
  if (!s) return '';
  const iso = s.match(/^([0-9]{4})-([0-9]{2})-([0-9]{2})$/);
  if (iso) return s;
  const mdy = s.match(/^([0-9]{1,2})[\/\-]([0-9]{1,2})[\/\-]([0-9]{2,4})$/);
  if (mdy) {
    let y = Number(mdy[3]);
    if (y < 100) y += 2000;
    return dateKeyV5_(new Date(y, Number(mdy[1]) - 1, Number(mdy[2])));
  }
  const d = new Date(s);
  return isNaN(d.getTime()) ? '' : dateKeyV5_(d);
}

function dateFromIsoV5_(iso) {
  const m = String(iso || '').match(/^([0-9]{4})-([0-9]{2})-([0-9]{2})$/);
  if (!m) throw new Error('Invalid date: ' + iso);
  return new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
}

