      function save(){ const name=byId('name').value.trim(); if(!name){setMsg('Enter a schedule name.'); return;} const rows=collectRows(); const error=validateRows(rows); if(error){setMsg(error);return;} setMsg('Saving...'); google.script.run.withSuccessHandler(function(data){DATA=data;renderScheduleList();byId('existing').value=name;loadSelected();setMsg('Saved schedule template: '+name);}).withFailureHandler(function(err){setMsg(err.message||err);}).saveScheduleTemplateFromDialogV5({name:name,rows:rows}); }
