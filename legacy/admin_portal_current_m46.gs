function getGeneralStaffPoolForNeedV5_(model, item, needs, periodResult, anchor) {
  const base = model.staff.filter(function(s) { return !s.absent && !isStaffBlockedForItem_(s, item); });
  const originalOrder = new Map();
  model.staff.forEach(function(s, i) { originalOrder.set(s.name, i); });
  const load = model.__staffAssignmentLoad || new Map();
  return base.slice().sort(function(a, b) {
    const sa = scoreGeneralStaffForNeedV5_(model, item, needs, periodResult, anchor, a, originalOrder, load);
    const sb = scoreGeneralStaffForNeedV5_(model, item, needs, periodResult, anchor, b, originalOrder, load);
    if (sa.score !== sb.score) return sb.score - sa.score;
    return (originalOrder.get(a.name) || 0) - (originalOrder.get(b.name) || 0);
  });
}

function scoreGeneralStaffForNeedV5_(model, item, needs, periodResult, anchor, staff, originalOrder, load) {
  let score = 0;
  const staffKey = normalizeName_(staff.name);
  // Prefer staff who already have a relationship with this student in Periods 1-6 only.
  const rel = getStaffStudentRelationshipScoreV5_(model, anchor.student, staff.name, item.label);
  score += rel.score;
  // Stronger bonus when that relationship is immediately before/after today's item.
  score += getAdjacentRelationshipBonusV5_(model, anchor.student, staff.name, item.label);
  // Avoid using staff who are upcoming primary/secondary for later still-unassigned needs in this same period.
  score += getFuturePreferencePreservationScoreV5_(model, item, needs, periodResult, anchor, staffKey);
  // Optional balancing: prefer staff with fewer current assignments when setting says Yes.
  if (model.config && model.config.balanceGeneralAssignments) score -= (load.get(staff.name) || 0) * 6;
  // Staff row order/ranking remains the last tie-breaker, not part of score.
  return { score: score };
}

function getStaffStudentRelationshipScoreV5_(model, student, staffName, currentItemLabel) {
  const staffKey = normalizeName_(staffName);
  let score = 0;
  const labels = ['Period 1','Period 2','Period 3','Period 4','Period 5','Period 6'];
  labels.forEach(function(label) {
    if (label === currentItemLabel) return;
    const need = student.needs && student.needs[label];
    if (!need) return;
    if (normalizeName_(need.primary) === staffKey) score += 35;
    if (normalizeName_(need.secondary) === staffKey) score += 18;
  });
  return { score: score };
}

function getAdjacentRelationshipBonusV5_(model, student, staffName, currentItemLabel) {
  const idx = periodIndexV5_(currentItemLabel);
  if (idx < 1) return 0;
  const staffKey = normalizeName_(staffName);
  let bonus = 0;
  [idx - 1, idx + 1].forEach(function(n) {
    if (n < 1 || n > 6) return;
    const need = student.needs && student.needs['Period ' + n];
    if (!need) return;
    if (normalizeName_(need.primary) === staffKey) bonus += 20;
    if (normalizeName_(need.secondary) === staffKey) bonus += 10;
  });
  return bonus;
}

function periodIndexV5_(label) {
  const m = String(label || '').match(/Period\s*([1-6])/i);
  return m ? Number(m[1]) : 0;
}

function getFuturePreferencePreservationScoreV5_(model, item, needs, periodResult, anchor, staffKey) {
  let penalty = 0;
  needs.forEach(function(n) {
    if (n === anchor) return;
    if (periodResult.studentToStaff.has(n.student.name)) return;
    if (normalizeName_(n.primary) === staffKey) {
      penalty -= n.student.priority <= anchor.student.priority ? 120 : 45;
    }
    if (normalizeName_(n.secondary) === staffKey) {
      penalty -= n.student.priority <= anchor.student.priority ? 80 : 22;
    }
  });
  return penalty;
}

function runIndividualStarRescueV5_(model, item, needs, periodResult) {
  const triggerStudents = needs.filter(function(n) {
    return !periodResult.studentToStaff.has(n.student.name) &&
      n.student.priority <= model.config.individualStarThreshold &&
      isHighlyStructuredRoom_(model, n.location);
  }).sort(compareNeedPriority_);
  if (!triggerStudents.length) return;

  v5Log_('INFO', 'Individual* rescue cycle started for ' + item.label + '.', {
    period: item.label,
    explanation: 'Triggered only because an uncovered student is at or below the Individual* Rescue Threshold and is in a highly structured classroom.',
    triggers: triggerStudents.map(function(n){return n.student.name + ' (P' + n.student.priority + ', ' + n.location + ')';})
  });

  triggerStudents.forEach(function(trigger) {
    if (periodResult.studentToStaff.has(trigger.student.name)) return;
    const assignedIndividualStars = [];
    periodResult.staffAssignments.forEach(function(assignment, staffName) {
      assignment.needs.forEach(function(n) {
        if (n.support === 'INDIVIDUAL_STAR' && isHighlyStructuredRoom_(model, n.location)) {
          assignedIndividualStars.push({ need: n, assignment: assignment, staffName: staffName });
        }
      });
    });
    assignedIndividualStars.sort(function(a,b){return a.need.student.priority - b.need.student.priority;});
    for (let i = 0; i < assignedIndividualStars.length; i++) {
      const donor = assignedIndividualStars[i];
      const donorStaff = model.staffByName.get(normalizeName_(donor.staffName));
      if (!donorStaff) continue;
      const saved = cloneAssignmentForRescue_(donor.assignment);
      removeFullAssignment_(periodResult, donor.staffName);
      const temporaryNeed = Object.assign({}, donor.need, {support:'GROUP', supportRaw:'Individual* treated as Group'});
      const keeperCandidates = [];
      periodResult.staffAssignments.forEach(function(a, staffName) {
        if (a.locationKey === donor.need.locationKey && !a.containsIndividual) keeperCandidates.push({assignment:a, staffName:staffName});
      });
      let grouped = false;
      for (let k = 0; k < keeperCandidates.length; k++) {
        const keeperStaff = model.staffByName.get(normalizeName_(keeperCandidates[k].staffName));
        if (!keeperStaff) continue;
        if (canStaffTakeGroup_(model, keeperStaff, item, [temporaryNeed], periodResult)) {
          assignGroupToStaff_(model, keeperStaff, item, [temporaryNeed], periodResult, 'Individual* Rescue');
          grouped = true;
          break;
        }
      }
      if (!grouped) {
        restoreAssignmentForRescue_(periodResult, donor.staffName, saved);
        continue;
      }
      const targetGroup = buildAssignableGroupForStaff_(model, item, trigger, needs, donorStaff, periodResult, 'Individual* Rescue');
      if (targetGroup.length && canStaffTakeGroup_(model, donorStaff, item, targetGroup, periodResult)) {
        assignGroupToStaff_(model, donorStaff, item, targetGroup, periodResult, 'Individual* Rescue');
        v5Log_('WARN', 'Individual* rescue reassigned coverage for ' + trigger.student.name + '.', {
          period: item.label,
          trigger: trigger.student.name,
          individualStarGrouped: donor.need.student.name,
          explanation: donor.need.student.name + ' was temporarily treated as Group to free staff for an uncovered highly structured/threshold student.'
        });
        return;
      }
      removeStudentFromAssignmentV5_(periodResult, temporaryNeed.student.name);
      restoreAssignmentForRescue_(periodResult, donor.staffName, saved);
    }
  });
}

function removeStudentFromAssignmentV5_(periodResult, studentName) {
  const staffName = periodResult.studentToStaff.get(studentName);
  if (!staffName) return;
  const assignment = periodResult.staffAssignments.get(staffName);
  if (!assignment) return;
  assignment.needs = assignment.needs.filter(function(n){return n.student.name !== studentName;});
  assignment.studentNames = assignment.studentNames.filter(function(n){return n !== studentName;});
  periodResult.studentToStaff.delete(studentName);
  if (!assignment.needs.length) periodResult.staffAssignments.delete(staffName);
}

function runAssignmentGenieV5(payload) {
  const ss = getActiveSpreadsheetV5_();
  const baseModel = loadModelV5_(ss);
  const baseRun = buildAssignmentsBreaksWithEmergencyLunchV5_(baseModel);
  const baseUnassigned = (baseRun.assignments.unassigned || []).slice().sort(compareNeedPriority_);
  const allowed = new Set((payload && payload.rules) || []);
  const allowedUnstaffed = new Set((payload && payload.allowUnstaffedStudents) || []);
  if (!baseUnassigned.length) return { options: [], message: 'All students are staffed under the current legal rules.' };

  const baseUnassignedNames = Array.from(new Set(baseUnassigned.map(function(n){ return n.student.name; })));
  const baseUnassignedKey = function(list) {
    return Array.from(new Set((list || []).map(function(n){ return n.student ? n.student.name : String(n); }))).sort().join('|');
  };
  const baseCount = baseUnassignedNames.length;
  const candidates = [];

  const addRaw = function(rule, level, title, summary, covers, data, changes) {
    if (!allowed.has(rule)) return;
    const uniqueCovers = Array.from(new Set(covers || [])).filter(Boolean);
    if (!uniqueCovers.length) return;
    candidates.push({
      id: Utilities.getUuid(), rule: rule, ruleLevel: level, title: title, summary: summary,
      covers: uniqueCovers, data: data || {}, changes: changes || []
    });
  };

  // Group-cap candidates: create one candidate per uncovered room/period, but the candidate
  // must actually reduce the uncovered count in the simulation before it is shown.
  const capGroups = new Map();
  baseUnassigned.forEach(function(n) {
    if (n.support !== 'GROUP') return;
    const structured = isHighlyStructuredRoom_(baseModel, n.location);
    const rule = structured ? 'CAP_STRUCTURED' : 'CAP_OTHER';
    const key = rule + '|' + n.period + '|' + n.location;
    if (!capGroups.has(key)) capGroups.set(key, {rule:rule, structured:structured, period:n.period, location:n.location, covers:[]});
    capGroups.get(key).covers.push(n.student.name);
  });
  capGroups.forEach(function(g) {
    const amount = Math.max(1, g.covers.length);
    addRaw(g.rule, g.structured ? 4 : 5,
      'Increase group cap in ' + g.location + ' for ' + g.period + '.',
      'Temporarily allow ' + (amount === 1 ? 'one more same-location group member' : amount + ' more same-location group members') + ' in ' + g.location + '.',
      g.covers, {period:g.period, location:g.location, amount:amount},
      ['Increase group cap by ' + amount + ' in ' + g.location + ' for ' + g.period + '.']);
  });

  const unassignedByPeriod = new Map();
  baseUnassigned.forEach(function(n) {
    if (!unassignedByPeriod.has(n.period)) unassignedByPeriod.set(n.period, []);
    unassignedByPeriod.get(n.period).push(n);
  });
  unassignedByPeriod.forEach(function(periodNeeds, period) {
    const covers = periodNeeds.map(function(n){return n.student.name;});
    const withinThresholdAny = periodNeeds.some(function(n){return n.student.priority <= baseModel.config.individualStarThreshold;});

    const starStructured = findIndividualStarGenieCandidatesV5_(baseModel, period, true);
    const starOther = findIndividualStarGenieCandidatesV5_(baseModel, period, false);
    if (starOther.length && withinThresholdAny) {
      addRaw('STAR_NONSTRUCT_THRESHOLD', 6, 'Group an Individual* student in a non-structured room.',
        'Temporarily treat ' + starOther[0].student + ' as Group to try to free staff for uncovered students.', covers, {period:period, candidates:starOther.slice(0,3)},
        ['Treat ' + starOther[0].student + ' as Group for ' + period + '.']);
    }
    if (starStructured.length && !withinThresholdAny) {
      addRaw('STAR_STRUCT_RELAXED', 7, 'Group an Individual* student in a highly structured room.',
        'Temporarily relax the threshold and treat ' + starStructured[0].student + ' as Group.', covers, {period:period, candidates:starStructured.slice(0,3)},
        ['Treat ' + starStructured[0].student + ' as Group for ' + period + '.']);
    }
    if (starOther.length && !withinThresholdAny) {
      addRaw('STAR_NONSTRUCT_RELAXED', 8, 'Group an Individual* student in a non-structured room.',
        'Temporarily relax both the threshold and room condition for ' + starOther[0].student + '.', covers, {period:period, candidates:starOther.slice(0,3)},
        ['Treat ' + starOther[0].student + ' as Group for ' + period + '.']);
    }

    const indStructured = findIndividualGenieCandidatesV5_(baseModel, period, true);
    if (indStructured.length) {
      addRaw('IND_STRUCT_LOWEST', 9, 'Group the lowest-priority Individual student in a highly structured classroom.',
        'Temporarily treat ' + indStructured[0].student + ' as Group to try to free staff.', covers, {period:period, candidate:indStructured[0]},
        ['Treat ' + indStructured[0].student + ' as Group for ' + period + '.']);
    }
    const indOther = findIndividualGenieCandidatesV5_(baseModel, period, false);
    if (indOther.length) {
      addRaw('IND_OTHER_LOWEST', 10, 'Group the lowest-priority Individual student in another classroom.',
        'Temporarily treat ' + indOther[0].student + ' as Group to try to free staff.', covers, {period:period, candidate:indOther[0]},
        ['Treat ' + indOther[0].student + ' as Group for ' + period + '.']);
    }
  });

  const allowByPeriod = new Map();
  baseUnassigned.forEach(function(n) {
    if (!allowedUnstaffed.has(n.student.name)) return;
    if (!allowByPeriod.has(n.period)) allowByPeriod.set(n.period, []);
    allowByPeriod.get(n.period).push(n.student.name);
  });
  allowByPeriod.forEach(function(names, period) {
    addRaw('ALLOW_UNSTAFFED', 13, 'Allow selected student(s) to remain unstaffed.',
      'Publish the schedule while explicitly noting selected student(s) remain unstaffed for ' + period + '.', names, {period:period, students:names},
      names.map(function(name){return 'Allow ' + name + ' to remain unstaffed for ' + period + '.';}));
  });

  function simulateOption(option) {
    const model = loadModelV5_(ss);
    applyAssignmentOptimizationOverridesToModelV5_(model, option);
    const run = buildAssignmentsBreaksWithEmergencyLunchV5_(model);
    const remaining = (run.assignments.unassigned || []).slice().sort(compareNeedPriority_);
    const remainingNames = Array.from(new Set(remaining.map(function(n){return n.student.name;})));
    return { remaining: remaining, remainingNames: remainingNames, count: remainingNames.length };
  }

  const viable = [];
  candidates.sort(function(a,b){return Number(a.ruleLevel||99)-Number(b.ruleLevel||99);});
  candidates.forEach(function(o) {
    if (o.rule === 'ALLOW_UNSTAFFED') {
      o.remainingUnassigned = baseUnassignedNames.filter(function(n){ return (o.covers || []).indexOf(n) < 0; });
      o.coverageImprovement = Math.max(0, baseCount - o.remainingUnassigned.length);
      viable.push(o);
      return;
    }
    try {
      const sim = simulateOption(o);
      if (sim.count < baseCount) {
        o.covers = baseUnassignedNames.filter(function(n){ return sim.remainingNames.indexOf(n) < 0; });
        o.remainingUnassigned = sim.remainingNames;
        o.coverageImprovement = baseCount - sim.count;
        viable.push(o);
      }
    } catch (e) {
      v5Log_('WARN', 'Assignment Optimization simulation option failed.', { option: o.title, error: e.message });
    }
  });

  const chosen = [];
  const seen = new Set();
  const keyFor = function(o) { return o.rule + '|' + (o.data && o.data.period || '') + '|' + (o.data && (o.data.location || o.data.student) || '') + '|' + (o.covers||[]).join(','); };
  const addChosen = function(o) {
    if (!o) return;
    const key = keyFor(o);
    if (seen.has(key)) return;
    seen.add(key);
    chosen.push(o);
  };

  // Build a least-restrictive combined option by actually simulating incremental combinations.
  let currentCombo = null;
  let currentRemaining = baseUnassignedNames.slice();
  for (let i = 0; i < viable.length; i++) {
    const o = viable[i];
    if (o.rule === 'ALLOW_UNSTAFFED') continue;
    const testCombo = currentCombo ? {
      id: Utilities.getUuid(), rule:'COMBO', ruleLevel: Math.max(currentCombo.ruleLevel || 0, o.ruleLevel || 0),
      title:'Combined least-restrictive option.',
      summary:'Use these selected rule relaxations together to cover as many currently unstaffed students as possible.',
      covers:[], data:{options:(currentCombo.data.options || []).concat([o])}, changes:[]
    } : {
      id: Utilities.getUuid(), rule:'COMBO', ruleLevel:o.ruleLevel,
      title:'Combined least-restrictive option.', summary:'Use this rule relaxation to improve coverage.',
      covers:[], data:{options:[o]}, changes:[]
    };
    testCombo.changes = testCombo.data.options.reduce(function(arr,x){return arr.concat(x.changes || [x.title]);}, []);
    try {
      const sim = simulateOption(testCombo);
      if (sim.count < currentRemaining.length) {
        testCombo.covers = baseUnassignedNames.filter(function(n){ return sim.remainingNames.indexOf(n) < 0; });
        testCombo.remainingUnassigned = sim.remainingNames;
        testCombo.coverageImprovement = baseCount - sim.count;
        currentCombo = testCombo;
        currentRemaining = sim.remainingNames;
        if (sim.count === 0) break;
      }
    } catch (e) {}
  }
  if (currentCombo && currentCombo.data && currentCombo.data.options && currentCombo.data.options.length > 1) addChosen(currentCombo);

  for (let i=0; i<viable.length && chosen.length<3; i++) {
    if (viable[i].rule !== 'ALLOW_UNSTAFFED') addChosen(viable[i]);
  }

  // Always keep Remain Unstaffed available as the final/highest-restriction option whenever selected unassigned students exist.
  viable.filter(function(o){return o.rule === 'ALLOW_UNSTAFFED';}).forEach(function(o){ addChosen(o); });

  getDocumentPropertiesV650_().setProperty('V5_LAST_GENIE_OPTIONS', JSON.stringify(chosen));
  return { options: chosen, unassigned: baseUnassignedNames };
}

function findIndividualStarGenieCandidatesV5_(model, period, structuredUncovered) {
  const rows = [];
  model.students.forEach(function(st) {
    const need = st.needs && st.needs[period];
    if (!need || need.support !== 'INDIVIDUAL_STAR') return;
    rows.push({student:st.name, priority:st.priority, location:need.location, structured:isHighlyStructuredRoom_(model, need.location)});
  });
  rows.sort(function(a,b){return b.priority-a.priority;});
  return rows;
}

function findIndividualGenieCandidatesV5_(model, period, structured) {
  const rows = [];
  model.students.forEach(function(st) {
    const need = st.needs && st.needs[period];
    if (!need || need.support !== 'INDIVIDUAL') return;
    if (isHighlyStructuredRoom_(model, need.location) !== structured) return;
    rows.push({student:st.name, priority:st.priority, location:need.location});
  });
  rows.sort(function(a,b){return b.priority-a.priority;});
  return rows;
}

function applyAssignmentGenieOptionV5(optionId) {
  const props = getDocumentPropertiesV650_();
  const raw = props.getProperty('V5_LAST_GENIE_OPTIONS') || '[]';
  let options = [];
  try { options = JSON.parse(raw); } catch (e) { options = []; }
  const option = options.find(function(o){return String(o.id) === String(optionId);});
  if (!option) throw new Error('Assignment Optimization option was not found. Run Assignment Optimization again.');
  setAssignmentOptimizationTempV5_(option);
  props.setProperty('V5_ACCEPTED_GENIE_OPTION', JSON.stringify(option));
  v5Log_('WARN', 'Assignment Optimization option accepted.', option);
  runAllV5();
  return { ok:true, message:'Assignment Optimization option accepted and schedules generated.' };
}

