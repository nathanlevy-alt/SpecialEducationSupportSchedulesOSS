function ensureCampusPropertySheetHeaderV5264_(sheet) {
  if (!sheet) return;
  let needsHeader = false;
  try {
    if (sheet.getLastRow() < 1) {
      needsHeader = true;
    } else {
      const current = sheet.getRange(1, 1, 1, 3).getValues()[0].map(function(v) { return String(v || ''); });
      needsHeader = current[0] !== 'Key' || current[1] !== 'Value' || current[2] !== 'Updated';
    }
  } catch (e) {
    needsHeader = true;
  }
  if (needsHeader) sheet.getRange(1, 1, 1, 3).setValues([['Key', 'Value', 'Updated']]);
  try { if (!sheet.isSheetHidden()) sheet.hideSheet(); } catch (e2) {}
}

function getCampusPropertySheetV5263_(ss) {
