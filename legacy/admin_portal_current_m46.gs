function isStaffBlockedForWindowV5_(staff, item, start, end) {
  if (!staff || !staff.timeBlockRules || !staff.timeBlockRules.length) return false;
  for (let i = 0; i < staff.timeBlockRules.length; i++) {
    const rule = staff.timeBlockRules[i];
    if (rule.type === 'period' && rule.period === item.label) return true;
    if (rule.type === 'after' && rule.minutes != null && end > rule.minutes) return true;
    if (rule.type === 'before' && rule.minutes != null && start < rule.minutes) return true;
    if (rule.type === 'range' && rule.start != null && rule.end != null && rangesOverlap_(start, end, rule.start, rule.end)) return true;
  }
  return false;
}

function addBusyIntervalV5_(busyByStaff, staffName, start, end) {
  if (!busyByStaff.has(staffName)) busyByStaff.set(staffName, []);
  busyByStaff.get(staffName).push({ start: start, end: end });
}

function hasBusyOverlapV5_(busyByStaff, staffName, start, end) {
  const intervals = busyByStaff.get(staffName) || [];
  return intervals.some(function(interval) { return rangesOverlap_(start, end, interval.start, interval.end); });
}

function isCoachStaffV5_(staff) {
  if (!staff) return false;
  if (staff.coachPriorityHold) return true;
  const raw = String(staff.priorityHoldRaw || staff.priorityHoldsRaw || '').toLowerCase();
  if (/\bcoach\b/.test(raw)) return true;
  return (staff.priorityHolds || []).some(function(hold) {
    return /\bcoach\b/i.test(String(hold.raw || hold.location || ''));
  });
}

