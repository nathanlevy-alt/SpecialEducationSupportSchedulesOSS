function extractGoogleFormFileIdV5208_(input) {
  const raw = String(input || '').trim();
  if (!raw) return '';
  let m = raw.match(/\/forms\/d\/([a-zA-Z0-9_-]+)/);
  if (m && m[1]) return m[1];
  m = raw.match(/[?&]id=([a-zA-Z0-9_-]+)/);
  if (m && m[1]) return m[1];
  if (/^[a-zA-Z0-9_-]{20,}$/.test(raw)) return raw;
  return '';
}

function openDataFileFormFromInputV5208_(input) {
  const raw = String(input || '').trim();
  if (!raw) throw new Error('Paste a Google Form URL or file ID.');
  let lastErr = null;
  if (/^https?:\/\//i.test(raw)) {
    try {
      return FormApp.openByUrl(raw);
    } catch (err) {
      lastErr = err;
    }
  }
  const id = extractGoogleFormFileIdV5208_(raw);
  if (id) {
    try {
      return FormApp.openById(id);
    } catch (err2) {
      lastErr = err2;
    }
  }
  throw new Error('Could not open that Google Form. Use the full Google Forms edit URL, view URL, or file ID, and make sure this script account has access. ' + String(lastErr && lastErr.message || ''));
}


