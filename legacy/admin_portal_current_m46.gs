function setupDataValidationV5_(ss) {
  // V5.1.344: once Settings > Stabilize Database has run, the spreadsheet is treated
  // as a backend table. The Admin Portal UI validates user input, so do not recreate
  // Google Sheets data-validation rules and reintroduce save-time validation errors.
  try {
    if (typeof getDatabaseStabilizedAtV5341_ === 'function' && getDatabaseStabilizedAtV5341_()) return { ok: true, skipped: true, reason: 'Database stabilized; sheet validations are disabled.' };
  } catch (ignore) {}
  const validation = ss.getSheetByName(V5.SHEETS.VALIDATION);
  const students = ss.getSheetByName(V5.SHEETS.STUDENTS);
  const staff = ss.getSheetByName(V5.SHEETS.STAFF);
  const calendar = ss.getSheetByName(V5.SHEETS.CALENDAR);

  const supportRange = validation.getRange('E2:E');
  const staffRange = validation.getRange('B2:B');
  const roomsRange = validation.getRange('C2:C');
  const lunchRange = validation.getRange('D2:D');
  const scheduleRange = validation.getRange('F2:F');
  const priorityHoldRange = validation.getRange('H2:H');
  const yesNoRange = validation.getRange('I2:I');
  const allLocationRange = validation.getRange('J2:J');
  const supportTypeRange = validation.getRange('K2:K');
  const staffSupportTypeRange = validation.getRange('L2:L');
  const studentRange = validation.getRange('A2:A');

  const supportRule = SpreadsheetApp.newDataValidation().requireValueInRange(supportRange, true).setAllowInvalid(false).build();
  const staffRule = SpreadsheetApp.newDataValidation().requireValueInRange(staffRange, true).setAllowInvalid(true).build();
  const roomRule = SpreadsheetApp.newDataValidation().requireValueInRange(roomsRange, true).setAllowInvalid(true).build();
  const lunchRule = SpreadsheetApp.newDataValidation().requireValueInRange(lunchRange, true).setAllowInvalid(true).build();
  const scheduleRule = SpreadsheetApp.newDataValidation().requireValueInRange(scheduleRange, true).setAllowInvalid(false).build();
  const priorityHoldRule = SpreadsheetApp.newDataValidation().requireValueInRange(priorityHoldRange, true).setAllowInvalid(true).build();
  const yesNoRule = SpreadsheetApp.newDataValidation().requireValueInRange(yesNoRange, true).setAllowInvalid(false).build();
  const studentRule = SpreadsheetApp.newDataValidation().requireValueInRange(studentRange, true).setAllowInvalid(true).build();
  const locationRule = SpreadsheetApp.newDataValidation().requireValueInRange(allLocationRange, true).setAllowInvalid(true).build();
  const staffSupportTypeRule = SpreadsheetApp.newDataValidation().requireValueInRange(staffSupportTypeRange, true).setAllowInvalid(false).build();

  // Student sheet validations.
  const maxRows = V5.MAX_ROWS_FOR_VALIDATION;
  const periodLocationCols = [4, 8, 12, 16, 20, 24]; // Period 1-6 classroom/location columns
  const periodSupportCols = [5, 9, 13, 17, 21, 25, 29]; // Period 1-6 + Break degree-of-support columns
  const periodStaffCols = [6, 7, 10, 11, 14, 15, 18, 19, 22, 23, 26, 27, 30, 31]; // Period 1-6 + Break staff
  periodLocationCols.forEach(function(col) { students.getRange(2, col, maxRows, 1).setDataValidation(roomRule); });
  students.getRange(2, 28, maxRows, 1).setDataValidation(lunchRule); // AB Break Location uses Campus SettingsB Lunch Locations
  periodSupportCols.forEach(function(col) { students.getRange(2, col, maxRows, 1).setDataValidation(supportRule); });
  periodStaffCols.forEach(function(col) { students.getRange(2, col, maxRows, 1).setDataValidation(staffRule); });
  students.getRange(2, 32, maxRows, 1).setDataValidation(lunchRule); // AF Lunch Location
  students.getRange(2, 33, maxRows, 1).setDataValidation(supportRule); // AG Lunch Degree of Support
  students.getRange(2, 34, maxRows, 2).setDataValidation(staffRule); // AH:AI Lunch staff

  // Staff sheet validations. These allow invalid because multi-select/chip values often store as joined text.
  const staffHeaders = getHeaderMap_(staff);
  const colBlockedStudents = findHeaderCol_(staffHeaders, ['blocked student(s)', 'blocked students'], 4);
  const colBlockedRooms = findHeaderCol_(staffHeaders, ['blocked room(s) #', 'blocked rooms #', 'blocked room(s)', 'blocked rooms'], 5);
  const colPriorityHolds = findHeaderCol_(staffHeaders, ['priority holds'], 6);
  const colOvertime = findHeaderCol_(staffHeaders, ['overtime interest'], 7);
  const colSupportStaffType = findHeaderCol_(staffHeaders, ['support staff type', 'staff support type', 'support type'], 10);
  if (colBlockedStudents) staff.getRange(2, colBlockedStudents, maxRows, 1).setDataValidation(studentRule);
  if (colBlockedRooms) staff.getRange(2, colBlockedRooms, maxRows, 1).setDataValidation(locationRule);
  if (colPriorityHolds) staff.getRange(2, colPriorityHolds, maxRows, 1).setDataValidation(priorityHoldRule);
  if (colOvertime) staff.getRange(2, colOvertime, maxRows, 1).setDataValidation(yesNoRule);
  if (colSupportStaffType) staff.getRange(2, colSupportStaffType, maxRows, 1).setDataValidation(staffSupportTypeRule);

  calendar.getRange(2, 2, maxRows, 1).setDataValidation(scheduleRule);
}

