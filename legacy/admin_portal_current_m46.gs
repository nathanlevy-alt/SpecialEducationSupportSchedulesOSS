function isStaffCommittedToSpecialEventWindowV5148_(model, staffName, start, end) {
  if (!model || !staffName || start == null || end == null) return false;
  const events = (model.specialEvents || []);
  if (!events.length) return false;
  const staffKey = normalizeName_(staffName);
  for (let i = 0; i < events.length; i++) {
    const ev = events[i] || {};
    const eventStaff = (ev.staff || []).map(clean_).filter(Boolean);
    if (!eventStaff.some(function(name) { return normalizeName_(name) === staffKey; })) continue;
    const w = getSpecialEventWindowV5143_(model, ev);
    if (w.start == null || w.end == null) continue;
    if (rangesOverlap_(start, end, w.start, w.end)) return true;
  }
  return false;
}


