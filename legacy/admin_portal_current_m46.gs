  saveSecondaryPrimaryDaysForStudentV5131_(newName, payload.secondaryPrimaryDays || []);
  saveStudentAltStaffRankForStudentV5182_(oldName, newName, payload.altStaffRank || []);
  saveStudentSupportTypesForStudentV51227_(oldName, newName, payload.periods || {});
  saveCustomStudentPeriodsForStudentV5141_(oldName, newName, payload.periods || {});
  try { renumberStudentPrioritiesV5322_(ss); } catch (e) {}
  try { markValidationDirtyV51222_('student manager saved'); } catch (e) {}
  try { invalidateManagerCachesV5367_(ss); } catch (e2) {}
  try { clearSchoolDataCacheV5340_(); } catch (e3) {}
  return { ok: true, rowIndex: rowIndex, name: newName, message: 'Saved ' + newName + '.', validationDeferred: true };
