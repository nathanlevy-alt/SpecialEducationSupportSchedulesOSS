function normalizeScheduleViewsForStaffPortalLabelsV5323_(views) {
  views = views || {};
  const displayMap = (typeof getPeriodDisplayNameMapV5141_ === 'function') ? getPeriodDisplayNameMapV5141_() : {};
  views.periodDisplayNames = Object.assign({}, displayMap, views.periodDisplayNames || {});
  views.items = (views.items || []).map(function(it) {
    if (typeof it === 'string') it = { label: it };
    it = it || {};
    const key = clean_((it.key || it.label || it.period || it.item || it.title || it.displayName || ''));
    const label = clean_(it.label || key || it.displayName || '');
    const internalKey = periodDisplayToInternalKeyV5322_(key || label) || label || key;
    const displayName = getPeriodDisplayLabelForOutputV5158_(internalKey) || clean_(it.displayName || label || internalKey);
    const timeLabel = clean_(it.timeLabel || it.time || ((it.startMinutes != null && it.endMinutes != null) ? formatTimeRange_(it.startMinutes, it.endMinutes) : ''));
    it.key = internalKey;
    it.label = internalKey;
    it.displayName = displayName;
    it.title = displayName + (timeLabel ? '\n' + timeLabel : '');
    if (timeLabel) it.timeLabel = timeLabel;
