function runAllV5() {
  const ss = getActiveSpreadsheetV5_();
  rememberSpreadsheetIdV5_(ss);
  resetV5Log_();
  v5Log_('INFO', 'Starting Admin Portal run', { version: V5.VERSION });

  try {
    profileStepV51222_('light setup', function() {
      ensureCoreSheetsLightV51222_(ss);
      refreshV5ValidationHelpersIfDirty_();
    });

    profileStepV51222_('clear generated schedule state', function() {
      clearCustomizationOnGeneratedScheduleV5_();
      clearWorkingScheduleOverrideV5113_();
    });

    const acceptedOptimization = getAcceptedAssignmentOptimizationOptionV5_();
    const model = profileStepV51222_('build model', function() {
      return buildV5Model_(ss);
    });
    const run = profileStepV51222_('build assignments and breaks', function() {
      return buildAssignmentsBreaksWithEmergencyLunchV5_(model);
    });
    const assignments = run.assignments;
    const breaks = run.breaks;
    const freeTime = run.freeTime;

    profileStepV51222_('logic summary', function() {
      addRunSummaryToLogicV5_(model, run);
      if (acceptedOptimization) {
        v5Log_('WARN', 'Assignment Optimization option was used for this generated schedule.', acceptedOptimization);
        // Temporary Assignment Optimization remains active until cleared from the portal.
      }
    });

    profileStepV51222_('write break schedule', function() {
      writeBreakScheduleV5_(ss, model, breaks);
    });
    profileStepV51222_('write dashboard', function() {
      writeDashboardV5_(ss, model, assignments, breaks, freeTime);
    });
    profileStepV51222_('write logic review', function() {
      writeLogicReviewV5_(ss, model);
    });
    profileStepV51222_('cache schedule display snapshot', function() {
      saveWorkingScheduleViewsV686i_(ss, buildScheduleViewsFromRunV686i_(model, assignments, breaks), 'runAll');
    });

    v5Toast_('All schedules have been updated.', 'Complete', 7);
    return { assignments: assignments, breaks: breaks, freeTime: freeTime, emergencyLunchStaff: run.emergencyLunchStaff };
  } catch (err) {
    v5Log_('ERROR', 'Run failed: ' + err.message, { stack: err.stack });
    try { writeLogicReviewV5_(ss, { config: { showLogic: true } }); } catch (e) {}
    v5Toast_(err.message + '. Check Logic for details.', 'Error', 10);
    throw err;
  }
}


// =====================================================================================
// V5.1.10 Scenario Preview server-call argument hardening
// =====================================================================================
function runScenarioPreviewPayloadV5(payloadJson) {
  let payload = {};
  try {
    payload = typeof payloadJson === 'string' ? JSON.parse(payloadJson || '{}') : (payloadJson || {});
  } catch (err) {
    payload = {date:'', scheduleType:'', parseError:String(err && err.message || err)};
  }
  return runScenarioPreviewV5(payload);
}

function runScenarioPreviewV5(dateOrPayload, scheduleTypeArg) {
  const payload = normalizeScenarioPayloadV5_(dateOrPayload, scheduleTypeArg);
  // Keep an exact echo of what the server received so the UI can diagnose client/server payload issues.
  let receivedDate = String(payload.date || payload.clientValue || payload.clientLast || payload.clientDisplay || payload.clientAttr || '').trim();
  if (!receivedDate && payload.clientValueAsNumber) {
    const n = Number(payload.clientValueAsNumber);
    if (isFinite(n)) {
      const d = new Date(n);
      receivedDate = d.getUTCFullYear() + '-' + ('0' + (d.getUTCMonth() + 1)).slice(-2) + '-' + ('0' + d.getUTCDate()).slice(-2);
    }
  }
  const receivedType = String(payload.scheduleType || '').trim();
  const model = buildScenarioModelV5_({date: receivedDate, scheduleType: receivedType});
  const targetKey = scenarioDateKeyFromInputV5_(receivedDate) || dateKeyV5_(model.schedule.date);
  const attendanceRows = getAttendanceRowsForDateKeyV5_(model.ss, targetKey);
  const attendanceDiagnostics = getAttendanceDiagnosticsForDateV5_(model.ss, targetKey);
  attendanceDiagnostics.receivedDate = receivedDate;
  attendanceDiagnostics.receivedScheduleType = receivedType;
  attendanceDiagnostics.receivedPayload = JSON.stringify(payload);

  const rowsByStaff = {};
  attendanceRows.forEach(function(row) {
    const key = normalizeName_(row.name);
    if (!key) return;
    if (!rowsByStaff[key]) rowsByStaff[key] = {fullDay:false, timeBlocks:[]};
    const dayPart = String(row.dayPart || '').toLowerCase();
    if (dayPart.indexOf('partial') >= 0) {
      // Partial-day blocks are handled by the standard Attendance reader when possible.
    } else {
      rowsByStaff[key].fullDay = true;
    }
  });
  (model.staff || []).forEach(function(s) {
    const a = rowsByStaff[normalizeName_(s.name)];
    if (a && a.fullDay) { s.absent = true; s.timeBlocks = s.timeBlocks || []; }
  });

  const run = buildAssignmentsBreaksWithEmergencyLunchV5_(model);
  const views = buildPortalScheduleViewsV5_(model, run.assignments, run.breaks);
  const scenarioAbsentFullDayNamesV520_ = new Set((model.staff || []).filter(function(s){ return s.absent; }).map(function(s){ return normalizeName_(s.name); }));
  views.staffSchedules = (views.staffSchedules || []).filter(function(row){ return !scenarioAbsentFullDayNamesV520_.has(normalizeName_(row.staff)); });
  views.breakItems = ((run.breaks && run.breaks.items) || []).map(function(b){ var c={}; for (var k in b) c[k]=b[k]; if (!c.time && c.startMinutes != null && c.endMinutes != null) c.time = formatTimeRange_(c.startMinutes, c.endMinutes); return c; });
  views.scenarioDate = model.schedule.date;
  views.scheduleType = model.schedule.scheduleType;
  const absentStaff = (model.staff || []).filter(function(s){return s.absent;}).map(function(s){return {staff:s.name, detail:(s.timeBlocks && s.timeBlocks.length ? 'Time blocked: ' + s.timeBlocks.map(function(b){return b.label || b.raw || '';}).join(', ') : 'Absent full day')};});
  const unassigned = extractUnassignedFromViewsV5_(views);
  return {views:views, impact:{absentStaff:absentStaff, absentStaffCount:absentStaff.length, attendanceRowsMatched:attendanceRows.length, attendanceRowsScanned:attendanceDiagnostics.rowCount || 0, attendanceRows:attendanceRows, attendanceDiagnostics:attendanceDiagnostics, targetDate:targetKey, requestedDate:receivedDate, modelDate:dateKeyV5_(model.schedule.date), unassigned:unassigned, unassignedCount:unassigned.length}};
}



// =====================================================================================
// V5.1.15 Scenario Preview packed-string endpoint - fixes blank multi-argument payloads
// =====================================================================================
function scenarioPreviewPackedV515(packed) {
  const raw = String(packed || '');
  const params = {};
  raw.split('&').forEach(function(part) {
    if (!part) return;
    const eq = part.indexOf('=');
    const k = eq >= 0 ? part.substring(0, eq) : part;
    const v = eq >= 0 ? part.substring(eq + 1) : '';
    try { params[decodeURIComponent(k)] = decodeURIComponent(v.replace(/\+/g, ' ')); }
    catch (e) { params[k] = v; }
  });
  const receivedDate = String(params.date || params.scenarioDate || params.clientValue || '').trim();
  const receivedType = String(params.scheduleType || params.scenarioType || '').trim();
  const result = runScenarioPreviewV5({
    date: receivedDate,
    scenarioDate: receivedDate,
    scheduleType: receivedType,
    scenarioType: receivedType,
    clientValue: params.clientValue || '',
    source: 'scenarioPreviewPackedV515'
  }) || {};
  if (!result.impact) result.impact = {};
  if (!result.impact.attendanceDiagnostics) result.impact.attendanceDiagnostics = {};
  result.impact.attendanceDiagnostics.endpoint = 'scenarioPreviewPackedV515';
  result.impact.attendanceDiagnostics.receivedDate = receivedDate;
  result.impact.attendanceDiagnostics.receivedScheduleType = receivedType;
  result.impact.attendanceDiagnostics.packedReceived = raw ? true : false;
  result.impact.attendanceDiagnostics.packedLength = raw.length;
  result.impact.attendanceDiagnostics.packedPreview = raw.substring(0, 120);
  result.impact.requestedDate = receivedDate;
  return result;
}

