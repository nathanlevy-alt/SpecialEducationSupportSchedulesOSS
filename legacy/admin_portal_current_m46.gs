  const oldCampusId = clean_(payload.campusId || '');
  if (!oldCampusId) throw new Error('School short code is required.');
  const controller = getControllerSpreadsheetV5253_();
  const sh = controller.getSheetByName(V5253_MC.CAMPUS_SHEET);
  const rows = sh.getLastRow() > 1 ? sh.getRange(2, 1, sh.getLastRow() - 1, 10).getValues() : [];
  const requestedName = clean_(payload.campusName || '');
  if (!requestedName) throw new Error('School name is required.');
  const requestedCode = normalizeSchoolCodeV5260_(payload.campusCode || oldCampusId, oldCampusId);
  let targetRow = -1;
  for (let i = 0; i < rows.length; i++) {
    if (clean_(rows[i][0]) === oldCampusId) { targetRow = i; break; }
  }
  if (targetRow < 0) throw new Error('School not found: ' + oldCampusId);

  let newCampusId = requestedCode;
  for (let j = 0; j < rows.length; j++) {
    if (j !== targetRow && clean_(rows[j][0]) === newCampusId) throw new Error('That school short code is already in use.');
  }

  rows[targetRow][0] = newCampusId;
  rows[targetRow][1] = requestedName;
  rows[targetRow][3] = clean_(payload.folderId || rows[targetRow][3]);
  rows[targetRow][4] = clean_(payload.status || rows[targetRow][4] || 'Active');
  rows[targetRow][8] = clean_(payload.notes || '');
  sh.getRange(targetRow + 2, 1, 1, 10).setValues([rows[targetRow]]);

  if (newCampusId !== oldCampusId) {
    const userSheet = controller.getSheetByName(V5253_MC.USER_SHEET);
    const userRows = userSheet && userSheet.getLastRow() > 1 ? userSheet.getRange(2, 1, userSheet.getLastRow() - 1, 7).getValues() : [];
    let changed = false;
    for (let u = 0; u < userRows.length; u++) {
      if (clean_(userRows[u][1]) === oldCampusId) { userRows[u][1] = newCampusId; changed = true; }
    }
    if (changed) userSheet.getRange(2, 1, userRows.length, 7).setValues(userRows);
    const userProps = PropertiesService.getUserProperties();
    if (userProps.getProperty('V5_SELECTED_CAMPUS_ID') === oldCampusId) {
      userProps.setProperty('V5_SELECTED_CAMPUS_ID', newCampusId);
      userProps.setProperty('V5_SELECTED_CAMPUS_NAME', requestedName);
    }
  }

  return { ok: true, message: 'School updated.', data: getMultiCampusAdminDataV5253(), context: getAllowedCampusesV5253() };
}

function archiveCampusV5258(campusId) {
  setupMultiCampusV5253();
  const ctx = getAllowedCampusesV5253();
  if (!(ctx.systemAdmin || ctx.actualSystemAdmin)) throw new Error('Only District/System Admin users can archive schools.');
  campusId = clean_(campusId || '');
  if (!campusId) throw new Error('School short code is required.');
  // Standalone mode treats the controller workbook as a registry, not as an undeletable school.
  // Legacy/bound-script rows may point at the controller spreadsheet ID; allow System Admins
  // to archive those stale school rows from the portal while never deleting the controller file.
  const controller = getControllerSpreadsheetV5253_();
  const controllerId = controller.getId();
  const sh = controller.getSheetByName(V5253_MC.CAMPUS_SHEET);
  const rows = sh.getLastRow() > 1 ? sh.getRange(2, 1, sh.getLastRow() - 1, 10).getValues() : [];
  for (let i = 0; i < rows.length; i++) {
    if (clean_(rows[i][0]) === campusId) {
      const archivedControllerBackedRow = clean_(rows[i][2]) === controllerId;
      rows[i][4] = 'Inactive';
      if (archivedControllerBackedRow) {
        rows[i][8] = clean_(rows[i][8] || '') || 'Archived legacy controller-backed school registry row. Controller workbook was not deleted.';
      }
      sh.getRange(i + 2, 1, 1, 10).setValues([rows[i]]);
      const userProps = PropertiesService.getUserProperties();
      if (userProps.getProperty('V5_SELECTED_CAMPUS_ID') === campusId) {
        userProps.deleteProperty('V5_SELECTED_CAMPUS_ID');
        userProps.deleteProperty('V5_SELECTED_CAMPUS_SPREADSHEET_ID');
        userProps.deleteProperty('V5_SELECTED_CAMPUS_NAME');
      }
      return { ok: true, message: 'School archived. The spreadsheet file was not deleted.', data: getMultiCampusAdminDataV5253(), context: getAllowedCampusesV5253() };
    }
  }
  throw new Error('School not found: ' + campusId);
}



