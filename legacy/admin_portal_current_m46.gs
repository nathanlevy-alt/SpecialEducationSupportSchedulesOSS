      const ts = resp.getTimestamp && resp.getTimestamp();
      if (!ts || !isOnOrAfterSchoolYearStartV5288_(ts)) return;
      const who = inferSubmittedStaffV5288_(resp, staffNames);
      rows.push({
        date: Utilities.formatDate(ts, 'America/Los_Angeles', 'dd/MM/yyyy h:mm a'),
        displayDate: formatDateMmDdYyV5305_(ts, true),
        sortMs: ts.getTime(),
        submittedStaffName: who.submittedStaffName || '',
        matchedStaff: who.matchedStaff || 'Unknown',
        matchConfidence: who.matchConfidence || 'unknown'
      });
    });
  } catch (err) {
    return { ok:false, studentName:studentName, rows:[], schoolYearStartDate:getSchoolYearStartDateV5288_(), message:String(err && err.message ? err.message : err) };
  }
  rows.sort(function(a,b){ return Number(b.sortMs || 0) - Number(a.sortMs || 0); });
  const syStartV5305 = getSchoolYearStartDateV5288_();
  return { ok:true, studentName:studentName, rows:rows, schoolYearStartDate:syStartV5305, schoolYearStartDateDisplay:formatIsoDateMmDdYyV5305_(syStartV5305) };
}


