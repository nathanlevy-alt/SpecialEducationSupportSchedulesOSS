function assignForcedRestStaffDirectSupportV5189_(model, item, needs, periodResult) {
  if (!item || (normalizeName_(item.label) !== 'break' && normalizeName_(item.label) !== 'lunch')) return;
  const forcedStaff = (model.staff || []).filter(function(staff) {
    return isForcedRestCoverageStaffForItemV5189_(staff, item) && !isStaffBlockedForItem_(staff, item) && !periodResult.staffAssignments.has(staff.name);
