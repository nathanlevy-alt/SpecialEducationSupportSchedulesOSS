function parseMaxGroupSizeValueV5204_(rawValue, displayValue) {
  const candidates = [rawValue, displayValue];
  for (let i = 0; i < candidates.length; i++) {
    const v = candidates[i];
    if (v === 0) return 0;
    const s = String(v == null ? '' : v).trim();
    if (s === '') continue;
    if (s === '0') return 0;
    const n = Number(s);
    if (isFinite(n) && n >= 0) return Math.floor(n);
  }
  return '';
}

function writeMaxGroupSizeCellV5204_(sheet, rowIndex, value) {
  const col = 36; // AJ / zero-based row[35]
  if (!sheet || !rowIndex) return;
  if (value === '' || value == null) {
    sheet.getRange(rowIndex, col).clearContent();
    return;
  }
  const parsed = Number(value);
  if (isFinite(parsed) && parsed >= 0) {
    const cell = sheet.getRange(rowIndex, col);
    cell.setNumberFormat('0');
    cell.setValue(Math.floor(parsed));
  }
}


