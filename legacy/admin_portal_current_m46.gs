function searchGoogleFormsV5(query) {
  const rawQuery = String(query || '').trim();
  const diagnostics = {
    version: 'V5.1.221',
    mode: rawQuery ? 'query' : 'showAll',
    cacheHit: false,
    cacheComplete: false,
    fullRebuild: false,
    targetedSearch: false,
    scanned: 0,
    openFailed: 0,
    rejectedDriveName: 0,
    rejectedQuery: 0,
    savedOpenFailed: 0,
    sharedDriveSearchErrors: 0,
    sharedDrivesChecked: 0,
    libraryChecked: 0
  };

  const cache = readDataFileIndexCacheV5221_(!!rawQuery);
  if (cache && cache.rows && cache.rows.length) {
    diagnostics.cacheHit = true;
    diagnostics.cacheComplete = !!cache.complete;
    const cachedFiltered = filterDataFileRowsV5221_(cache.rows, rawQuery);
    if (!rawQuery || cachedFiltered.length) {
      v5Log_('INFO', 'DATA_FILE discovery completed from cache.', {
        version: 'V5.1.221',
        query: rawQuery,
        results: cachedFiltered.length,
        cachedRows: cache.rows.length,
        completeCache: !!cache.complete,
        diagnostics: diagnostics,
        explanation: 'The picker used the approved DATA_FILE index cache instead of scanning Drive live.'
      });
      return cachedFiltered.slice(0, V5_DATA_FILE_SEARCH_MAX_RESULTS_V5207_);
    }
  }

  let rows = [];
  if (rawQuery) {
    diagnostics.targetedSearch = true;
    rows = discoverDataFileFormsFastTargetedV5221_(rawQuery, diagnostics);
    let filtered = filterDataFileRowsV5221_(rows, rawQuery);
    if (cache && cache.rows && cache.rows.length) {
      const merged = mergeDataFileRowsV5221_(cache.rows, rows);
      writeDataFileIndexCacheV5221_(merged, !!cache.complete);
      filtered = filterDataFileRowsV5221_(merged, rawQuery);
    } else if (rows.length) {
      writeDataFileIndexCacheV5221_(rows, false);
    }
    v5Log_(filtered.length ? 'INFO' : 'WARN', 'DATA_FILE discovery completed with fast targeted search.', {
      version: 'V5.1.221',
      query: rawQuery,
      results: filtered.length,
      discoveredBeforeQueryFilter: rows.length,
      diagnostics: diagnostics,
      explanation: 'A query search no longer rebuilds the full DATA_FILE index. It checks cached/library rows plus targeted Drive name searches.'
    });
    return filtered.slice(0, V5_DATA_FILE_SEARCH_MAX_RESULTS_V5207_);
  }

  diagnostics.fullRebuild = true;
  rows = discoverDataFileFormsV5218_('', diagnostics);
  const normalized = normalizeDataFileIndexRowsV5221_(rows);
  writeDataFileIndexCacheV5221_(normalized, true);
  v5Log_(normalized.length ? 'INFO' : 'WARN', 'DATA_FILE discovery completed with full index rebuild.', {
    version: 'V5.1.221',
    query: rawQuery,
    results: normalized.length,
    diagnostics: diagnostics,
    explanation: 'Show All rebuilt the approved DATA_FILE index because no fresh complete cache was available. Later searches should use the cache.'
  });
  return normalized.slice(0, V5_DATA_FILE_SEARCH_MAX_RESULTS_V5207_);
}

