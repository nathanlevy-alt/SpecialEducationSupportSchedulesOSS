function saveScheduleTemplateFromDialogV5(payload) {
  if (!payload || !payload.name) throw new Error('Missing schedule name.');
  const ss = getActiveSpreadsheetV5_();
  ensureCoreSheetsV5_(ss);
  const sheet = ss.getSheetByName(V5.SHEETS.SCHEDULES);
  const name = String(payload.name).trim();
  const old = sheet.getDataRange().getValues();
  const header = old.length ? old[0] : ['Schedule Type', 'Item', 'Active?', 'Start', 'End', 'Sort'];
  const keep = [header];
  for (let i = 1; i < old.length; i++) {
    if (String(old[i][0]).trim().toLowerCase() !== name.toLowerCase()) keep.push(old[i]);
  }

  const rowsWithTimes = (payload.rows || []).map(function(row, idx) {
    const item = canonicalBellScheduleItemLabelV5533_(row.item);
    const active = !!row.active;
    const rawStart = clean_((row && row.start) || '');
    const rawEnd = clean_((row && row.end) || '');
    if (!shouldKeepBellScheduleRowV5351_(item, active, rawStart, rawEnd)) return null;
    const startMinutes = active ? parseTimeToMinutes_(rawStart) : null;
    const endMinutes = active ? parseTimeToMinutes_(rawEnd) : null;
    if (active && (startMinutes == null || endMinutes == null || endMinutes <= startMinutes)) {
      throw new Error('Invalid time range for ' + item + '. Active items need a start time before the end time.');
    }
    return {
      item: item,
      active: active,
      startMinutes: startMinutes,
      endMinutes: endMinutes,
      fallbackSort: numberOrDefault_(row.sort, idx + 1)
    };
  }).filter(function(row) { return row && row.item; });

  const storageRows = rowsWithTimes.slice().sort(function(a, b) {
    return compareScheduleRowsForStorageV5_(a, b);
  }).map(function(row, idx) {
    return [
      name,
      row.item,
      row.active ? 'Yes' : 'No',
      row.active ? formatTime_(row.startMinutes) : '',
      row.active ? formatTime_(row.endMinutes) : '',
      idx + 1
    ];
  });

  sheet.clear();
  sheet.getRange(1, 1, keep.length, keep[0].length).setValues(keep);
  if (storageRows.length) sheet.getRange(sheet.getLastRow() + 1, 1, storageRows.length, 6).setValues(storageRows);
  sheet.getRange(1, 1, 1, 6).setFontWeight('bold');
  try { sheet.hideSheet(); } catch (e) {}
  syncBellScheduleOrderAfterTemplateSaveV5324_(ss, name);
  refreshV5ValidationHelpers();
  return getScheduleBuilderDataV5();
}

