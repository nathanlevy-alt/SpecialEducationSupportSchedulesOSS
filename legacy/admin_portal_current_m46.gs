function assignGroupToStaff_(model, staff, item, group, periodResult, source) {
  if (!model.__staffAssignmentLoad) model.__staffAssignmentLoad = new Map();
  const existing = periodResult.staffAssignments.get(staff.name);
  if (existing) {
    group.forEach(function(n) {
      existing.needs.push(n);
      existing.studentNames.push(n.student.name);
      periodResult.studentToStaff.set(n.student.name, staff.name);
    });
    existing.source = existing.source || source;
  } else {
    const containsIndividual = group.some(function(n) { return n.support === 'INDIVIDUAL' || n.support === 'INDIVIDUAL_STAR'; });
    periodResult.staffAssignments.set(staff.name, {
      staff: staff.name,
      period: item.label,
      location: group[0].location,
      locationKey: normalizeLocation_(group[0].location),
      needs: group.slice(),
      studentNames: group.map(function(n) { return n.student.name; }),
      support: containsIndividual ? group[0].support : 'GROUP',
      containsIndividual: containsIndividual,
      source: source,
      notes: []
    });
    group.forEach(function(n) { periodResult.studentToStaff.set(n.student.name, staff.name); });
  }
  model.__staffAssignmentLoad.set(staff.name, (model.__staffAssignmentLoad.get(staff.name) || 0) + group.length);
  const assignedNamesForLog = group.map(function(n) { return n.student.name + ' (P' + n.student.priority + ')'; });
  const assignmentKindForLog = group.length > 1 ? 'group' : String(group[0].supportRaw || group[0].support || 'student').toLowerCase();
  v5Log_('INFO', 'Assigned ' + staff.name + ' to ' + assignmentKindForLog + ' for ' + item.label + ': ' + assignedNamesForLog.join(', ') + ' in ' + group[0].location + ' using ' + source + '.', {
    period: item.label,
    staff: staff.name,
    students: group.map(function(n) { return n.student.name; }),
    priorities: group.map(function(n) { return n.student.priority; }),
    location: group[0].location,
    supportTypes: group.map(function(n) { return displayStudentSupportTypeV51227_(n.supportType || 'N/A'); }),
    staffSupportType: displayStaffSupportTypeV51227_(staff.supportStaffType || ''),
    source: source
  });
}

function getGeneralStaffPoolForItem_(model, item) {
  let staff = model.staff.filter(function(s) { return !s.absent && !isStaffBlockedForItem_(s, item); });
  if (model.config && model.config.balanceGeneralAssignments) {
    const originalOrder = new Map();
    model.staff.forEach(function(s, i) { originalOrder.set(s.name, i); });
    const load = model.__staffAssignmentLoad || new Map();
    staff = staff.slice().sort(function(a, b) {
      const la = load.get(a.name) || 0;
      const lb = load.get(b.name) || 0;
      if (la !== lb) return la - lb;
      return (originalOrder.get(a.name) || 0) - (originalOrder.get(b.name) || 0);
    });
  }
  return staff;
}

function getStaffingWarningsV5_(model, assignments) {
  const warnings = [];
  const staffByName = model.staffByName;
  model.schedule.assignmentItems.forEach(function(item) {
    const allForItem = [];
    model.students.forEach(function(student) {
      if (student.absent) return;
      const need = student.needs[item.label];
      if (!need) return;
      const hasLocation = !!clean_(need.location) && !isNA_(need.location);
      const hasSupport = !!clean_(need.supportRaw || need.support) && String(need.support || '').toUpperCase() !== 'NA';
      if (hasLocation || hasSupport || clean_(need.primary) || clean_(need.secondary)) {
        allForItem.push({ student: student, need: need, hasLocation: hasLocation, hasSupport: hasSupport });
      }
    });
    allForItem.forEach(function(entry) {
      const student = entry.student;
