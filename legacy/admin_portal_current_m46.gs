    }
  }
  return null;
}

function chooseNoCoverageRestWindowV5209_(rows) {
  for (let i = 0; i < rows.length; i++) {
    const row = rows[i];
    if (row && !row.assignment) return row;
  }
  return null;
}

function applyRestNoCoverageWindowV5209_(row, staffName, options, dutyBusyByStaff, breakMinutesByStaff, duration) {
