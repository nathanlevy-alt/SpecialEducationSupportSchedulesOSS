function scheduleStaffRestDutyV5_(model, assignments, staff, options) {
  const duration = options.duration;
  const targetItem = options.targetItem || null;
  const dutyBusyByStaff = options.dutyBusyByStaff;
  const breakMinutesByStaff = options.breakMinutesByStaff;
  const rows = buildRestRowsV5209_(model, assignments, staff, options);
  const groups = restRowsGroupedForPreferenceV51246_(model, rows, targetItem, staff, options);

  // V5.1.209 hierarchy within each timing group:
  // no-coverage-needed -> true free staff -> direct same-location grouping -> Lead coverage.
  for (let g = 0; g < groups.length; g++) {
    const groupRows = groups[g];
    if (!groupRows || !groupRows.length) continue;

    const noCoverage = chooseNoCoverageRestWindowV5209_(groupRows);
    if (noCoverage) return applyRestNoCoverageWindowV5209_(noCoverage, staff.name, options, dutyBusyByStaff, breakMinutesByStaff, duration);

    const methods = ['free', 'direct', 'lead'];
    for (let m = 0; m < methods.length; m++) {
      const picked = chooseRestCoverageByMethodV5209_(model, assignments, groupRows, staff.name, dutyBusyByStaff, methods[m]);
      if (picked) return applyRestCoverageSelectionV5208_(picked.row.candidate, staff.name, picked.row.assignment, picked.cover, options, dutyBusyByStaff, breakMinutesByStaff, duration);
    }
  }

  // Daisy-chain is a true final pass across every assigned target and non-target window.
  const assignedRows = (rows || []).filter(function(row) { return row && row.assignment; });
  const daisyPicked = chooseRestCoverageByMethodV5209_(model, assignments, assignedRows, staff.name, dutyBusyByStaff, 'daisy');
  if (daisyPicked) return applyRestCoverageSelectionV5208_(daisyPicked.row.candidate, staff.name, daisyPicked.row.assignment, daisyPicked.cover, options, dutyBusyByStaff, breakMinutesByStaff, duration);

  return null;
}

function v5BuildQueryStringV5209_(params) {
  const pairs = [];
  Object.keys(params || {}).forEach(function(key) {
    const value = params[key];
    if (value === undefined || value === null || value === '') return;
    pairs.push(encodeURIComponent(key) + '=' + encodeURIComponent(String(value)));
  });
  return pairs.join('&');
}

function v5DriveRestFetchV5209_(path, params) {
  const qs = v5BuildQueryStringV5209_(params || {});
  const url = 'https://www.googleapis.com/drive/v3/' + path + (qs ? '?' + qs : '');
  const response = UrlFetchApp.fetch(url, {
    method: 'get',
    muteHttpExceptions: true,
    headers: { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() }
  });
  const code = response.getResponseCode();
  const text = response.getContentText() || '{}';
  if (code < 200 || code >= 300) {
    throw new Error('Drive REST ' + path + ' failed with HTTP ' + code + ': ' + text.slice(0, 400));
  }
  return JSON.parse(text || '{}');
}

function addValidatedDataFileResultV5209_(out, seen, file, rawQuery, source, diagnostics) {
  let id = String(file && (file.id || file.fileId) || '').trim();
  if (!id && file && file.getId) {
    try { id = String(file.getId() || '').trim(); } catch (e0) {}
  }
  if (!id || seen[id] || out.length >= V5_DATA_FILE_SEARCH_MAX_RESULTS_V5207_) return;
  let driveName = String(file && (file.name || file.title) || '').trim();
  if (!driveName && file && file.getName) {
    try { driveName = String(file.getName() || '').trim(); } catch (e00) {}
  }
  const normalizedQuery = normalizeName_(rawQuery || '');
  diagnostics.scanned++;
  let title = driveName;
  let url = String(file && (file.webViewLink || file.alternateLink) || '').trim();
  if (!url && file && file.getUrl) {
    try { url = String(file.getUrl() || '').trim(); } catch (e01) {}
  }
  try {
    const form = FormApp.openById(id);
    title = String(form.getTitle() || driveName || 'Untitled DATA_FILE form').trim();
    url = String(form.getEditUrl ? form.getEditUrl() : url).trim() || url;
  } catch (err) {
    diagnostics.openFailed++;
    return;
  }
  if (!isApprovedDataFileNameV5207_(title)) {
    diagnostics.rejectedTitle++;
    return;
  }
  const searchable = normalizeName_([title, driveName, id].join(' '));
  if (normalizedQuery && searchable.indexOf(normalizedQuery) < 0) {
    diagnostics.rejectedQuery++;
    return;
  }
  let updated = '';
  try {
    let rawUpdated = file && (file.modifiedTime || file.modifiedDate);
    if (!rawUpdated && file && file.getLastUpdated) rawUpdated = file.getLastUpdated();
    updated = rawUpdated ? Utilities.formatDate(new Date(rawUpdated), 'America/Los_Angeles', 'M/d/yyyy h:mm a') : '';
  } catch (e1) {}
  seen[id] = true;
  out.push({
    id: id,
    name: title,
    driveName: driveName,
    url: url,
    updated: updated,
    source: source || 'Drive'
  });
}

function addSavedDataFileResultsV5209_(out, seen, rawQuery, diagnostics) {
  try {
    const ss = getActiveSpreadsheetV5_();
    ensureCoreSheetsV5_(ss);
    const sheet = ss.getSheetByName(V5.SHEETS.STUDENTS);
    if (!sheet || sheet.getLastRow() < 2) return;
    const headers = getHeaderMap_(sheet);
    const linkCol = findHeaderCol_(headers, ['data files'], 37);
    const values = sheet.getRange(2, linkCol, sheet.getLastRow() - 1, 1).getValues();
    values.forEach(function(row) {
      const raw = String(row && row[0] || '').trim();
      if (!raw) return;
      let id = extractGoogleFormFileIdV5208_(raw);
      try {
        const form = openDataFileFormFromInputV5208_(raw);
        id = String(form.getId() || id || '').trim();
        if (!id || seen[id]) return;
        const title = String(form.getTitle() || '').trim();
        if (!isApprovedDataFileNameV5207_(title)) return;
        const normalizedQuery = normalizeName_(rawQuery || '');
        if (normalizedQuery && normalizeName_([title, id].join(' ')).indexOf(normalizedQuery) < 0) return;
