    if (r.extraBlankColumns > 25) issues.push({ severity: 'Info', sheet: r.sheet, message: r.extraBlankColumns + ' blank columns after the last data column.' });
    if (r.wideConditionalFormatRanges) issues.push({ severity: 'Medium', sheet: r.sheet, message: r.wideConditionalFormatRanges + ' conditional-format range(s) appear very wide/full-sheet.' });
  });
  return { ok: true, version: '5.1.399', message: issues.length ? 'Sheet audit found cleanup opportunities.' : 'Sheet audit complete. No major blank-range issues found.', spreadsheetId: ss.getId(), spreadsheetName: ss.getName(), totalMs: Date.now() - started, rows: rows, issues: issues };
