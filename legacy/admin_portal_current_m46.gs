function restCoverageMethodNameV5209_(method) {
  if (method === 'free') return 'true free staff';
  if (method === 'direct') return 'direct same-location temporary grouping';
  if (method === 'lead') return 'Lead staff coverage';
  if (method === 'daisy') return 'daisy-chain coverage';
  return String(method || 'coverage');
}

function restRowsForGroupV5209_(rows, targetGroup) {
  return (rows || []).filter(function(row) {
    return targetGroup ? !!row.targetBlock : !row.targetBlock;
  });
}

function buildRestRowsV5209_(model, assignments, staff, options) {
  const duration = options.duration;
  const targetItem = options.targetItem || null;
  const dutyBusyByStaff = options.dutyBusyByStaff;
  const candidates = buildRestCandidateWindowsV5_(model, staff, duration, targetItem, dutyBusyByStaff, assignments);
  return (candidates || []).map(function(candidate, idx) {
    const item = candidate.item;
    const assignment = getStaffAssignmentForItemV5_(staff.name, item, assignments);
    const targetBlock = !!(targetItem && item && normalizeName_(item.label) === normalizeName_(targetItem.label));
    return {
      candidate: candidate,
      item: item,
      assignment: assignment,
      index: idx,
      targetBlock: targetBlock,
      hasAssignment: !!assignment
    };
  }).sort(function(a, b) {
    if (a.targetBlock !== b.targetBlock) return a.targetBlock ? -1 : 1;
    const as = a.candidate && a.candidate.score;
    const bs = b.candidate && b.candidate.score;
    if (as !== bs) return (as || 0) - (bs || 0);
    const ast = a.candidate && a.candidate.start;
    const bst = b.candidate && b.candidate.start;
    if (ast !== bst) return (ast || 0) - (bst || 0);
    return (a.index || 0) - (b.index || 0);
  });
}

function findFreeCoverForRestWindowV5209_(model, assignments, row, breakerName, dutyBusyByStaff) {
