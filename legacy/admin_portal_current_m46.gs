function getRestPreferenceConflictAnalyzerV51251() {
  const ss = getActiveSpreadsheetV5_();
  const model = loadModelV5_(ss);
  const run = buildAssignmentsBreaksWithEmergencyLunchV5_(model);
  const rules = getAlertRulesV51251_();
  const rows = [];
  if (rules.showRestPreferenceAlerts === false) return { ok:true, rows:[] };
  const requiredOnly = rules.showRequiredRestPreferenceAlertsOnly === true;
  const requiredBuckets = {};
  (model.staff || []).forEach(function(staff) {
    if (!staff || !staff.name || staff.absent || isCoachStaffV5_(staff)) return;
    ['Lunch','Break'].forEach(function(kind) {
      if (kind === 'Lunch' && !staff.lunchEligibleByPartialAbsence) {
        if (rules.showPartialDayRestEligibilityAlerts !== false) rows.push({severity:'Info', type:'Partial-day rest ineligible', staff:staff.name, restType:kind, detail:staff.name + ' is below the 225-minute lunch eligibility threshold.', explanation:'The scheduler will not generate lunch for partial-day staff under 225 working minutes.', nextStep:'Review Attendance if this was unexpected.'});
        return;
      }
      if (kind === 'Break' && !staff.breakEligibleByPartialAbsence) {
        if (rules.showPartialDayRestEligibilityAlerts !== false) rows.push({severity:'Info', type:'Partial-day rest ineligible', staff:staff.name, restType:kind, detail:staff.name + ' is below the 240-minute break eligibility threshold.', explanation:'The scheduler will not generate a break for partial-day staff under 240 working minutes.', nextStep:'Review Attendance if this was unexpected.'});
        return;
      }
      const pref = restPreferenceForStaffV51246_(staff, kind);
      if (!restPreferenceIsConfiguredV51246_(pref)) return;
      const required = pref.strength === 'Require this time';
      if (requiredOnly && !required) return;
      const scheduled = scheduledRestForStaffV51251_(run.breaks, staff.name, kind);
      const unassigned = unassignedRestForStaffV51251_(run.breaks, staff.name, kind);
      const target = restPreferenceTargetLabelV51251_(pref);
      if (required) {
        const key = kind + '|' + normalizeName_(target);
        if (!requiredBuckets[key]) requiredBuckets[key] = {kind:kind, target:target, names:[]};
        requiredBuckets[key].names.push(staff.name);
      }
      if (unassigned) {
        rows.push({severity: required ? 'High' : 'Medium', type:'Rest preference conflict', staff:staff.name, restType:kind, detail:kind + ' was not scheduled for ' + staff.name + ' with preference: ' + target + '.', explanation: required ? 'Require this time can leave the rest item unscheduled when no legal matching window exists.' : 'The preference could not be satisfied by a legal coverage window.', nextStep: required ? 'Change Require this time to Prefer this time, widen the preference, or adjust coverage rules.' : 'Review nearby windows or coverage availability.'});
      } else if (scheduled && !restItemMatchesPreferenceV51251_(model, scheduled, pref)) {
        rows.push({severity: required ? 'High' : 'Low', type:'Rest preference fallback', staff:staff.name, restType:kind, detail:staff.name + ' was scheduled ' + (scheduled.time || formatTimeRange_(scheduled.startMinutes, scheduled.endMinutes)) + ' instead of ' + target + '.', explanation: required ? 'A required preference was not matched; this should be reviewed.' : 'Prefer this time allows fallback to another legal window.', nextStep: required ? 'Review the rest preference details and rerun generation.' : 'No action needed unless the timing should be required.'});
      } else if (scheduled && !requiredOnly) {
        rows.push({severity:'Info', type:'Rest preference honored', staff:staff.name, restType:kind, detail:staff.name + ' has ' + kind.toLowerCase() + ' scheduled at ' + (scheduled.time || formatTimeRange_(scheduled.startMinutes, scheduled.endMinutes)) + '.', explanation:'The selected rest preference was compatible with the generated schedule.', nextStep:'No action needed.'});
      }
    });
  });
  Object.keys(requiredBuckets).forEach(function(key) {
    const b = requiredBuckets[key];
    if (b.names.length > 1) rows.push({severity:'Medium', type:'Required rest crowding', staff:b.names.join(', '), restType:b.kind, detail:b.names.length + ' staff require ' + b.kind.toLowerCase() + ' at ' + b.target + '.', explanation:'Many staff requiring the same narrow rest window can reduce coverage flexibility.', nextStep:'Consider using Prefer this time for lower-risk preferences or staggering required windows.'});
  });
  const rank = {High:0, Medium:1, Low:2, Info:3};
  rows.sort(function(a,b){return (rank[a.severity]||9)-(rank[b.severity]||9) || String(a.staff||'').localeCompare(String(b.staff||''));});
  return { ok:true, rows:rows };
}

function supportTypeStaffMatchesNeedV51251_(needType, staffType) {
  const need = normalizeName_(needType || '');
  const type = normalizeName_(staffType || '');
  if (!need || need === 'n/a' || need === 'na' || need === 'none') return true;
  if (!type) return true;
  if (need === 'behavior') return type.indexOf('behavior') >= 0;
  if (need === 'instruction') return type.indexOf('special education') >= 0 || type.indexOf('instruction') >= 0;
  return true;
}

function getSupportTypeCoverageAnalyzerV51251() {
  const ss = getActiveSpreadsheetV5_();
  const model = loadModelV5_(ss);
  const run = buildAssignmentsBreaksWithEmergencyLunchV5_(model);
  const rules = getAlertRulesV51251_();
  const rows = [];
  const supportMismatchOn = rules.showSupportTypeMismatchAlerts !== false;
  const capacityOn = rules.showSupportTypeCapacityAlerts !== false;
  const staffTypeByName = new Map();
  (model.staff || []).forEach(function(st){ staffTypeByName.set(normalizeName_(st.name || ''), st.supportStaffType || ''); });
  if (supportMismatchOn) {
    (run.assignments && run.assignments.byPeriod ? Array.from(run.assignments.byPeriod.values()) : []).forEach(function(periodResult) {
      (periodResult.staffAssignments || new Map()).forEach(function(assignment, staffName) {
        const staffType = staffTypeByName.get(normalizeName_(staffName || '')) || '';
        (assignment.needs || []).forEach(function(n) {
          if (!n || !n.student) return;
          if (!supportTypeStaffMatchesNeedV51251_(n.supportType, staffType)) {
            rows.push({severity:'Medium', type:'Support type mismatch', period:n.period || (periodResult.item && periodResult.item.label) || '', periodDisplay:getPeriodDisplayLabelForOutputV5158_(n.period || (periodResult.item && periodResult.item.label) || ''), staff:staffName, student:n.student.name, detail:n.student.name + ' needs ' + (n.supportType || 'support') + ' support but is assigned to ' + staffName + (staffType ? ' (' + staffType + ')' : '') + '.', explanation:'Cross-type coverage may be legal when enabled, but exact support-type matches should be reviewed first.', nextStep:'Check Support Type settings or update staff/student support type if this match is intentional.'});
          }
        });
      });
    });
  }
  if (capacityOn) {
    const activeByType = { behavior:0, instruction:0 };
    (model.staff || []).forEach(function(st) {
      if (!st || st.absent || !isActiveOrBlankStatusForOut_(st)) return;
      const type = normalizeName_(st.supportStaffType || '');
      if (type.indexOf('behavior') >= 0) activeByType.behavior++;
      if (type.indexOf('special education') >= 0 || type.indexOf('instruction') >= 0) activeByType.instruction++;
    });
    (model.schedule.assignmentItems || []).forEach(function(item) {
      const needs = getNeedsForItem_(model, item);
      const behaviorNeeds = needs.filter(function(n){ return normalizeName_(n.supportType) === 'behavior'; });
      const instructionNeeds = needs.filter(function(n){ return normalizeName_(n.supportType) === 'instruction'; });
      if (behaviorNeeds.length > activeByType.behavior && activeByType.behavior > 0) rows.push({severity:'Medium', type:'Behavior support capacity', period:item.label, periodDisplay:getPeriodDisplayLabelForOutputV5158_(item.label), detail:behaviorNeeds.length + ' Behavior support needs and ' + activeByType.behavior + ' active Behavior Interventionist(s).', explanation:'Demand may exceed exact-match staff type capacity for this item.', nextStep:'Review cross-coverage settings, staffing, and priority order.'});
      if (instructionNeeds.length > activeByType.instruction && activeByType.instruction > 0) rows.push({severity:'Medium', type:'Instruction support capacity', period:item.label, periodDisplay:getPeriodDisplayLabelForOutputV5158_(item.label), detail:instructionNeeds.length + ' Instruction support needs and ' + activeByType.instruction + ' active Special Education Assistant(s).', explanation:'Demand may exceed exact-match staff type capacity for this item.', nextStep:'Review cross-coverage settings, staffing, and priority order.'});
    });
  }
  const unassigned = ((run.assignments && run.assignments.unassigned) || []);
  unassigned.forEach(function(n) {
    if (!n || !n.student) return;
    rows.push({severity:'High', type:'Uncovered support need', period:n.period || '', periodDisplay:getPeriodDisplayLabelForOutputV5158_(n.period || ''), student:n.student.name, detail:n.student.name + ' remains uncovered for ' + (n.supportType || n.supportRaw || 'support') + ' at ' + (n.location || 'location') + '.', explanation:'Support type, availability, blocked pairings, and capacity may all contribute to uncovered needs.', nextStep:'Use Assignment Analyzer and review Support Type settings.'});
  });
  const rank = {High:0, Medium:1, Low:2, Info:3};
  rows.sort(function(a,b){return (rank[a.severity]||9)-(rank[b.severity]||9) || String(a.period||'').localeCompare(String(b.period||''));});
  return { ok:true, rows:rows };
}

function runRestOptimizationV51251(payload) {
