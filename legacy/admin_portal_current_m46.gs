function periodDisplayToInternalKeyV5322_(value) {
  const original = clean_(value);
  if (!original) return '';
  const direct = canonicalPeriodLabel_(original);
  if (direct) return direct;
  const normalized = normalizeName_(original);
  const labels = (typeof getPeriodDisplayNameMapV5141_ === 'function') ? getPeriodDisplayNameMapV5141_() : {};
  const keys = (typeof getStudentScheduleItemKeysV5141_ === 'function') ? getStudentScheduleItemKeysV5141_() : [];
  for (const key in labels) {
    if (normalizeName_(labels[key]) === normalized) return key;
    if (normalizeName_(key) === normalized) return key;
  }
  for (let i = 0; i < keys.length; i++) {
    const k = keys[i];
    if (normalizeName_(k) === normalized) return k;
    const display = getPeriodDisplayLabelForOutputV5158_(k);
    if (normalizeName_(display) === normalized) return k;
  }
  return original;
