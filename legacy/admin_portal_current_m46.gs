function ensureIdColumnV5340_(sheet, headerName) {
  let headers = getHeaderMap_(sheet);
  let col = findHeaderCol_(headers, [headerName, headerName.replace(/\s+/g,''), 'id'], 0);
  if (!col) {
    col = sheet.getLastColumn() + 1;
    sheet.getRange(1, col).setValue(headerName).setFontWeight('bold');
  }
  try { sheet.getRange(1, col, Math.max(1, sheet.getMaxRows()), 1).clearDataValidations(); } catch (err) {}
  return col;
}

function ensureStableIdsForSheetV5340_(ss, sheetName, headerName, prefix) {
  const sheet = ss.getSheetByName(sheetName);
  if (!sheet || sheet.getLastRow() < 2) return { sheet: sheetName, added: 0, rows: 0 };
  const headers = getHeaderMap_(sheet);
  const nameCol = findHeaderCol_(headers, ['name','staff name','staff','student name','student'], 1);
  const idCol = ensureIdColumnV5340_(sheet, headerName);
  const rowCount = sheet.getLastRow() - 1;
  const names = sheet.getRange(2, nameCol, rowCount, 1).getDisplayValues();
  const ids = sheet.getRange(2, idCol, rowCount, 1).getDisplayValues();
  let added = 0;
  const out = ids.map(function(row, i){
    const existing = clean_(row[0]);
    const name = clean_(names[i][0]);
    if (!name) return [existing];
    if (existing) return [existing];
    added++;
    return [prefix + '-' + Utilities.getUuid().replace(/-/g,'').slice(0, 12).toUpperCase()];
  });
  if (rowCount > 0) sheet.getRange(2, idCol, rowCount, 1).setValues(out);
  return { sheet: sheetName, added: added, rows: rowCount };
}

function stabilizeDatabaseV5340() {
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    const ss = getActiveSpreadsheetV5_();
    const validation = stripDatabaseValidationRulesV5340_(ss);
    const staff = ensureStableIdsForSheetV5340_(ss, V5.SHEETS.STAFF, V5340_ID_HEADERS_.STAFF, 'STAFF');
    const students = ensureStableIdsForSheetV5340_(ss, V5.SHEETS.STUDENTS, V5340_ID_HEADERS_.STUDENT, 'STU');
    const stabilizedAt = markDatabaseStabilizedV5341_();
    clearSchoolDataCacheV5340_();
    return { ok: true, validation: validation, staffIds: staff, studentIds: students, stabilizedAt: stabilizedAt, message: 'Database stabilized once: sheet validation rules removed and stable IDs checked.' };
  } finally {
    try { lock.releaseLock(); } catch (err) {}
  }
}

function runDataHealthCheckV5340(payload) {
  payload = payload || {};
  let repairResult = null;
  if (payload.repair) repairResult = stabilizeDatabaseV5340();
  const ss = getActiveSpreadsheetV5_();
  const staffRows = getCanonicalStaffRowsV5340_(ss, { noCache: !!payload.repair });
  const studentRows = getStudentRowsV5340_(ss, { noCache: !!payload.repair });
  const items = [];
  function dupes(rows, label) {
    const seen = {}, dup = {};
    rows.forEach(function(r){ const k=normalizeName_(r.name); if(!k)return; if(seen[k])dup[k]=(dup[k]||[seen[k]]).concat([r.name]); else seen[k]=r.name; });
    Object.keys(dup).forEach(function(k){ items.push({ severity: 'High', message: 'Duplicate ' + label + ' name: ' + dup[k].join(' / ') }); });
  }
  dupes(staffRows, 'staff');
  dupes(studentRows, 'student');
  staffRows.forEach(function(r){ if (r.isCurrent && !r.isActive && r.status) items.push({ severity: 'Info', message: 'Current non-active staff retained: ' + r.name + ' (' + r.status + ')' }); });
  const missingUrls = studentRows.filter(function(r){ return !clean_(r.dataFiles); });
  if (missingUrls.length) items.push({ severity: 'Info', message: missingUrls.length + ' student(s) do not have a Data Files URL.' });
  const summary = {
    'current staff': getCurrentStaffRowsV5340_(ss, true).length,
    'active staff': getActiveStaffRowsV5340_(ss).length,
    'students': studentRows.length,
    'issues': items.filter(function(i){ return i.severity !== 'Info'; }).length,
    'database stabilized': getDatabaseStabilizedAtV5341_() || 'Not recorded'
  };
  return {
    ok: true,
    message: payload.repair ? 'Database stabilized and health check complete.' : 'Data health check complete.',
    summary: summary,
    items: items,
    repairMessage: repairResult ? ('Removed validation rules from ' + repairResult.validation.sheetsTouched + ' sheet(s); added ' + repairResult.staffIds.added + ' staff ID(s) and ' + repairResult.studentIds.added + ' student ID(s).') : '',
    repair: repairResult
  };
}

