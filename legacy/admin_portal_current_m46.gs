function isSelectedCampusAllowedV5370_(campusId, spreadsheetId) {
  campusId = String(campusId || '').trim();
  spreadsheetId = String(spreadsheetId || '').trim();
  if (!campusId || !spreadsheetId) return false;
  try {
    const email = getCurrentUserEmailV5253_();
    const campuses = getCampusRowsV5253_().filter(function(c) { return String(c.status || 'Active').toLowerCase() !== 'inactive'; });
    const campus = campuses.filter(function(c) { return c.campusId === campusId && c.spreadsheetId === spreadsheetId; })[0];
    if (!campus) return false;
    const users = getCampusUserRowsV5253_();
    if (!users.length) return true;
    if (isSystemAdminV5253_(email, users)) return true;
    return users.some(function(u) {
      return u.email === email && String(u.status || '').toLowerCase() === 'active' && (u.campusId === '*' || u.campusId === campusId);
