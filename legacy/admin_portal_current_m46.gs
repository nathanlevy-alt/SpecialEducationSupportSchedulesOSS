function studentNoSupportEquivalentV5336_(value) {
  const s = String(value == null ? '' : value).trim().toLowerCase().replace(/[\s_\-]+/g, '');
  return !s || s === 'na' || s === 'n/a' || s === 'none' || s === 'nosupport' || s === 'notneeded';
}

function studentCellComparableForColumnV5336_(value, col, supportCols) {
  if (supportCols && supportCols[col] && studentNoSupportEquivalentV5336_(value)) return 'nosupport';
  return studentCellComparableV5335_(value);
}

function studentCellComparableV5335_(value) {
  if (value instanceof Date) return 'date:' + value.getTime();
  if (value === true || value === false) return 'bool:' + String(value);
  if (value == null) return '';
  return String(value);
}

function setStudentCoreRowValuesSafelyV5335_(sheet, rowIndex, rowValues, existingValues, existingFormulas, isNewRow) {
  if (!sheet) throw new Error('Student sheet not found.');
  rowIndex = Number(rowIndex || 0);
  if (!rowIndex || rowIndex < 2) throw new Error('Student row not found.');
  const width = rowValues.length;
  // Do not set the whole row at once, even for new rows. Some existing school
  // databases have legacy validation on individual support cells, and a broad
  // setValues call can reject default no-support values like N/A. The cell-by-cell
  // writer below skips no-op values and clears no-support cells safely.
  const headers = sheet.getRange(1, 1, 1, Math.max(sheet.getLastColumn(), width)).getDisplayValues()[0];
  const supportColsV5336 = studentSupportColumnSetV5336_();
  for (let c = 1; c <= width; c++) {
    let next = rowValues[c - 1];
    const existingComparable = (existingFormulas && existingFormulas[c - 1]) ? existingFormulas[c - 1] : (existingValues ? existingValues[c - 1] : '');
    if (studentCellComparableForColumnV5336_(next, c, supportColsV5336) === studentCellComparableForColumnV5336_(existingComparable, c, supportColsV5336)) continue;
    const cell = sheet.getRange(rowIndex, c);
    try {
      if (supportColsV5336[c] && studentNoSupportEquivalentV5336_(next)) {
        cell.clearContent();
      } else if (typeof next === 'string' && next.charAt(0) === '=') {
        cell.setFormula(next);
      } else {
        cell.setValue(next);
      }
    } catch (err) {
      if (supportColsV5336[c] && studentNoSupportEquivalentV5336_(next)) {
        try { cell.clearContent(); continue; } catch (clearErr) {}
      }
      const letter = columnToLetterV5335_(c);
      const header = clean_((headers && headers[c - 1]) || '');
      throw new Error('Could not save the student row because column ' + letter + (header ? ' (' + header + ')' : '') + ' rejected the value. This usually means the cell has a dropdown/data-validation rule that does not include the selected value. Original error: ' + String(err && err.message ? err.message : err));
    }
  }
}

function columnToLetterV5335_(col) {
  col = Number(col || 0);
  let s = '';
  while (col > 0) {
    const m = (col - 1) % 26;
    s = String.fromCharCode(65 + m) + s;
    col = Math.floor((col - m) / 26);
  }
  return s || '?';
}

function saveStudentFromManagerV5367_original_(payload) {
