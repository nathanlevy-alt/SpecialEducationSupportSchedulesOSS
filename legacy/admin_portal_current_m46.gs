  return getTodoItemsV5();
}

function getScheduleNowV5() {
  const ss = getActiveSpreadsheetV5_();
  const model = loadModelV5_(ss);
  const run = buildAssignmentsBreaksWithEmergencyLunchV5_(model);
  const views = buildPortalScheduleViewsV5_(model, run.assignments, run.breaks);
  const pacificNowV05418H = (typeof _v05418hPacificNow_ === 'function') ? _v05418hPacificNow_() : {date: new Date(), minutes: Number(Utilities.formatDate(new Date(), 'America/Los_Angeles', 'H')) * 60 + Number(Utilities.formatDate(new Date(), 'America/Los_Angeles', 'm')), timeLabel: Utilities.formatDate(new Date(), 'America/Los_Angeles', 'h:mm a')};
  const now = pacificNowV05418H.date;
  const nowM = pacificNowV05418H.minutes;
  const items = (model.schedule.assignmentItems || []).slice().sort(function(a,b){return (a.startMinutes == null ? 99999 : a.startMinutes) - (b.startMinutes == null ? 99999 : b.startMinutes);});
  let current = null, status = 'Now', next = null;
  if (items.length) {
    current = items.find(function(it){ return it.startMinutes != null && it.endMinutes != null && nowM >= it.startMinutes && nowM < it.endMinutes; });
    if (!current) {
      const future = items.find(function(it){ return it.startMinutes != null && nowM < it.startMinutes; });
      if (future) { current = future; status = (future === items[0]) ? 'Upcoming' : 'Next'; }
      else { current = items[items.length - 1]; status = 'Ended'; }
    }
    next = items.find(function(it){ return it.startMinutes != null && current && it.startMinutes > current.startMinutes; });
  }
  const label = current ? current.label : '';
  const title = current ? formatDashboardItemHeaderV5_(current) : '';
  const staffRows = (views.staffSchedules || []).map(function(s) {
    const r = (s.rows || []).find(function(x){return x.period === label;}) || {};
    const rest = r.restEvents && r.restEvents.length ? r.restEvents.map(function(ev){return ev.role === 'cover' ? ('Covering ' + ev.staffOnBreak + (ev.time ? ' · ' + ev.time : '')) : ((String(ev.type || '').toLowerCase().indexOf('lunch') >= 0 ? 'Lunch' : 'Break') + (ev.time ? ' · ' + ev.time : ''));}).join(' / ') : '';
    const students = (r.students || []).map(function(st){return st.name;}).join(', ');
    let st = r.status === 'timeBlocked' ? 'Time Blocked' : (students ? students : (r.seeLead ? 'See Lead' : ('Support ' + (views.unassignedSupportLocation || ''))));
    if (rest && !students) st = rest;
    return {staff: s.staff, status: st, detail: r.location || ''};
  });
  const studentRows = (views.studentSchedules || []).map(function(stu) {
    const r = (stu.rows || []).find(function(x){return x.period === label;}) || {};
    const support = String(r.support || '').trim();
    const location = String(r.location || '').trim();
    const sNorm = support.toUpperCase();
    const lNorm = location.toUpperCase();
    const noSupport = !support || sNorm === 'N/A' || sNorm === 'NA' || sNorm === 'NONE' || sNorm === 'NO SUPPORT NEEDED';
    const noLocation = !location || lNorm === 'N/A' || lNorm === 'NA';
    const hasNeed = !noSupport && !noLocation;
    return {student: stu.student, url: stu.url || '', location: r.location || '', support: r.support || '', coveredBy: r.staff || (r.allowedUnstaffed ? 'Allowed unstaffed (Optimization)' : (hasNeed ? 'Needs support - unassigned' : 'No support needed'))};
  });
  return {
    status: status,
    item: label,
    itemTitle: title,
    timeLabel: pacificNowV05418H.timeLabel,
    nextLabel: next ? formatDashboardItemHeaderV5_(next) : '',
    staffRows: staffRows,
    studentRows: studentRows
  };
}

function formatDateTimeV5_(value) {
  if (!value) return '';
  const d = value instanceof Date ? value : new Date(value);
  if (isNaN(d.getTime())) return String(value || '');
  return d.toLocaleString('en-US', {timeZone:'America/Los_Angeles', month:'numeric', day:'numeric', year:'numeric', hour:'numeric', minute:'2-digit'});
}


