function defaultActiveItemsForSchedule_(scheduleType) {
  const t = String(scheduleType || '').toLowerCase();
  if (t.indexOf('day a') >= 0 || t.indexOf('regular - a') >= 0 || t.indexOf('modified - a') >= 0 || t.indexOf('block - a') >= 0) return ['Period 1', 'Period 2', 'Period 3', 'Break', 'Lunch'];
  if (t.indexOf('day b') >= 0 || t.indexOf('regular - b') >= 0 || t.indexOf('modified - b') >= 0 || t.indexOf('block - b') >= 0) return ['Period 4', 'Period 5', 'Period 6', 'Break', 'Lunch'];
  return ['Period 1', 'Period 2', 'Period 3', 'Period 4', 'Period 5', 'Period 6', 'Break', 'Lunch'];
}

