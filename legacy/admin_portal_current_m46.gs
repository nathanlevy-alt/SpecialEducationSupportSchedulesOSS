  return getStaffPortalBaseUrlSettingV5312_();
}

function normalizeStaffPortalBaseUrlV5312_(url) {
  url = clean_(url || '');
  if (!url) return '';
  url = url.split('#')[0];
  return url;
}

function getSelectedCampusIdV5312_() {
  try {
    const id = PropertiesService.getUserProperties().getProperty('V5_SELECTED_CAMPUS_ID') || '';
    if (id) return id;
  } catch (err) {}
  try {
    const ctx = getAllowedCampusesV5253();
    return clean_(ctx && ctx.selectedCampusId || '');
  } catch (err2) {}
  return '';
}

function getStaffPortalSecretV5312_() {
  const props = PropertiesService.getScriptProperties();
  let secret = '';
  try { secret = props.getProperty('V5_STAFF_PORTAL_TOKEN_SECRET_V5312') || ''; } catch (e) {}
  if (!secret) {
    secret = Utilities.getUuid() + ':' + Utilities.getUuid();
    try { props.setProperty('V5_STAFF_PORTAL_TOKEN_SECRET_V5312', secret); } catch (e2) {}
  }
  return secret;
}

// V05421: reads the per-staff token version written by the Node-side revoke action
// (bumpStaffTokenVersionV05421 in server.js) so tokens generated here go stale the same
// way tokens generated by the Node endpoints do. Stored as an ordinary sheet, so it's
// readable here the same way any other sheet is -- no new plumbing needed.
function getStaffTokenVersionV05421_(campusId, staffName) {
  try {
    const ss = getActiveSpreadsheetV5_();
    const sheet = ss.getSheetByName('_StaffTokenVersions');
    if (!sheet) return 0;
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) return 0;
    const values = sheet.getRange(2, 1, lastRow - 1, 2).getValues();
    const key = normalizeName_(staffName);
    for (let i = 0; i < values.length; i++) {
      if (String((values[i] && values[i][0]) || '').trim().toLowerCase() === key) return Number(values[i][1] || 0) || 0;
    }
    return 0;
  } catch (e) { return 0; }
}

// V05422: real auto-revoke-on-status-change. Bumping the version here invalidates every
// previously issued portal/app QR and link for this staff member -- Security Manager's
// "revoked" display for inactive staff reflects this actually having happened, not just a
// visual label.
function bumpStaffTokenVersionV05421_(campusId, staffName) {
  try {
    const ss = getActiveSpreadsheetV5_();
    let sheet = ss.getSheetByName('_StaffTokenVersions');
    if (!sheet) { sheet = ss.insertSheet('_StaffTokenVersions'); sheet.getRange(1, 1, 1, 3).setValues([['Staff Key', 'Version', 'LinkGeneratedAt']]); }
    const key = normalizeName_(staffName);
    const lastRow = sheet.getLastRow();
    let foundRow = -1, currentVersion = 0;
    if (lastRow >= 2) {
      const values = sheet.getRange(2, 1, lastRow - 1, 2).getValues();
      for (let i = 0; i < values.length; i++) {
        if (String((values[i] && values[i][0]) || '').trim().toLowerCase() === key) { foundRow = i + 2; currentVersion = Number(values[i][1] || 0) || 0; break; }
      }
    }
    const nextVersion = currentVersion + 1;
    if (foundRow > 0) sheet.getRange(foundRow, 1, 1, 3).setValues([[key, nextVersion, '']]);
    else sheet.getRange(Math.max(sheet.getLastRow() + 1, 2), 1, 1, 3).setValues([[key, nextVersion, '']]);
    return nextVersion;
  } catch (e) { return 0; }
}

// V05422: revocation (including auto-revoke) wipes any passcode too, per spec -- a
// reinstated/reactivated staff member sets a fresh one rather than reusing an old PIN
// tied to a now-dead link.
function clearStaffPasscodeV05422_(campusId, staffName) {
  try {
    const ss = getActiveSpreadsheetV5_();
    const sheet = ss.getSheetByName('_StaffPasscodes');
    if (!sheet) return;
    const key = normalizeName_(staffName);
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) return;
    const values = sheet.getRange(2, 1, lastRow - 1, 1).getValues();
    for (let i = values.length - 1; i >= 0; i--) {
      if (String((values[i] && values[i][0]) || '').trim().toLowerCase() === key) sheet.deleteRow(i + 2);
    }
  } catch (e) {}
}

function makeStaffPortalTokenV5312_(campusId, staffName) {
  campusId = clean_(campusId || getSelectedCampusIdV5312_() || 'default');
  staffName = clean_(staffName || '');
  if (!staffName) return '';
  const version = getStaffTokenVersionV05421_(campusId, staffName);
  const raw = campusId + '|' + normalizeName_(staffName) + '|' + version;
  const sig = Utilities.computeHmacSha256Signature(raw, getStaffPortalSecretV5312_());
  return Utilities.base64EncodeWebSafe(sig).replace(/=+$/,'').slice(0, 24);
}

// V5.1.313: Staff Portal token validation/identity helpers.
function validateStaffPortalTokenV5313_(campusId, staffName, token) {
  campusId = clean_(campusId || getSelectedCampusIdV5312_() || 'default');
  staffName = clean_(staffName || '');
  token = clean_(token || '');
  if (!staffName || !token) return false;
  return token === makeStaffPortalTokenV5312_(campusId, staffName);
}

function resolveStaffPortalIdentityV5313_(payload) {
  payload = payload || {};
  const campusId = clean_(payload.schoolId || payload.school || payload.campusId || payload.campus || getSelectedCampusIdV5312_() || 'default');
  const staffName = clean_(payload.staffName || payload.staff || payload.name || '');
  const token = clean_(payload.staffToken || payload.token || '');
  const valid = !!(staffName && token && validateStaffPortalTokenV5313_(campusId, staffName, token));
  return { valid: valid, staffName: valid ? staffName : '', token: token, schoolId: campusId };
}

function buildStaffPortalUrlV5312_(opts) {
  opts = opts || {};
  let base = normalizeStaffPortalBaseUrlV5312_(opts.baseUrl || getStaffPortalEffectiveBaseUrlV5312_());
  if (!base) return '';
  const campusId = clean_(opts.schoolId || opts.campusId || getSelectedCampusIdV5312_());
  const staffName = clean_(opts.staffName || '');
  const token = clean_(opts.staffToken || (staffName ? makeStaffPortalTokenV5312_(campusId, staffName) : ''));
  const sep = base.indexOf('?') >= 0 ? '&' : '?';
  const parts = [];
  if (campusId) parts.push('school=' + encodeURIComponent(campusId));
  if (staffName) parts.push('staff=' + encodeURIComponent(staffName));
  if (token) parts.push('staffToken=' + encodeURIComponent(token));
  return base + (parts.length ? sep + parts.join('&') : '');
}

function getStaffPortalSettingsV5312() {
  const ctx = getAllowedCampusesV5253();
  const baseUrl = getStaffPortalBaseUrlSettingV5312_();
  const effectiveBaseUrl = getStaffPortalEffectiveBaseUrlV5312_();
  return {
    ok: true,
    baseUrl: baseUrl,
    effectiveBaseUrl: effectiveBaseUrl,
    selectedCampusId: clean_(ctx && ctx.selectedCampusId || getSelectedCampusIdV5312_()),
    currentCampusName: clean_(ctx && ctx.currentCampus && ctx.currentCampus.campusName || '')
  };
}


function getPublicStaffPortalScriptPropertiesV5315() {
  const ctx = getAllowedCampusesV5253();
  if (!ctx || !(ctx.systemAdmin || ctx.actualSystemAdmin)) throw new Error('Only District/System Admin users can view public Staff Portal setup values.');
  const rows = getCampusRowsV5253_().filter(function(c) {
    return String(c.status || 'Active').toLowerCase() !== 'inactive' && c.campusId && c.spreadsheetId;
  });
  const schools = {};
  rows.forEach(function(c) {
    schools[clean_(c.campusId)] = {
      name: clean_(c.campusName || c.campusId),
      spreadsheetId: clean_(c.spreadsheetId)
    };
  });
  const schoolsJson = JSON.stringify(schools, null, 2);
  return {
    ok: true,
    schoolsProperty: 'V5_PUBLIC_STAFF_PORTAL_SCHOOLS_JSON',
    schoolsJson: schoolsJson,
    tokenSecretProperty: 'V5_STAFF_PORTAL_TOKEN_SECRET_V5312',
    tokenSecret: getStaffPortalSecretV5312_(),
    schoolKeys: Object.keys(schools)
  };
}

function saveStaffPortalSettingsV5312(payload) {
  const ctx = getAllowedCampusesV5253();
  if (!ctx || !(ctx.systemAdmin || ctx.actualSystemAdmin)) throw new Error('Only District/System Admin users can edit Staff Portal settings.');
  const baseUrl = normalizeStaffPortalBaseUrlV5312_(payload && payload.baseUrl || '');
  const props = PropertiesService.getScriptProperties();
  if (baseUrl) props.setProperty('V5_STAFF_PORTAL_BASE_URL_V5312', baseUrl);
  else props.deleteProperty('V5_STAFF_PORTAL_BASE_URL_V5312');
  return getStaffPortalSettingsV5312();
}

function getStaffPortalLinkForStaffV5312(payload) {
  payload = payload || {};
  const staffName = clean_(payload.staffName || '');
  if (!staffName) return { ok:false, link:'', message:'Choose a staff member first.' };
  const campusId = clean_(payload.schoolId || payload.campusId || getSelectedCampusIdV5312_());
  const baseUrl = clean_(payload.baseUrl || getStaffPortalEffectiveBaseUrlV5312_());
  return { ok:true, staffName:staffName, schoolId:campusId, link:buildStaffPortalUrlV5312_({baseUrl:baseUrl, schoolId:campusId, staffName:staffName}) };
}

function getStaffPortalBaseUrlV5108() {
  return getStaffPortalEffectiveBaseUrlV5312_();
}


function getStaffPortalSchoolIdFromParamsV5262_(params) {
  params = params || {};
  return clean_(params.school || params.schoolId || params.campus || params.campusId || params.site || params.code || '');
}

function getStaffPortalSchoolNameForParamsV5264_(params) {
  const schoolId = getStaffPortalSchoolIdFromParamsV5262_(params || {});
  if (!schoolId) return '';
  const target = String(schoolId || '').trim().toLowerCase();
  try {
    const rows = getCampusRowsV5253_().filter(function(c) {
      return String(c.status || 'Active').toLowerCase() !== 'inactive';
    });
    const found = rows.filter(function(c) {
      return String(c.campusId || '').toLowerCase() === target || String(c.campusName || '').toLowerCase() === target;
    })[0];
    return found ? clean_(found.campusName || found.campusId || schoolId) : clean_(schoolId);
  } catch (e) {
    return clean_(schoolId);
  }
}

function getStaffPortalSpreadsheetIdForSchoolV5262_(schoolId) {
  schoolId = clean_(schoolId || '');
  if (!schoolId) return '';
  const target = schoolId.toLowerCase();
  const active = getCampusRowsV5253_().filter(function(c) {
    return String(c.status || 'Active').toLowerCase() !== 'inactive';
  });
  const found = active.filter(function(c) {
    return String(c.campusId || '').toLowerCase() === target || String(c.campusName || '').toLowerCase() === target;
  })[0];
  if (!found || !found.spreadsheetId) throw new Error('Staff Portal school not found or inactive: ' + schoolId);
  return found.spreadsheetId;
}

function withStaffPortalSchoolV5262_(schoolId, fn) {
  schoolId = clean_(schoolId || '');
  if (!schoolId) return fn();
  const oldId = V5262_REQUEST_SPREADSHEET_ID;
  const oldActive = V5262_STAFF_PORTAL_OVERRIDE_ACTIVE;
  V5262_REQUEST_SPREADSHEET_ID = getStaffPortalSpreadsheetIdForSchoolV5262_(schoolId);
  V5262_STAFF_PORTAL_OVERRIDE_ACTIVE = true;
  try {
    return fn();
  } finally {
    V5262_REQUEST_SPREADSHEET_ID = oldId;
    V5262_STAFF_PORTAL_OVERRIDE_ACTIVE = oldActive;
  }
}

