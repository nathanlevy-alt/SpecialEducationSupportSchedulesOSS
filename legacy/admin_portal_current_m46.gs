// =====================================================================================
// V5.1.20 Embedded Scenario Result Matrix
// Precomputes real scenario schedules for Attendance dates at page render time so
// Scenario Preview can actually run assignment logic without relying on the broken
// google.script.run argument path. The browser selects the precomputed date/type result.
// =====================================================================================
function buildScenarioResultMatrixV520_(attendanceMatrix) {
  const out = {ok:true, source:'embeddedScenarioResultMatrixV520', byKey:{}, keys:[], errors:[], combosBuilt:0, attendanceDates:[]};
  try {
    attendanceMatrix = attendanceMatrix || buildScenarioAttendanceMatrixV519_();
    const dateKeys = Object.keys((attendanceMatrix && attendanceMatrix.byDate) || {}).sort();
    out.attendanceDates = dateKeys.slice(0, 50);
    if (!dateKeys.length) return out;
    const ss = getActiveSpreadsheetV5_();
    const config = loadConfigV5_(ss);
    let types = (config.scheduleTypes || []).map(function(t){ return String(t || '').trim(); }).filter(Boolean);
    try {
      const cal = ss.getSheetByName(V5.SHEETS.CALENDAR);
      if (cal && cal.getLastRow() >= 2) {
        const cVals = cal.getDataRange().getValues();
        const cDisp = cal.getDataRange().getDisplayValues();
        for (let ci = 1; ci < cVals.length; ci++) {
          const cIso = calendarIsoFromValueV5_(cVals[ci][0], cDisp[ci][0]);
          const cType = String(cDisp[ci][1] || cVals[ci][1] || '').trim();
          if (cIso && dateKeys.indexOf(cIso) >= 0 && cType && types.indexOf(cType) < 0) types.push(cType);
        }
      }
    } catch (typeErr) {}
    if (!types.length) types = [''];
    // Prevent page-load lag. This still covers the current use case: Attendance dates x Calendar Manager schedule types.
    const maxCombos = 60;
    for (let i = 0; i < dateKeys.length; i++) {
      for (let j = 0; j < types.length; j++) {
        if (out.combosBuilt >= maxCombos) {
          out.errors.push('Scenario result matrix limited to first ' + maxCombos + ' date/type combinations to avoid page-load lag.');
          return out;
        }
        const key = dateKeys[i] + '||' + types[j];
        try {
          const result = runScenarioPreviewV5({date: dateKeys[i], scheduleType: types[j], source: 'embeddedScenarioResultMatrixV520'});
          if (result && result.impact) {
            if (!result.impact.attendanceDiagnostics) result.impact.attendanceDiagnostics = {};
            result.impact.attendanceDiagnostics.endpoint = 'embeddedScenarioResultMatrixV520';
            result.impact.requestedDate = dateKeys[i];
          }
          out.byKey[key] = result;
          out.keys.push(key);
          out.combosBuilt++;
        } catch (innerErr) {
          out.errors.push(key + ': ' + String(innerErr && innerErr.message || innerErr));
        }
      }
    }
  } catch (err) {
    out.ok = false;
    out.errors.push(String(err && err.message || err));
  }
  return out;
}

// V5.1.19 Embedded Scenario Attendance Matrix
// Builds a small Attendance date index during page render, avoiding google.script.run
// argument/return issues in Scenario Preview. This reuses the same Attendance sheet
// readers and Column D start-date convention used elsewhere.
// =====================================================================================
function buildScenarioAttendanceMatrixV519_() {
  const out = {ok:true, source:'embeddedAttendanceMatrixV519', byDate:{}, rowCount:0, sheetFound:false, sheetName:'', errors:[]};
  try {
    const ss = getActiveSpreadsheetV5_();
    const sh = getAttendanceSheetV5_(ss);
    if (!sh) {
      out.ok = false;
      out.errors.push('Attendance sheet not found.');
      return out;
    }
    out.sheetFound = true;
    out.sheetName = sh.getName();
    const lastRow = sh.getLastRow();
    out.rowCount = Math.max(0, lastRow - 1);
    if (lastRow < 2) return out;
    const width = Math.max(11, sh.getLastColumn());
    const values = sh.getRange(2, 1, lastRow - 1, width).getValues();
    const display = sh.getRange(2, 1, lastRow - 1, width).getDisplayValues();
    const headerMap = getHeaderMap_(sh);
    const colName = findHeaderCol_(headerMap, ['name','staff','staff name','employee'], 2) - 1;
    const colStart = findHeaderCol_(headerMap, ['start date','absence date','date'], 4) - 1;
    const colEnd = findHeaderCol_(headerMap, ['end date','last day','last date'], 5) - 1;
    const colReason = findHeaderCol_(headerMap, ['reason','reason for absence'], 6) - 1;
    const colDayPart = findHeaderCol_(headerMap, ['day part','absence length','absence details'], 7) - 1;
    const colArrival = findHeaderCol_(headerMap, ['arrival time','arrive','i will arrive at'], 8) - 1;
    const colLeave = findHeaderCol_(headerMap, ['leave time','leave','i will leave at'], 9) - 1;
    const colNotes = findHeaderCol_(headerMap, ['notes','note'], 10) - 1;
    function cell(row, idx){ return idx >= 0 && idx < row.length ? row[idx] : ''; }
    function addRowForKey(key, item){ if(!key) return; if(!out.byDate[key]) out.byDate[key]=[]; out.byDate[key].push(item); }
    for (let i = 0; i < values.length; i++) {
      const rowNum = i + 2;
      const name = clean_(cell(display[i], colName) || cell(values[i], colName));
      const startDisplay = String(cell(display[i], colStart) || '').trim();
      const endDisplay = String(cell(display[i], colEnd) || '').trim();
      const startKey = scenarioDateKeyFromInputV5_(startDisplay) || scenarioDateKeyFromInputV5_(cell(values[i], colStart));
      let endKey = scenarioDateKeyFromInputV5_(endDisplay) || scenarioDateKeyFromInputV5_(cell(values[i], colEnd));
      if (!startKey) continue;
      if (!endKey) endKey = startKey;
      const item = {
        row: rowNum,
        name: name,
        startDate: startKey,
        endDate: endKey === startKey ? '' : endKey,
        startDisplay: startDisplay || startKey,
        endDisplay: endDisplay,
        reason: String(cell(display[i], colReason) || cell(values[i], colReason) || '').trim(),
        dayPart: String(cell(display[i], colDayPart) || cell(values[i], colDayPart) || '').trim(),
        arrivalTime: String(cell(display[i], colArrival) || cell(values[i], colArrival) || '').trim(),
        leaveTime: String(cell(display[i], colLeave) || cell(values[i], colLeave) || '').trim(),
        notes: String(cell(display[i], colNotes) || cell(values[i], colNotes) || '').trim()
      };
      addRowForKey(startKey, item);
      if (endKey && endKey !== startKey) {
        try {
          const startD = new Date(startKey + 'T00:00:00');
          const endD = new Date(endKey + 'T00:00:00');
          for (let d = new Date(startD.getTime() + 86400000); d <= endD; d = new Date(d.getTime() + 86400000)) {
            addRowForKey(Utilities.formatDate(d, 'America/Los_Angeles', 'yyyy-MM-dd'), item);
          }
        } catch (rangeErr) {}
      }
    }
  } catch (err) {
    out.ok = false;
    out.errors.push(String(err && err.message || err));
  }
  return out;
}


// V5.1.25 stable rollback lazy Scenario Preview helpers
