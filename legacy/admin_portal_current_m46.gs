-family:inherit;"><thead><tr><th style="text-align:center;font-size:13px;font-weight:400;color:#111827;background:#f8fafc;padding:5px 3px;border-right:1px solid #d9e2ef;">Mon</th><th style="text-align:center;font-size:13px;font-weight:400;color:#111827;background:#f8fafc;padding:5px 3px;border-right:1px solid #d9e2ef;">Tue</th><th style="text-align:center;font-size:13px;font-weight:400;color:#111827;background:#f8fafc;padding:5px 3px;border-right:1px solid #d9e2ef;">Wed</th><th style="text-align:center;font-size:13px;font-weight:400;color:#111827;background:#f8fafc;padding:5px 3px;border-right:1px solid #d9e2ef;">Thu</th><th style="text-align:center;font-size:13px;font-weight:400;color:#111827;background:#f8fafc;padding:5px 3px;">Fri</th></tr></thead><tbody><tr><td style="text-align:center;padding:6px 3px;border-top:1px solid #d9e2ef;border-right:1px solid #d9e2ef;"><input type="checkbox" value="Monday" aria-label="Use secondary as primary Monday" style="width:auto;margin:0;"></td><td style="text-align:center;padding:6px 3px;border-top:1px solid #d9e2ef;border-right:1px solid #d9e2ef;"><input type="checkbox" value="Tuesday" aria-label="Use secondary as primary Tuesday" style="width:auto;margin:0;"></td><td style="text-align:center;padding:6px 3px;border-top:1px solid #d9e2ef;border-right:1px solid #d9e2ef;"><input type="checkbox" value="Wednesday" aria-label="Use secondary as primary Wednesday" style="width:auto;margin:0;"></td><td style="text-align:center;padding:6px 3px;border-top:1px solid #d9e2ef;border-right:1px solid #d9e2ef;"><input type="checkbox" value="Thursday" aria-label="Use secondary as primary Thursday" style="width:auto;margin:0;"></td><td style="text-align:center;padding:6px 3px;border-top:1px solid #d9e2ef;"><input type="checkbox" value="Friday" aria-label="Use secondary as primary Friday" style="width:auto;margin:0;"></td></tr></tbody></table></div></div><div class="altStaffRankPanel"><h3>Alternative Student-Level Staff Rank Order <span class="helpDot" tabindex="0" data-tip="Optional fallback order used after same-period primary/secondary. Unlisted active staff remain available afterward by normal staff rank.">?</span></h3><div class="altStaffRankHint">Optional fallback order used after same-period Primary/Secondary. Only active staff are shown; unlisted active staff remain available afterward by normal staff rank.</div><div class="altStaffRankPicker"><div class="altStaffRankColumn"><div class="altStaffRankColumnTitle">Available Staff</div><input id="altStaffAvailableSearch" class="altStaffAvailableSearch" placeholder="Search active staff"><div id="altStaffAvailableList" class="altStaffAvailableList"></div></div><div class="altStaffRankColumn"><div class="altStaffRankColumnTitle">Selected Rank Order</div><div id="altStaffRankList" class="altStaffRankList"></div></div></div></div><div class="stickyActions toolbar"><button class="btn primary" data-action="student-save">Save Student</button><button class="btn" data-action="student-new">Clear</button></div></div></div></section>

