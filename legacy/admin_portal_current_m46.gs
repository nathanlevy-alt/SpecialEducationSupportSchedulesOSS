function getScheduleBuilderItemOrderV5321_(extraItems) {
  const seen = {};
  const out = [];
  function add(item) {
    item = clean_(item || '');
    if (!item) return;
    const canonical = canonicalPeriodLabel_(item) || item;
    const key = normalizeName_(canonical);
    if (!key || seen[key]) return;
    seen[key] = true;
    out.push(canonical);
  }

  // Core instructional periods first, then site-scoped custom/additional blocks,
  // then any non-empty legacy rows that still need to be preserved, then Break/Lunch.
  V5.PERIODS.forEach(add);
  try {
    getPeriodMetaV5131_().forEach(function(row) {
      const key = clean_((row && row.key) || '');
