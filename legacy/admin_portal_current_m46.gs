function buildAssignableGroupForStaff_(model, item, anchor, allNeeds, staff, periodResult, source) {
  if (anchor.support !== 'GROUP') {
    return [anchor];
  }

  const maxSize = getMaxGroupSizeForNeeds_(model, item, [anchor]);
  const group = [anchor];
  const candidates = allNeeds.filter(function(n) {
    return n !== anchor &&
      n.support === 'GROUP' &&
      n.locationKey === anchor.locationKey &&
      !periodResult.studentToStaff.has(n.student.name);
  });

  const sorted = sortGroupCandidates_(model, anchor, candidates);
  for (let i = 0; i < sorted.length; i++) {
    if (group.length >= maxSize) break;
    const candidate = sorted[i];
    const tentative = group.concat([candidate]);
    if (tentative.length <= getMaxGroupSizeForNeeds_(model, item, tentative) && canStaffTakeGroup_(model, staff, item, tentative, periodResult)) {
      group.push(candidate);
    }
  }
  return group;
}

function sortGroupCandidates_(model, anchor, candidates) {
  const strategy = model.config.groupingStrategy;
  const copy = candidates.slice();
  if (strategy === 'HETEROGENOUS') {
    copy.sort(function(a, b) { return b.student.priority - a.student.priority; });
  } else {
    copy.sort(function(a, b) {
      const da = Math.abs(a.student.priority - anchor.student.priority);
      const db = Math.abs(b.student.priority - anchor.student.priority);
      if (da !== db) return da - db;
      return a.student.priority - b.student.priority;
    });
  }
  return copy;
}


