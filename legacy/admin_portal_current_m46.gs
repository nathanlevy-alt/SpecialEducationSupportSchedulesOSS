  const unassigned = extractUnassignedFromViewsV5_(views);
  return {views:views, impact:{absentStaff:absentStaff, absentStaffCount:absentStaff.length, attendanceRowsMatched:attendanceRows.length, attendanceRows:attendanceRows, targetDate:targetKey, requestedDate:payload.date || '', modelDate:dateKeyV5_(model.schedule.date), unassigned:unassigned, unassignedCount:unassigned.length}};
}


