function getPublishedDataUrlV5_(url) {
  url = String(url || '').trim();
  if (!url) return '';
  if (!/docs\.google\.com\/forms/i.test(url)) return url;
  if (/\/d\/e\/[^/]+\/viewform/i.test(url)) return url;
  const cache = getDocumentCacheV650_();
