}

function cloneScheduleTemplateFromDialogV5(sourceName, targetName) {
  sourceName = String(sourceName || '').trim();
  targetName = String(targetName || '').trim();
  if (!sourceName || !targetName) throw new Error('Missing source or target schedule name.');
  const data = getScheduleBuilderDataV5();
  if (!data.templates[sourceName]) throw new Error('Source schedule not found: ' + sourceName);
  if (data.templates[targetName]) throw new Error('A schedule named "' + targetName + '" already exists.');
  const sourceTemplate = data.templates[sourceName] || {};
  const itemOrder = getScheduleBuilderItemOrderV5321_(Object.keys(sourceTemplate));
  const rows = itemOrder.map(function(item, idx) {
    const hasRow = Object.prototype.hasOwnProperty.call(sourceTemplate, item);
    const row = hasRow ? (sourceTemplate[item] || {}) : {};
    return { item: item, active: hasRow ? row.active !== false : false, start: row.start || '', end: row.end || '', sort: row.sort || idx + 1 };
  });
  return saveScheduleTemplateFromDialogV5({ name: targetName, rows: rows });
}



