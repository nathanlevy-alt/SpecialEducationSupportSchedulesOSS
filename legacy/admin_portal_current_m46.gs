function onEdit(e) {
  if (!e || !e.range || !e.source) return;
  const sheet = e.range.getSheet();
  if (sheet.getName() !== V5.SHEETS.MOBILE) return;
  if (!e.range.isChecked || !e.range.isChecked()) return;
  const cell = e.range.getA1Notation();
  try { e.range.uncheck(); } catch (err) {}
  switch (cell) {
    case 'D2': runAllV5(); break;
    case 'D3': runAssignmentsAndDashboardV5(); break;
    case 'D4': runBreaksOnlyV5(); break;
    case 'D5': refreshHomeDashboardV5(); break;
    case 'D6': setupV5Sheets(); break;
    case 'D7': showScheduleBuilderV5(); break;
    case 'D8': showCalendarManagerV5(); break;
    case 'D9': showStudentManagerV5(); break;
    case 'D10': showStaffManagerV5(); break;
    case 'D11': showWebAppPreviewV5(); break;
    case 'D12': emailDailyScheduleV5(); break;
    case 'D13': updateFolderDatesV5(); break;
    case 'D14': clearGeneratedV5Outputs(); break;
    default: e.source.toast('No action is linked to ' + cell + '.', 'Admin Portal', 5);
  }
}

