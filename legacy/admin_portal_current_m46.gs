    function itemTitles(){return (DATA.items||[]).map(function(i){return i.title||i.label;});} function findStudentUrlByName(n){var key=String(n||'').toLowerCase().trim(); if(!key)return ''; var rows=(DATA.studentSchedules||[]); for(var i=0;i<rows.length;i++){if(String(rows[i].student||'').toLowerCase().trim()===key && rows[i].url)return rows[i].url;} return '';} function studentAnchor(o){if(!o)return ''; var n=o.name||o.student||String(o||''); var url=o.url||findStudentUrlByName(n)||''; return url?'<a class="studentLink" href="'+esc(url)+'" target="_blank">'+esc(n)+'</a>':'<span class="studentLink">'+esc(n)+'</span>';}
