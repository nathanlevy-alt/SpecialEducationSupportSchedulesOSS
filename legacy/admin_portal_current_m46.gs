  function rowName(r) { return normalizeName_([r.item, getPeriodDisplayNameV5142_(r.item)].join(' ')); }
  let target = [];
  if (/\blunch\b/i.test(question)) {
    target = rows.filter(function(r) { return /lunch/.test(rowName(r)); });
    if (/\b(a|first|1)\b/i.test(question)) {
      const aRows = target.filter(function(r) { return /\b(a|1|first)\b/.test(rowName(r)); });
      if (aRows.length) target = aRows;
    } else if (/\b(b|second|2)\b/i.test(question)) {
      const bRows = target.filter(function(r) { return /\b(b|2|second)\b/.test(rowName(r)); });
      if (bRows.length) target = bRows;
    }
    return target;
  }
  if (/\bbreak\b/i.test(question)) return rows.filter(function(r) { return /break/.test(rowName(r)); });
  const m = String(question || '').match(/\b(?:period|per|p)\s*([0-9]+)\b/i);
  if (m) {
    const wanted = 'period ' + m[1];
    target = rows.filter(function(r) { return normalizeName_(r.item) === wanted || normalizeName_(getPeriodDisplayNameV5142_(r.item)) === wanted; });
    if (target.length) return target;
  }
  return rows.filter(function(r) { return qn.indexOf(normalizeName_(r.item)) >= 0 || qn.indexOf(normalizeName_(getPeriodDisplayNameV5142_(r.item))) >= 0; });
}

