function eachAssignmentOptimizationSubOptionV5_(option, fn) {
  if (!option) return;
  if (option.rule === 'COMBO' && option.data && Array.isArray(option.data.options)) {
    option.data.options.forEach(function(o) { eachAssignmentOptimizationSubOptionV5_(o, fn); });
    return;
  }
  fn(option);
}


function allowedUnstaffedKeyV5_(period, studentName) {
  return String(period || '') + '||' + normalizeName_(studentName || '');
}

function isAllowedUnstaffedNeedV5_(model, need) {
  if (!model || !need || !model.__allowedUnstaffedKeys) return false;
  const studentName = need.student && need.student.name ? need.student.name : need.student;
  return model.__allowedUnstaffedKeys.has(allowedUnstaffedKeyV5_(need.period, studentName));
}

function applyAssignmentOptimizationOverridesToModelV5_(model, option) {
  model.__genieCapOverrides = [];
  model.__allowedUnstaffed = [];
  model.__allowedUnstaffedKeys = new Set();
  model.__acceptedAssignmentOptimization = option;
  const applied = [];
  eachAssignmentOptimizationSubOptionV5_(option, function(o) {
    if (!o || !o.rule) return;
    if (o.rule === 'CAP_STRUCTURED' || o.rule === 'CAP_OTHER') {
      const amount = Math.max(1, Number(o.data && o.data.amount) || 1);
      model.__genieCapOverrides.push({
        period: String(o.data && o.data.period || ''),
        locationKey: normalizeLocation_(o.data && o.data.location || ''),
        amount: amount
      });
      applied.push('Temporary group-cap increase of ' + amount + ' in ' + (o.data && o.data.location || '') + ' for ' + (o.data && o.data.period || '') + '.');
      return;
    }
    if (/^(STAR_|IND_)/.test(o.rule)) {
      const candidates = [];
      if (o.data && Array.isArray(o.data.candidates)) candidates.push.apply(candidates, o.data.candidates);
      if (o.data && o.data.candidate) candidates.push(o.data.candidate);
      const chosen = candidates[0];
      if (!chosen || !chosen.student || !o.data || !o.data.period) return;
      const student = model.studentsByName.get(normalizeName_(chosen.student));
      if (!student || !student.needs || !student.needs[o.data.period]) return;
      student.needs[o.data.period].support = 'GROUP';
      student.needs[o.data.period].supportRaw = 'Group (Assignment Optimization temporary override)';
      applied.push('Temporary support override: ' + chosen.student + ' treated as Group for ' + o.data.period + '.');
      return;
    }
    if (o.rule === 'ALLOW_UNSTAFFED') {
      const names = (o.data && (o.data.students || [o.data.student])) || [];
      const period = String(o.data && o.data.period || '');
      names.filter(Boolean).forEach(function(name) {
        model.__allowedUnstaffed.push({ period: period, student: name });
        model.__allowedUnstaffedKeys.add(allowedUnstaffedKeyV5_(period, name));
      });
      applied.push('Selected student(s) may remain unstaffed: ' + names.filter(Boolean).join(', ') + ' for ' + period + '.');
      return;
    }
  });
  v5Log_('WARN', 'Assignment Optimization overrides applied for this run only.', {
    option: option.title || option.rule,
    changes: applied,
    explanation: 'These temporary rule relaxations are applied only to this generated run and are not written to the setup sheets.'
  });
}

function applyAssignmentOptimizationPostPeriodV5_(model, item, needs, periodResult) {
  if (!model || !Array.isArray(model.__genieCapOverrides) || !model.__genieCapOverrides.length) return;
  const period = item && item.label;
  const activeOverrides = model.__genieCapOverrides.filter(function(o) { return o && o.period === period; });
  if (!activeOverrides.length) return;

  activeOverrides.forEach(function(o) {
    const locKey = o.locationKey;
    const candidates = needs.filter(function(n) {
      return n && n.support === 'GROUP' && normalizeLocation_(n.location) === locKey && !periodResult.studentToStaff.has(n.student.name);
    }).sort(compareNeedPriority_);
    if (!candidates.length) return;

    let best = null;
    periodResult.staffAssignments.forEach(function(assignment, staffName) {
      if (!assignment || normalizeLocation_(assignment.location) !== locKey) return;
      if ((assignment.needs || []).some(function(n) { return n.support !== 'GROUP'; })) return;
      const staff = model.staffByName.get(normalizeName_(staffName));
      if (!staff) return;
      const currentSize = (assignment.needs || []).length;
      const baseMaxSize = getMaxGroupSizeForNeeds_(model, item, assignment.needs.concat(candidates));
      const maxSize = baseMaxSize + Math.max(1, Number(o.amount) || 1);
      const roomLeft = Math.max(0, maxSize - currentSize);
      if (roomLeft <= 0) return;
      const canAdd = [];
      for (let i = 0; i < candidates.length && canAdd.length < roomLeft; i++) {
        const tentative = assignment.needs.concat(canAdd).concat([candidates[i]]);
        if (canStaffTakeGroup_(model, staff, item, tentative, periodResult)) canAdd.push(candidates[i]);
      }
      if (!canAdd.length) return;
      if (!best || canAdd.length > best.canAdd.length) best = {staff:staff, assignment:assignment, canAdd:canAdd};
    });

    if (!best || !best.canAdd.length) {
      // Fallback: if no existing same-room group can absorb the students, try to create
      // a new same-room group with a currently unassigned legal staff member. This keeps
      // location/blocking rules intact while making accepted Optimization options visible
      // in the generated schedule whenever a legal staff member is available.
      let bestNew = null;
      model.staff.forEach(function(staff) {
        if (!staff || staff.absent || staff.statusInactive) return;
        if (periodResult.staffAssignments.has(staff.name)) return;
        const canAdd = [];
        for (let i = 0; i < candidates.length; i++) {
          const tentative = canAdd.concat([candidates[i]]);
          if (canStaffTakeGroup_(model, staff, item, tentative, periodResult)) canAdd.push(candidates[i]);
        }
        if (canAdd.length && (!bestNew || canAdd.length > bestNew.canAdd.length)) bestNew = {staff: staff, canAdd: canAdd};
      });
      if (bestNew && bestNew.canAdd.length) {
        assignGroupToStaff_(model, bestNew.staff, item, bestNew.canAdd, periodResult, 'Assignment Optimization group-cap expansion');
        bestNew.canAdd.forEach(function(n) {
          v5Log_('WARN', 'Assignment Optimization created temporary expanded group.', {
            period: period,
            staff: bestNew.staff.name,
            student: n.student.name,
            location: n.location,
            explanation: 'This student was assigned to a new same-location group using the accepted Assignment Optimization group-cap relaxation.'
          });
        });
      }
      return;
    }
    best.canAdd.forEach(function(n) {
      best.assignment.needs.push(n);
      best.assignment.studentNames.push(n.student.name);
      best.assignment.notes.push('Assignment Optimization group-cap expansion');
      periodResult.studentToStaff.set(n.student.name, best.staff.name);
      v5Log_('WARN', 'Assignment Optimization added student to temporary expanded group.', {
        period: period,
        staff: best.staff.name,
        student: n.student.name,
        location: n.location,
        explanation: 'This student was added to an existing same-location group using the accepted Assignment Optimization group-cap relaxation.'
      });
    });
  });
}


