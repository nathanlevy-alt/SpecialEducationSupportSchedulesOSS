function getSelectedCampusIdFastV5366_() {
  try {
    const id = clean_(PropertiesService.getUserProperties().getProperty('V5_SELECTED_CAMPUS_ID') || '');
    if (id) return id;
  } catch (err) {}
  // If user property is unavailable, derive from the currently active school spreadsheet.
  // This avoids the expensive getAllowedCampusesV5253() call during manager loads.
  try {
    const activeId = getActiveSpreadsheetV5_().getId();
    const rows = (typeof getCampusRowsV5253_ === 'function') ? getCampusRowsV5253_() : [];
    for (let i = 0; i < rows.length; i++) {
      if (clean_(rows[i].spreadsheetId) === clean_(activeId)) return clean_(rows[i].campusId || rows[i].id || '');
    }
  } catch (err2) {}
  return '';
}

function makeStaffPortalTokenWithSecretV5366_(secret, campusId, staffName) {
  campusId = clean_(campusId || 'default');
  staffName = clean_(staffName || '');
  if (!secret || !staffName) return '';
  const version = getStaffTokenVersionV05421_(campusId, staffName);
  const raw = campusId + '|' + normalizeName_(staffName) + '|' + version;
  const sig = Utilities.computeHmacSha256Signature(raw, secret);
  return Utilities.base64EncodeWebSafe(sig).replace(/=+$/,'').slice(0, 24);
}

function buildStaffPortalUrlFastV5366_(baseUrl, schoolId, staffName, token) {
  baseUrl = normalizeStaffPortalBaseUrlV5312_(baseUrl || '');
  if (!baseUrl) return '';
  schoolId = clean_(schoolId || '');
  staffName = clean_(staffName || '');
  token = clean_(token || '');
  const parts = [];
  if (schoolId) parts.push('school=' + encodeURIComponent(schoolId));
  if (staffName) parts.push('staff=' + encodeURIComponent(staffName));
  if (token) parts.push('staffToken=' + encodeURIComponent(token));
  return baseUrl + (parts.length ? (baseUrl.indexOf('?') >= 0 ? '&' : '?') + parts.join('&') : '');
}

function getConfigList_(sheet, col) {
  if (!sheet || sheet.getLastRow() < 2) return [];
  let last = sheet.getLastRow();
  try {
    const maxScan = Math.max(2, last);
    const vals = sheet.getRange(2, col, maxScan - 1, 1).getDisplayValues().flat();
    let effective = vals.length;
    while (effective > 0 && !clean_(vals[effective - 1])) effective--;
    return unique_(vals.slice(0, effective).map(function(v) { return cleanLocationDisplay_(v); }).filter(Boolean));
  } catch (err) {
    const fallbackLast = Math.max(sheet.getLastRow(), 2);
    return unique_(sheet.getRange(2, col, fallbackLast - 1, 1).getDisplayValues().flat().map(function(v) { return cleanLocationDisplay_(v); }).filter(Boolean));
  }
}

