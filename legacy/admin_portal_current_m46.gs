function seedDefaultSchedulesIfEmptyV5_(ss) {
  const sheet = ss.getSheetByName(V5.SHEETS.SCHEDULES);
  if (sheet.getLastRow() > 1) return;
  const scheduleTypes = getConfigList_(ss.getSheetByName(V5.SHEETS.CONFIG), 3);
  const types = scheduleTypes.length ? scheduleTypes : ['Day A', 'Day B', 'All Periods', 'Finals'];
  const rows = [];
  types.forEach(function(type) {
    const active = defaultActiveItemsForSchedule_(type);
    const items = V5.PERIODS.concat(V5.SPECIAL_ITEMS);
    items.forEach(function(item, idx) {
      rows.push([type, item, active.indexOf(item) >= 0 ? 'Yes' : 'No', '', '', idx + 1]);
