function updateBlockedStaffForStudentV5_(ss, oldName, newName, blockedStaffNames) {
  const staffSheet = ss.getSheetByName(V5.SHEETS.STAFF);
  const headers = getHeaderMap_(staffSheet);
  const colName = findHeaderCol_(headers, ['name'], 1);
  const colBlockedStudents = findHeaderCol_(headers, ['blocked student(s)', 'blocked students'], 4);
  const blockedSet = new Set((blockedStaffNames || []).map(normalizeName_));
  const oldKey = normalizeName_(oldName);
  const newKey = normalizeName_(newName);
  const rows = staffSheet.getDataRange().getValues();
  const display = staffSheet.getDataRange().getDisplayValues();

  for (let r = 1; r < rows.length; r++) {
    const staffName = clean_(display[r][colName - 1] || rows[r][colName - 1]);
    if (!staffName) continue;
    let list = parseMultiValueCell_(display[r][colBlockedStudents - 1] || rows[r][colBlockedStudents - 1]);
    // Remove the old and new names first, then add the current new name only if this staff was checked.
    list = list.filter(function(item) {
      const key = normalizeName_(item);
      return key !== oldKey && key !== newKey;
    });
    if (newName && blockedSet.has(normalizeName_(staffName))) list.push(newName);
    list = uniqueByNormalizedName_(list).sort(function(a, b) { return a.localeCompare(b); });
    staffSheet.getRange(r + 1, colBlockedStudents).setValue(list.join(', '));
  }
}

function uniqueByNormalizedName_(values) {
  const seen = new Set();
  const out = [];
  (values || []).forEach(function(v) {
    const text = clean_(v);
    const key = normalizeName_(text);
    if (!text || seen.has(key)) return;
    seen.add(key);
    out.push(text);
  });
  return out;
}


