// =====================================================================================
// V5.1.16 Scenario Preview no-argument matrix fallback
// Avoids the failing client-to-server argument path by prebuilding previews for
// Attendance dates server-side, then letting the browser select the requested date/type.
// =====================================================================================
function getScenarioPreviewMatrixV517() {
  const out = {
    ok: true,
    endpoint: 'scenarioPreviewMatrixV517',
    scenarios: {},
    availableKeys: [],
    attendanceDateKeys: [],
    scheduleTypes: [],
    attendanceRowCount: 0,
    errors: [],
    sheetFound: false,
    sheetNames: '',
    spreadsheetName: '',
    spreadsheetId: ''
  };

  let ss = null;
  let dateKeys = [];
  let scheduleTypes = ['Regular'];

  try {
    ss = getActiveSpreadsheetV5_();
    try { out.spreadsheetName = ss.getName(); out.spreadsheetId = ss.getId(); out.sheetNames = getSheetNamesV5_(ss); } catch (e) {}

    // Read Attendance FIRST. Earlier builds loaded config before this, so any unrelated
    // config/schedule error made diagnostics misleadingly say Attendance rows: 0.
    const sh = getAttendanceSheetV5_(ss);
    if (!sh) {
      out.ok = false;
      out.errors.push('Attendance sheet not found. Sheets seen: ' + (out.sheetNames || ''));
      return out;
    }
    out.sheetFound = true;
    out.attendanceSheetName = sh.getName();
    const lastRow = sh.getLastRow();
    out.attendanceRowCount = Math.max(0, lastRow - 1);

    if (lastRow >= 2) {
      const width = Math.max(11, sh.getLastColumn());
      const raw = sh.getRange(2, 1, lastRow - 1, width).getValues();
      const disp = sh.getRange(2, 1, lastRow - 1, width).getDisplayValues();
      const keySet = {};
      for (let i = 0; i < raw.length; i++) {
        const startCandidates = [disp[i][3], raw[i][3]]; // Attendance column D
        let startKey = '';
        for (let c = 0; c < startCandidates.length && !startKey; c++) startKey = scenarioDateKeyFromInputV5_(startCandidates[c]);
        if (startKey) keySet[startKey] = true;
      }
      dateKeys = Object.keys(keySet).sort().slice(0, 50);
      out.attendanceDateKeys = dateKeys;
    }

    // Load schedule types after Attendance diagnostics are safely populated.
    try {
      const config = loadConfigV5_(ss);
      if (config && config.scheduleTypes && config.scheduleTypes.length) scheduleTypes = config.scheduleTypes.slice();
    } catch (cfgErr) {
      out.errors.push('Calendar Manager schedule types could not be loaded: ' + String(cfgErr && cfgErr.message || cfgErr));
    }
    out.scheduleTypes = scheduleTypes;

    const maxTypes = Math.min(scheduleTypes.length, 12);
    dateKeys.forEach(function(dateKey) {
      for (let t = 0; t < maxTypes; t++) {
        const type = scheduleTypes[t];
        const matrixKey = dateKey + '||' + type;
        try {
          const result = runScenarioPreviewV5({date: dateKey, scenarioDate: dateKey, scheduleType: type, scenarioType: type, source: 'scenarioPreviewMatrixV517'});
          if (result && result.impact) {
            if (!result.impact.attendanceDiagnostics) result.impact.attendanceDiagnostics = {};
            result.impact.attendanceDiagnostics.endpoint = 'scenarioPreviewMatrixV517';
            result.impact.attendanceDiagnostics.matrixKey = matrixKey;
            result.impact.attendanceDiagnostics.receivedDate = dateKey;
            result.impact.attendanceDiagnostics.receivedScheduleType = type;
            result.impact.attendanceDiagnostics.matrixErrors = out.errors.join(' | ');
            result.impact.requestedDate = dateKey;
          }
          out.scenarios[matrixKey] = result;
          out.availableKeys.push(matrixKey);
        } catch (err) {
          out.errors.push(matrixKey + ': ' + String(err && err.message || err));
          // Still provide a lightweight absence-impact card so the selected date can
          // confirm Attendance matching even if full scenario generation fails.
          try {
            const rows = getAttendanceRowsForDateKeyV5_(ss, dateKey);
            const diag = getAttendanceDiagnosticsForDateV5_(ss, dateKey);
            out.scenarios[matrixKey] = {
              views: {},
              impact: {
                absentStaff: rows.map(function(r){ return {staff:r.name, detail:(r.dayPart || 'Absent') + (r.reason ? ' · ' + r.reason : '')}; }),
                absentStaffCount: rows.length,
                attendanceRowsMatched: rows.length,
                attendanceRows: rows,
                attendanceDiagnostics: diag,
                targetDate: dateKey,
                requestedDate: dateKey,
                unassigned: [],
                unassignedCount: 0
              }
            };
            out.availableKeys.push(matrixKey);
          } catch (fallbackErr) {
            out.errors.push(matrixKey + ' fallback: ' + String(fallbackErr && fallbackErr.message || fallbackErr));
          }
        }
      }
    });
  } catch (err) {
    out.ok = false;
    out.errors.push(String(err && err.stack || err && err.message || err));
  }
  return out;
}


