function saveStaffOnPaperScheduleV5(payload) {
  const ss = getActiveSpreadsheetV5_();
  ensureCoreSheetsV5_(ss);
  payload = payload || {};
  const staffName = clean_(payload.staffName || '');
  if (!staffName) throw new Error('Staff name is required.');
  const assignments = payload.assignments || {};
  const sheet = ss.getSheetByName(V5.SHEETS.STUDENTS);
  if (!sheet || sheet.getLastRow() < 2) return { ok: true, message: 'No student rows found.' };
  const specs = getStudentPeriodSpecsV5_();
  const coreSet = getCoreStudentPeriodKeySetV5141_();
  const allItems = getStudentScheduleItemKeysV5141_();
  const customData = getCustomStudentPeriodDataV5141_();
  const lastRow = sheet.getLastRow();
  const lastCol = Math.max(sheet.getLastColumn(), 39);
  const range = sheet.getRange(2, 1, lastRow - 1, lastCol);
  const values = range.getValues();
  const display = range.getDisplayValues();
  const staffKey = normalizeName_(staffName);
  let changes = 0;

  for (let r = 0; r < values.length; r++) {
    const studentName = clean_(display[r][0] || values[r][0]);
    if (!studentName) continue;
    const studentKey = normalizeName_(studentName);
    specs.forEach(function(spec) {
      const itemAssignments = assignments[spec.label] || { primary: [], secondary: [] };
      const primarySet = new Set((itemAssignments.primary || []).map(normalizeName_));
      const secondarySet = new Set((itemAssignments.secondary || []).map(normalizeName_));
      const pIdx = spec.primaryCol - 1;
      const sIdx = spec.secondaryCol - 1;
      const currentPrimary = clean_(display[r][pIdx] || values[r][pIdx]);
      const currentSecondary = clean_(display[r][sIdx] || values[r][sIdx]);
      const shouldPrimary = primarySet.has(studentKey);
      const shouldSecondary = secondarySet.has(studentKey);
      if (shouldPrimary) { if (currentPrimary !== staffName) { values[r][pIdx] = staffName; changes++; } }
      else if (normalizeName_(currentPrimary) === staffKey) { values[r][pIdx] = ''; changes++; }
      if (shouldSecondary) { if (currentSecondary !== staffName) { values[r][sIdx] = staffName; changes++; } }
      else if (normalizeName_(currentSecondary) === staffKey) { values[r][sIdx] = ''; changes++; }
    });

    // Supplemental custom period blocks are stored in the selected school database properties.
    const saved = customData[studentKey] || {};
    allItems.forEach(function(item) {
      const k = normalizeName_(item);
      if (coreSet[k]) return;
      const row = saved[item] || { location: '', support: 'N/A', primary: '', secondary: '' };
      const itemAssignments = assignments[item] || { primary: [], secondary: [] };
      const primarySet = new Set((itemAssignments.primary || []).map(normalizeName_));
      const secondarySet = new Set((itemAssignments.secondary || []).map(normalizeName_));
      const shouldPrimary = primarySet.has(studentKey);
      const shouldSecondary = secondarySet.has(studentKey);
      if (shouldPrimary && normalizeName_(row.primary || '') !== staffKey) { row.primary = staffName; changes++; }
      else if (!shouldPrimary && normalizeName_(row.primary || '') === staffKey) { row.primary = ''; changes++; }
      if (shouldSecondary && normalizeName_(row.secondary || '') !== staffKey) { row.secondary = staffName; changes++; }
      else if (!shouldSecondary && normalizeName_(row.secondary || '') === staffKey) { row.secondary = ''; changes++; }
      const hasData = clean_(row.location || '') || (clean_(row.support || 'N/A') && normalizeName_(row.support || 'N/A') !== 'n/a') || clean_(row.primary || '') || clean_(row.secondary || '');
      if (hasData) saved[item] = row;
      else delete saved[item];
    });
    if (Object.keys(saved).length) customData[studentKey] = saved;
    else delete customData[studentKey];
  }

  range.setValues(values);
  setJsonPropV5131_('V5_CUSTOM_STUDENT_PERIODS_JSON', customData);
  SpreadsheetApp.flush();
  refreshV5ValidationHelpers();
  return { ok: true, message: 'Saved Staff Assignment for ' + staffName + ' (' + changes + ' change' + (changes === 1 ? '' : 's') + ').' };
}

