function moveStudentPriorityFromManagerV5(payload) {
  const ss = getActiveSpreadsheetV5_();
  ensureCoreSheetsV5_(ss);
  const sheet = ss.getSheetByName(V5.SHEETS.STUDENTS);
  const name = clean_((payload && (payload.oldName || payload.name)) || '');
  let rowIndex = Number(payload && payload.rowIndex) || findStudentRowByNameV5_(sheet, name);
  if (!rowIndex || rowIndex < 2) throw new Error('Student not found.');
  const direction = clean_(payload && payload.direction).toLowerCase();
  const lastRow = sheet.getLastRow();
  const lastCol = Math.max(sheet.getLastColumn(), 39);
  let newRowIndex = rowIndex;

  // Priority is formula-driven from the physical row order in Students.
  // This function physically moves the entire row on the sheet instead of writing over the priority cell.
  if (direction === 'up') {
    if (rowIndex <= 2) return { ok: true, rowIndex: rowIndex, message: name + ' is already at the top priority.' };
    // Insert a blank row above the previous row, copy the selected row into it, then delete the original row.
    // Example: move row 5 up -> insert before row 4; original row 5 becomes row 6; copy row 6 to row 4; delete row 6.
    const insertAt = rowIndex - 1;
    sheet.insertRowBefore(insertAt);
    const sourceAfterInsert = rowIndex + 1;
    sheet.getRange(sourceAfterInsert, 1, 1, lastCol).copyTo(sheet.getRange(insertAt, 1, 1, lastCol), { contentsOnly: false });
    sheet.deleteRow(sourceAfterInsert);
    newRowIndex = rowIndex - 1;
  } else if (direction === 'down') {
    if (rowIndex >= lastRow) return { ok: true, rowIndex: rowIndex, message: name + ' is already at the lowest priority.' };
    // Insert a blank row after the next row, copy the selected row into it, then delete the original row.
    // Example: move row 5 down -> insert after row 6; copy row 5 to row 7; delete row 5; copied row becomes row 6.
    const insertAfter = rowIndex + 1;
    sheet.insertRowAfter(insertAfter);
    const targetBeforeDelete = insertAfter + 1;
    sheet.getRange(rowIndex, 1, 1, lastCol).copyTo(sheet.getRange(targetBeforeDelete, 1, 1, lastCol), { contentsOnly: false });
    sheet.deleteRow(rowIndex);
    newRowIndex = rowIndex + 1;
  } else {
    throw new Error('Direction must be up or down.');
  }

  ensureStudentPriorityFormulasV5_(sheet);
  SpreadsheetApp.flush();
  refreshV5ValidationHelpers();
  return { ok: true, rowIndex: newRowIndex, message: 'Moved ' + name + ' ' + direction + '. Priority is controlled by the physical row order on Students.' };
}


function reorderStudentPriorityOrderFromManagerV5367_original_(payload) {
  const ss = getActiveSpreadsheetV5_();
  ensureCoreSheetsV5_(ss);
  const sheet = ss.getSheetByName(V5.SHEETS.STUDENTS);
  const order = (payload && payload.order) || [];
  if (!order.length) throw new Error('No student priority order was provided.');

  const lastRow = sheet.getLastRow();
  const lastCol = Math.max(sheet.getLastColumn(), 39);
  if (lastRow < 2) return { ok: true, message: 'No student rows to reorder.' };

  const range = sheet.getRange(2, 1, lastRow - 1, lastCol);
  const values = range.getValues();
  const formulas = range.getFormulas();
  const display = range.getDisplayValues();

  const rowObjects = [];
  for (let i = 0; i < values.length; i++) {
    const name = clean_(display[i][0] || values[i][0]);
    if (!name) continue;
    rowObjects.push({ name: name, values: values[i], formulas: formulas[i] });
  }

  const byName = new Map();
  rowObjects.forEach(function(obj) { byName.set(normalizeKey_(obj.name), obj); });

  const seen = new Set();
  const reordered = [];
  order.forEach(function(item) {
    const key = normalizeKey_(item.name || '');
    if (!key || seen.has(key)) return;
    const obj = byName.get(key);
    if (obj) {
      reordered.push(obj);
      seen.add(key);
    }
  });

  rowObjects.forEach(function(obj) {
    const key = normalizeKey_(obj.name);
    if (!seen.has(key)) reordered.push(obj);
  });

  if (reordered.length !== rowObjects.length) {
    throw new Error('Priority reorder did not include all student rows. Refresh the portal and try again.');
  }

  const output = reordered.map(function(obj) {
    return obj.values.map(function(value, colIndex) {
      return obj.formulas[colIndex] || value;
    });
  });

  if (output.length) {
    sheet.getRange(2, 1, output.length, lastCol).setValues(output);
  }
  ensureStudentPriorityFormulasV5_(sheet);
  try { sheet.getRange(2, 3, output.length, 1).insertCheckboxes(); } catch (e) {}
  SpreadsheetApp.flush();
  refreshV5ValidationHelpers();
  return { ok: true, message: 'Saved student priority order. Priority now follows the physical row order on Students.' };
}

function ensureStudentPriorityFormulasV5_(sheet) {
  if (!sheet) return;
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return;
  const formulas = [];
  for (let r = 2; r <= lastRow; r++) {
    formulas.push(['=IF(A' + r + '<>"",ROW()-1,"")']);
  }
  sheet.getRange(2, 2, formulas.length, 1).setFormulas(formulas);
}

function deleteStudentFromManagerV5367_original_(payload) {
