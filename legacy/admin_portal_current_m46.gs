        staffBlockedFromProposedLocation: staffRows.filter(function(st) { return (st.blockedRooms || []).map(normalizeLocation_).indexOf(normalizeLocation_(location)) >= 0; }).map(function(st) { return st.name; }).slice(0, 25),
