function getPortalSecuritySettingsV5() {
  const props = PropertiesService.getScriptProperties();
  return {
    requirePasscode: props.getProperty('V5_REQUIRE_PASSCODE') === 'true',
    passcodeSet: !!props.getProperty('V5_PASSCODE_HASH')
  };
}

function savePortalSecuritySettingsV5(payload) {
  payload = payload || {};
  const props = PropertiesService.getScriptProperties();
  const requirePasscode = payload.requirePasscode === true || String(payload.requirePasscode).toLowerCase() === 'true';
  const pass = String(payload.passcode || '');
  const confirm = String(payload.confirmPasscode || '');
  const hasExisting = !!props.getProperty('V5_PASSCODE_HASH');
  if (requirePasscode) {
    if (pass || confirm) {
      if (pass !== confirm) throw new Error('Passcodes do not match. Security settings were not saved.');
      if (pass.length < 4) throw new Error('Passcode must be at least 4 characters.');
      const salt = Utilities.getUuid();
      props.setProperty('V5_PASSCODE_SALT', salt);
      props.setProperty('V5_PASSCODE_HASH', hashPortalPasscodeV5_(pass, salt));
    } else if (!hasExisting) {
      throw new Error('Enter and confirm a passcode before requiring a passcode.');
    }
  }
  props.setProperty('V5_REQUIRE_PASSCODE', requirePasscode ? 'true' : 'false');
  return { ok: true, message: requirePasscode ? 'Saved security settings. Passcode is required.' : 'Saved security settings. Passcode is not required.' };
}

function verifyPortalPasscodeV5(passcode) {
  const props = PropertiesService.getScriptProperties();
  if (props.getProperty('V5_REQUIRE_PASSCODE') !== 'true') return { ok: true, message: 'Passcode not required.' };
  if (V5_DEVELOPER_PASSCODE_HASH && hashPortalDeveloperPasscodeV5_(String(passcode || '')) === V5_DEVELOPER_PASSCODE_HASH) return { ok: true, message: 'Developer bypass unlocked.' };
  if (V5_DEVELOPER_PASSCODE && String(passcode || '') === String(V5_DEVELOPER_PASSCODE)) return { ok: true, message: 'Developer bypass unlocked.' };
  const salt = props.getProperty('V5_PASSCODE_SALT') || '';
  const hash = props.getProperty('V5_PASSCODE_HASH') || '';
  const given = hashPortalPasscodeV5_(String(passcode || ''), salt);
  if (hash && given === hash) return { ok: true, message: 'Unlocked.' };
  return { ok: false, message: 'Incorrect passcode.' };
}

function hashPortalPasscodeV5_(passcode, salt) {
  const bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(salt || '') + '|' + String(passcode || ''), Utilities.Charset.UTF_8);
  return bytes.map(function(b) {
    const v = (b < 0 ? b + 256 : b).toString(16);
    return v.length === 1 ? '0' + v : v;
  }).join('');
}

function hashPortalDeveloperPasscodeV5_(passcode) {
  const bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(passcode || ''), Utilities.Charset.UTF_8);
  return bytes.map(function(b) {
    const v = (b < 0 ? b + 256 : b).toString(16);
    return v.length === 1 ? '0' + v : v;
  }).join('');
}

