function getStudentDataFilesUrlColumnV5334_(sheet) {
  // Standard student database layout stores the Data Files URL in AK / column 37.
  // Earlier V5.1.334 matching was too broad and could select a validated support column
  // such as AC when a header contained generic words like data/source/form. Keep this
  // intentionally conservative so Student Manager and Data Manager write the same URL cell.
  const standardCol = 37;
  if (!sheet) return standardCol;
  const lastCol = Math.max(sheet.getLastColumn(), 39, standardCol);
  const headers = sheet.getRange(1, 1, 1, lastCol).getDisplayValues()[0].map(function(h) { return clean_(h); });
  const exact = {
    'data files url': true,
    'data file url': true,
    'datafilesurl': true,
    'data files': true,
    'data file': true,
    'student data files url': true,
    'student data file url': true,
    'google form url': true,
    'form url': true,
    'data url': true
  };
  for (let i = 35; i < headers.length; i++) { // AJ and later only; avoids period/support validation columns.
    const key = headers[i].toLowerCase().replace(/\s+/g, ' ').trim();
    const compact = key.replace(/[^a-z0-9]/g, '');
    if (exact[key] || exact[compact]) return i + 1;
  }
  return standardCol;
}

function normalizeStudentDataFilesUrlForSaveV5334_(value) {
  const rawUrl = clean_(value || '');
  if (!rawUrl) return '';
  return normalizeDataFileFormUrlV5208_(rawUrl);
}

function writeStudentDataFilesUrlCellV5334_(sheet, rowIndex, value) {
  if (!sheet) throw new Error('Student sheet not found.');
  rowIndex = Number(rowIndex || 0);
  if (!rowIndex || rowIndex < 2 || rowIndex > sheet.getLastRow()) throw new Error('Student row not found.');
  const url = normalizeStudentDataFilesUrlForSaveV5334_(value);
  const linkCol = getStudentDataFilesUrlColumnV5334_(sheet);
  const cell = sheet.getRange(rowIndex, linkCol);
  // The Data Files URL cell should be free text. Clear accidental copied dropdown
  // validation before writing so a URL is not rejected by legacy validation rules.
  try { cell.clearDataValidations(); } catch (e) {}
  cell.setValue(url);
  return { url: url, col: linkCol };
}

function updateStudentDataFileUrlV5(payload) {
  const ss = getActiveSpreadsheetV5_();
  ensureCoreSheetsV5_(ss);
  const sheet = ss.getSheetByName(V5.SHEETS.STUDENTS);
  const rowIndex = Number(payload && payload.rowIndex);
  const result = writeStudentDataFilesUrlCellV5334_(sheet, rowIndex, (payload && payload.url) || '');
  return { ok: true, url: result.url, col: result.col, message: result.url ? 'Data file saved.' : 'Data link cleared.' };
}

function updateStudentDataFileUrlsV5(payloads) {
  const ss = getActiveSpreadsheetV5_();
  ensureCoreSheetsV5_(ss);
  const sheet = ss.getSheetByName(V5.SHEETS.STUDENTS);
  const lastRow = sheet.getLastRow();
  const rows = Array.isArray(payloads) ? payloads : [];
  let count = 0;
  let firstError = null;
  rows.forEach(function(payload) {
    const rowIndex = Number(payload && payload.rowIndex);
    if (!rowIndex || rowIndex < 2 || rowIndex > lastRow) return;
    try {
      writeStudentDataFilesUrlCellV5334_(sheet, rowIndex, (payload && payload.url) || '');
      count++;
    } catch (err) {
      if (!firstError) firstError = err;
    }
  });
  if (firstError && !count) throw firstError;
  return { ok: true, message: count + ' DATA_FILE link(s) saved.' };
}


