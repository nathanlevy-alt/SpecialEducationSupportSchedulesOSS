}

function getStaffAbsenceCountsSinceSchoolYearV5288_(ss) {
  const out = {};
  const start = parseSchoolYearStartDateV5288_();
  const sheet = getAttendanceSheetV5_(ss);
  if (!sheet || sheet.getLastRow() < 2) return out;
  const headers = getHeaderMap_(sheet);
  const nameCol = findHeaderCol_(headers, ['name'], 2);
  const startCol = findHeaderCol_(headers, ['start date'], 4);
  const tsCol = findHeaderCol_(headers, ['timestamp'], 1);
  const statusCol = findHeaderCol_(headers, ['status'], 11);
  const values = sheet.getDataRange().getValues();
  const display = sheet.getDataRange().getDisplayValues();
  for (let r=1; r<values.length; r++) {
    const status = normalizeName_(display[r][statusCol-1] || values[r][statusCol-1]);
    if (status === 'cancelled' || status === 'canceled' || status === 'deleted') continue;
    const name = clean_(display[r][nameCol-1] || values[r][nameCol-1]);
    if (!name) continue;
    const dateVal = values[r][startCol-1] || display[r][startCol-1] || values[r][tsCol-1] || display[r][tsCol-1];
    const d = dateVal instanceof Date ? dateVal : parseAttendanceDateValueV5_(dateVal, dateVal);
    if (!d) continue;
    if (start && !isOnOrAfterSchoolYearStartV5288_(d)) continue;
    const key = normalizeName_(name);
    out[key] = (out[key] || 0) + 1;
  }
  return out;
}

function enrichStaffManagerDataV5288_(ss, staff) {
  staff = staff || [];
  const stats = getStaffContributionStatsV5288_(ss);
  const abs = getStaffAbsenceCountsSinceSchoolYearV5288_(ss);
  const hasStart = !!getSchoolYearStartDateV5288_();
  staff.forEach(function(s) {
    const key = normalizeName_(s && s.name || '');
    const st = stats[key] || {};
    s.lastDataSubmitted = st.lastSubmitted || '';
    s.dataPointsContributed = Number(st.count || 0);
    if (hasStart) s.totalAbsences = String(abs[key] || 0);
  });
}


