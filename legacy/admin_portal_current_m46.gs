  if (!cfg.enabled) throw new Error('Coverage Coach is currently disabled. Enable it in the Coverage Coach settings panel.');
  if (!cfg.hasApiKey) throw new Error('No Gemini API key is saved. Paste the key into the Coverage Coach settings panel and click Save.');
  const answer = callGeminiCoverageCoachV5345_('Reply with exactly this sentence: Coverage Coach connection successful.', { maxOutputTokens: 60, temperature: 0, contextNote: 'connection test' });
  return { ok: true, message: answer || 'Coverage Coach connection successful.', model: cfg.model };
}

function askCoverageCoachV5345(payload) {
  payload = payload || {};
  const started = new Date().getTime();
  const cfg = getCoverageCoachConfigV5345();
  if (!cfg.enabled) throw new Error('Coverage Coach is disabled. Open System Admin > Coverage Coach and turn the global setting on.');
  const question = clean_(payload.question || '');
  if (!question) throw new Error('Ask a question first.');

  // V5.1.352: Do not build the full scheduler/Gemini context for facts that the
  // portal can answer deterministically. This keeps simple questions like
  // "what time is lunch on an A Day?" from spinning for minutes.
  const fast = tryCoverageCoachFastAnswerV5352_(payload, cfg);
  if (fast) {
    fast.elapsedMs = new Date().getTime() - started;
    return fast;
  }

  if (!cfg.hasApiKey) throw new Error('Coverage Coach needs a Gemini API key. Open the gear in the Coverage Coach panel, paste the key, and save.');
  const route = classifyCoverageCoachRouteV5352_(question);
  const context = route.light ? buildCoverageCoachLightContextV5352_(payload, route) : buildCoverageCoachContextV5345_(payload);
  const prompt = buildCoverageCoachPromptV5345_(question, context, cfg);
  const rawAnswer = callGeminiCoverageCoachV5345_(prompt, { maxOutputTokens: route.maxOutputTokens || 1800, temperature: route.temperature == null ? 0.12 : route.temperature, model: route.model || '' });
  const answer = sanitizeCoverageCoachAnswerV5353_(rawAnswer || 'I could not generate an answer.', question);
  const suggestions = shouldCoverageCoachShowSuggestedActionsV5353_(question) ? suggestCoverageCoachActionsV5345_(question, context) : [];
  return { ok: true, answer: answer, contextSummary: context.summary || {}, suggestedActions: suggestions, elapsedMs: new Date().getTime() - started };
}

function shouldCoverageCoachShowSuggestedActionsV5353_(question) {
  const q = String(question || '').toLowerCase();
  if (/^(what time|when|where|who is|which is|what is)\b/.test(q) && !/why|impact|what if|problem|issue|error|not showing|unassigned|risk|publish|before publishing/.test(q)) return false;
  return /publish|health|data|issue|error|not showing|missing|what if|impact|unassigned|risk|coverage|how do i|where do i/.test(q);
}

function sanitizeCoverageCoachAnswerV5353_(answer, question) {
  let text = String(answer || '');
  // Keep responses user-facing. Gemini sometimes echoes JSON/key names from the context.
  const replacements = [
    [/`?scheduleViews\.items`?/gi, 'the published schedule period list'],
    [/`?scheduleViews`?/gi, 'the published schedule'],
    [/`?context\.server`?/gi, 'the scheduler context'],
    [/`?context\.request`?/gi, 'the current page context'],
    [/`?payload`?/gi, 'the request'],
    [/`?studentSchedules`?/gi, 'student schedule rows'],
    [/`?staffSchedules`?/gi, 'staff schedule rows'],
    [/`?breakItems`?/gi, 'break/lunch rows']
  ];
  replacements.forEach(function(pair) { text = text.replace(pair[0], pair[1]); });
  const q = String(question || '').toLowerCase();
  const explicitPlanning = /what if|impact|change|move|moved|went to|absence|absent|coverage risk|unassigned|why did|why is/.test(q);
  const troubleshooting = /check next|what should i check|before publishing|problem|issue|error|not showing|missing|wrong|health/.test(q);
  if (!explicitPlanning) {
    text = text.replace(/^\s*\*\*Likely schedule impact:\*\*\s*$/gim, '');
    text = text.replace(/^\s*Likely schedule impact:\s*$/gim, '');
  }
  if (!troubleshooting && !explicitPlanning) {
    text = text.replace(/^\s*\*\*What to check next:\*\*\s*$/gim, '');
    text = text.replace(/^\s*What to check next:\s*$/gim, '');
  }
  return text.replace(/\n{3,}/g, '\n\n').trim();
}



function classifyCoverageCoachRouteV5352_(question) {
  const q = String(question || '').toLowerCase();
  if (/health|data issue|duplicate|stabilize|validation|not showing|missing|wrong|error/.test(q)) return { light: true, includeHealth: true, includeLogic: true, maxOutputTokens: 1400, temperature: 0.08 };
  if (/restriction|blocked|blocks|priority hold|holds|most constrained|constraints/.test(q)) return { light: true, includeStaffRestrictions: true, includeLogic: true, maxOutputTokens: 1400, temperature: 0.08 };
  if (/bell|period|lunch|break|schedule type|day/.test(q) && !/why|impact|what if|student|staff|assign|unassigned|coverage/.test(q)) return { light: true, includeBell: true, includeLogic: true, maxOutputTokens: 1000, temperature: 0.05 };
  if (/how|logic|rule|explain|what does|where do i|how do i/.test(q) && !/student|staff|unassigned|impact|coverage risk|absent|absence/.test(q)) return { light: true, includeLogic: true, includePortalState: true, maxOutputTokens: 1200, temperature: 0.05 };
  return { light: false, maxOutputTokens: 2200, temperature: 0.12 };
}

function tryCoverageCoachFastAnswerV5352_(payload, cfg) {
  payload = payload || {};
  const question = clean_(payload.question || '');

  // V5.1.354: Tool-first historical/schedule-fact routing. A question that asks for a
  // specific historical fact should never fall through to generic AI help text.
  if (isCoverageCoachHistoricalLookupQuestionV5354_(question)) {
    const ans = answerCoverageCoachHistoricalLookupQuestionV5354_(question, payload);
    if (ans) return ans;
  }

  // Fast bell-schedule time lookup: no Gemini, no Staff/Student reads, no Health Check.
  if (/(what time|when|start|end|time)/i.test(question) && /\b(lunch|break|period|block)\b/i.test(question)) {
    const ans = answerCoverageCoachBellTimeQuestionV5352_(question, payload);
    if (ans) return ans;
  }

  // Fast scheduler logic answer. This is static by design so a general logic question is instant.
  if (/(explain|what|how).*(logic|rules|generate|generation|scheduler|schedule)/i.test(question) && !/(specific|this student|why is|why did|unassigned|absent|absence|impact|what if)/i.test(question)) {
    const g = getCoverageCoachSchedulerLogicGuideV5347_();
    const answer = [
      'The schedule generator is deterministic. It does not use AI to choose assignments.',
      '',
      'Core flow:',
      (g.coreFlow || []).map(function(x, i) { return (i + 1) + '. ' + x; }).join('\n'),
      '',
      'Hard constraints are checked before preferences: ' + (g.hardConstraints || []).join(', ') + '.',
      '',
      'Preferences/scoring then help choose among legal options: ' + (g.softPreferences || []).join(', ') + '.',
      '',
      'Lead status: ' + (g.leadStatus || ''),
      '',
      'For a specific “why was this person assigned/unassigned?” question, ask with the student/staff name and period so I can pull the relevant schedule context.'
    ].join('\n');
    return { ok: true, answer: answer, contextSummary: { fastAnswer: true, route: 'scheduler-logic' }, suggestedActions: [] };
  }

  // Fast staff restriction ranking: one staff-manager read, no full assistant context and no Gemini.
  if (/(which|who|rank|most).*(restriction|restricted|block|blocked|hold|holds|constraint|constrained)/i.test(question) || /(restriction|blocks|holds).*(staff)/i.test(question)) {
    const ans = answerCoverageCoachRestrictionQuestionV5352_(question, payload);
    if (ans) return ans;
  }

  return null;
}

function isCoverageCoachHistoricalLookupQuestionV5354_(question) {
  const q = String(question || '').toLowerCase();
  if (!q) return false;
  if (/\b(history|historical|look back|previous schedule|past schedule|saved schedule)\b/.test(q)) return true;
  if (/\b(who|what|when|where)\b/.test(q) && /\b(covered|covering|cover|break|lunch)\b/.test(q) && /\b\d{1,2}[\/\-]\d{1,2}(?:[\/\-]\d{2,4})?\b/.test(q)) return true;
  return false;
}

function answerCoverageCoachHistoricalLookupQuestionV5354_(question, payload) {
  try {
    const q = clean_(question || '');
    const dateParts = extractCoverageCoachDatePartsV5354_(q);
    const target = extractCoverageCoachPersonForBreakLookupV5354_(q);
    const wantsBreak = /\bbreak\b/i.test(q);
    const wantsLunch = /\blunch\b/i.test(q);
    const wantsCover = /\bcovered|covering|cover\b/i.test(q);

    if (!dateParts && /\b(history|historical|look back|previous|past|saved schedule)\b/i.test(q)) {
      return { ok: true, answer: 'What should I look for in Historical Schedules? Include a date and a staff/student name, such as “Who covered Noah’s break on 5/23?”', contextSummary: { fastAnswer: true, route: 'history-needs-query' }, suggestedActions: [] };
    }
    if ((wantsBreak || wantsLunch || wantsCover) && !target) {
      return { ok: true, answer: 'Which staff or student should I look up? Include the name and date, such as “Who covered Noah’s break on 5/23?”', contextSummary: { fastAnswer: true, route: 'history-needs-name' }, suggestedActions: [] };
    }

    const rows = getScheduleHistoryRowsV5_ ? getScheduleHistoryRowsV5_() : [];
    if (!rows.length) return { ok: true, answer: 'I could not find any saved historical schedules for the selected school.', contextSummary: { fastAnswer: true, route: 'history-empty' }, suggestedActions: [] };

    const matches = [];
    rows.forEach(function(r) {
      let views = null;
      try { views = JSON.parse(r.chunks || '{}') || {}; } catch (e) { views = null; }
      if (!views) return;
      if (dateParts && !coverageCoachHistoryRowMatchesDateV5354_(r, views, dateParts)) return;
      const found = findCoverageCoachBreakCoverageMatchesV5354_(views, target, { wantsBreak: wantsBreak, wantsLunch: wantsLunch, wantsCover: wantsCover });
      found.forEach(function(x) {
        x.historyId = r.id;
        x.historyStamp = r.publishedAt || '';
        x.scheduleDate = views.date || '';
        x.scheduleType = views.scheduleType || '';
        matches.push(x);
      });
    });

    const dateLabel = dateParts ? (dateParts.month + '/' + dateParts.day + (dateParts.year ? '/' + String(dateParts.year).slice(-2) : '')) : 'that date';
    if (!matches.length) {
      const who = target ? target : 'that person';
      const item = wantsLunch ? 'lunch coverage' : (wantsBreak ? 'break coverage' : 'break/lunch coverage');
      return { ok: true, answer: 'I could not find ' + item + ' for ' + who + ' on ' + dateLabel + ' in the saved historical schedules for the selected school.', contextSummary: { fastAnswer: true, route: 'history-no-match', date: dateLabel, target: target }, suggestedActions: [] };
    }

    const unique = [];
    const seen = {};
    matches.forEach(function(m) {
      const key = [m.time, m.type, m.staffOnBreak, m.coveringStaff, m.helperStaff, m.students, m.scheduleType, m.scheduleDate, m.historyStamp].map(function(x){ return String(x || '').toLowerCase(); }).join('|');
      if (seen[key]) return;
      seen[key] = true;
      unique.push(m);
    });

    const limited = unique.slice(0, 8);
    const lines = limited.map(function(m) {
      const cover = clean_(m.coveringStaff || m.helperStaff || 'No covering staff listed');
      const parts = [];
      if (m.time) parts.push(m.time);
      if (m.type) parts.push(m.type);
      if (m.students && normalizeName_(m.students).indexOf(normalizeName_(target)) >= 0) parts.push('students/location: ' + m.students + (m.location ? ' @ ' + m.location : ''));
      if (m.staffOnBreak) parts.push('staff on break: ' + m.staffOnBreak);
      if (m.scheduleType) parts.push('schedule: ' + m.scheduleType);
      return cover + (parts.length ? ' (' + parts.join(' · ') + ')' : '');
    });

    const noun = wantsLunch ? 'lunch' : (wantsBreak ? 'break' : 'break/lunch');
    let answer = '';
    if (limited.length === 1) answer = (target ? target + '’s ' : 'The ') + noun + ' coverage on ' + dateLabel + ' was covered by ' + lines[0] + '.';
    else answer = 'I found ' + limited.length + ' matching ' + noun + ' coverage records for ' + (target || 'that search') + ' on ' + dateLabel + ':\n• ' + lines.join('\n• ');
    if (unique.length > limited.length) answer += '\nShowing the first ' + limited.length + ' matches.';
    return { ok: true, answer: answer, contextSummary: { fastAnswer: true, route: 'history-break-coverage', matches: unique.length }, suggestedActions: [] };
  } catch (err) {
    return { ok: true, answer: 'I could not complete the historical schedule lookup: ' + ((err && err.message) || err || 'Unknown error'), contextSummary: { fastAnswer: true, route: 'history-error' }, suggestedActions: [] };
  }
}

function extractCoverageCoachDatePartsV5354_(text) {
  text = String(text || '');
  let m = text.match(/\b(\d{1,2})[\/\-](\d{1,2})(?:[\/\-](\d{2,4}))?\b/);
  if (m) {
    let y = m[3] ? Number(m[3]) : null;
    if (y && y < 100) y += 2000;
    return { month: Number(m[1]), day: Number(m[2]), year: y };
  }
  const months = { january:1, jan:1, february:2, feb:2, march:3, mar:3, april:4, apr:4, may:5, june:6, jun:6, july:7, jul:7, august:8, aug:8, september:9, sep:9, sept:9, october:10, oct:10, november:11, nov:11, december:12, dec:12 };
  m = text.toLowerCase().match(/\b(january|jan|february|feb|march|mar|april|apr|may|june|jun|july|jul|august|aug|september|sep|sept|october|oct|november|nov|december|dec)\s+(\d{1,2})(?:,?\s+(\d{2,4}))?\b/);
  if (m) {
    let y = m[3] ? Number(m[3]) : null;
    if (y && y < 100) y += 2000;
    return { month: months[m[1]], day: Number(m[2]), year: y };
  }
  return null;
}

function extractCoverageCoachPersonForBreakLookupV5354_(text) {
  text = String(text || '').replace(/[“”]/g, '"').replace(/[’]/g, "'").trim();
  let m = text.match(/(?:who\s+)?(?:covered|covering|covers|cover)\s+(.+?)'s\s+(?:break|lunch)\b/i);
  if (m) return cleanCoverageCoachLookupNameV5354_(m[1]);
  m = text.match(/\b([A-Z][A-Za-z0-9 ._'-]{1,60}?)'s\s+(?:break|lunch)\b/);
  if (m) return cleanCoverageCoachLookupNameV5354_(m[1]);
  m = text.match(/(?:for|with|about)\s+([A-Za-z][A-Za-z0-9 ._'-]{1,60}?)(?:\s+on\s+|\s+during\s+|\s+break|\s+lunch|\?|$)/i);
  if (m) return cleanCoverageCoachLookupNameV5354_(m[1]);
  return '';
}

function cleanCoverageCoachLookupNameV5354_(s) {
  return clean_(String(s || '').replace(/\b(the|a|an|staff|student|person|member)\b/gi, ' ').replace(/\s+/g, ' '));
}

function coverageCoachHistoryRowMatchesDateV5354_(row, views, dateParts) {
  const candidates = [views && views.date, row && row.publishedAt, views && views.publishedAt, views && views.scheduleDate].filter(Boolean);
  for (let i = 0; i < candidates.length; i++) {
    const d = parseCoverageCoachLooseDateV5354_(candidates[i]);
    if (!d) continue;
    if (d.month === dateParts.month && d.day === dateParts.day && (!dateParts.year || d.year === dateParts.year)) return true;
  }
  return false;
}

function parseCoverageCoachLooseDateV5354_(v) {
  const text = String(v || '');
  const m = text.match(/\b(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})\b/);
  if (m) {
    let y = Number(m[3]);
    if (y < 100) y += 2000;
    return { month: Number(m[1]), day: Number(m[2]), year: y };
  }
  const m2 = text.match(/\b(\d{1,2})[\/\-](\d{1,2})\b/);
  if (m2) return { month: Number(m2[1]), day: Number(m2[2]), year: null };
  return null;
}

function findCoverageCoachBreakCoverageMatchesV5354_(views, target, opts) {
  opts = opts || {};
  const targetNorm = normalizeName_(target || '');
  const out = [];
  const rows = (views && views.breakItems) || [];
  rows.forEach(function(b) {
    b = b || {};
    const type = clean_(b.type || b.kind || '');
    const typeNorm = type.toLowerCase();
    if (opts.wantsBreak && typeNorm.indexOf('lunch') >= 0 && typeNorm.indexOf('break') < 0) return;
    if (opts.wantsLunch && typeNorm.indexOf('lunch') < 0) return;
    const hay = [b.staffOnBreak, b.coveringStaff, b.helperStaff, b.helperCoveringFor, b.students, b.location, b.time, b.type].map(function(x){return String(x || '');}).join(' ');
    if (targetNorm && normalizeName_(hay).indexOf(targetNorm) < 0) return;
    out.push({
      type: type || '',
      time: b.time || ((b.startMinutes != null && b.endMinutes != null && typeof formatMinutes_ === 'function') ? formatMinutes_(b.startMinutes) + ' - ' + formatMinutes_(b.endMinutes) : ''),
      staffOnBreak: clean_(b.staffOnBreak || b.breakStaff || b.staff || ''),
      coveringStaff: clean_(b.coveringStaff || b.coverStaff || b.cover || ''),
      helperStaff: clean_(b.helperStaff || ''),
      helperCoveringFor: clean_(b.helperCoveringFor || ''),
      students: clean_(Array.isArray(b.students) ? b.students.map(function(s){ return s && (s.name || s.student || s); }).join(', ') : (b.students || b.student || '')),
      location: clean_(b.location || b.room || '')
    });
  });
  return out;
}


function answerCoverageCoachBellTimeQuestionV5352_(question, payload) {
  try {
    const data = getScheduleBuilderDataV5();
    const schedules = data && data.schedules ? data.schedules : [];
    if (!schedules.length) return { ok: true, answer: 'I could not find any saved bell schedule templates for the selected school.', contextSummary: { fastAnswer: true, route: 'bell-time' }, suggestedActions: [] };
    const schedule = findCoverageCoachScheduleForQuestionV5352_(question, schedules, payload && payload.selectedSchedule);
    if (!schedule) {
      return { ok: true, answer: 'Which bell schedule should I check? I found: ' + schedules.map(function(s) { return s.name; }).slice(0, 12).join(', ') + '.', contextSummary: { fastAnswer: true, route: 'bell-time', needsSchedule: true }, suggestedActions: [] };
    }
    const target = findCoverageCoachBellItemsForQuestionV5352_(question, schedule.rows || []);
    if (!target.length) {
      return { ok: true, answer: 'I found the schedule “' + schedule.name + ',” but I could not match the requested item. Active items with times are: ' + (schedule.rows || []).filter(function(r) { return r.active && (r.start || r.end); }).map(function(r) { return getPeriodDisplayNameV5142_(r.item) + ' (' + (r.start || '?') + ' - ' + (r.end || '?') + ')'; }).join('; ') + '.', contextSummary: { fastAnswer: true, route: 'bell-time', schedule: schedule.name }, suggestedActions: [] };
    }
    const lines = target.map(function(r) {
      return getPeriodDisplayNameV5142_(r.item) + ': ' + ((r.start || '?') + ' - ' + (r.end || '?'));
    });
    return { ok: true, answer: 'On ' + schedule.name + ', ' + (lines.length === 1 ? lines[0] + '.' : 'these are the matching times:\n• ' + lines.join('\n• ')), contextSummary: { fastAnswer: true, route: 'bell-time', schedule: schedule.name, itemCount: target.length }, suggestedActions: [] };
  } catch (e) {
    return { ok: true, answer: 'I tried a fast bell-schedule lookup, but the schedule data could not be read: ' + String(e && e.message || e), contextSummary: { fastAnswer: true, route: 'bell-time-error' }, suggestedActions: [] };
  }
}

function findCoverageCoachScheduleForQuestionV5352_(question, schedules, selectedSchedule) {
  const qn = normalizeName_(question || '');
  const sorted = (schedules || []).slice().sort(function(a, b) { return String(b.name || '').length - String(a.name || '').length; });
  for (let i = 0; i < sorted.length; i++) {
    const name = clean_(sorted[i].name || '');
    const n = normalizeName_(name);
    if (n && qn.indexOf(n) >= 0) return sorted[i];
    const alt = alternateCoverageCoachDayNameV5352_(name);
    if (alt && qn.indexOf(normalizeName_(alt)) >= 0) return sorted[i];
  }
  const selected = clean_(selectedSchedule || '');
  if (selected) {
    const k = normalizeName_(selected);
    const match = sorted.filter(function(s) { return normalizeName_(s.name) === k; })[0];
    if (match) return match;
  }
  if (sorted.length === 1) return sorted[0];
