function offCampusSitesForModelV5150_(model) {
  if (model && Array.isArray(model.offCampusSites)) return model.offCampusSites;
  return getOffCampusSitesV5131_ ? getOffCampusSitesV5131_() : [];
}

function offCampusSiteForLocationV5150_(model, location) {
  const key = normalizeLocation_(location || '');
  if (!key) return null;
  const sites = offCampusSitesForModelV5150_(model);
  for (let i = 0; i < sites.length; i++) {
    const site = sites[i] || {};
    if (normalizeLocation_(site.name || '') === key) return site;
  }
  return null;
}

function isOffCampusLocationV5150_(model, location) {
  return !!offCampusSiteForLocationV5150_(model, location);
}

function offCampusGroupKeyV5150_(site) {
  site = site || {};
  return normalizeName_(site.group || site.name || '');
}

function offCampusBufferMinutesV5150_(site) {
  return Math.max(0, Number(site && site.bufferMinutes || 0) || 0);
}

function offCampusLocationsCanShareCoverageV5150_(model, a, b) {
  const siteA = offCampusSiteForLocationV5150_(model, a);
  const siteB = offCampusSiteForLocationV5150_(model, b);
  if (!siteA || !siteB) return false;
  if (normalizeLocation_(siteA.name || '') === normalizeLocation_(siteB.name || '')) return true;
  const groupA = offCampusGroupKeyV5150_(siteA);
  const groupB = offCampusGroupKeyV5150_(siteB);
  return !!groupA && groupA === groupB;
}

function getStaffOffCampusIntervalsV5150_(model, assignments, staffName, ignorePeriodLabel) {
  const intervals = [];
  if (!assignments || !assignments.byPeriod || !model || !model.schedule) return intervals;
  const staffKey = normalizeName_(staffName || '');
  (model.schedule.assignmentItems || []).forEach(function(item) {
    if (!item || !item.label) return;
    if (ignorePeriodLabel && normalizeName_(item.label) === normalizeName_(ignorePeriodLabel)) return;
    const pr = assignments.byPeriod.get(item.label);
    if (!pr || !pr.staffAssignments) return;
    let assignment = pr.staffAssignments.get(staffName) || null;
    if (!assignment && staffKey) {
      pr.staffAssignments.forEach(function(a, nm) { if (!assignment && normalizeName_(nm) === staffKey) assignment = a; });
    }
    if (!assignment) return;
    const site = offCampusSiteForLocationV5150_(model, assignment.location || '');
    if (!site) return;
    if (item.startMinutes == null || item.endMinutes == null) return;
    const buffer = offCampusBufferMinutesV5150_(site);
    intervals.push({
      start: item.startMinutes - buffer,
      end: item.endMinutes + buffer,
      period: item.label,
      location: assignment.location,
      group: site.group || '',
      buffer: buffer
    });
  });
  return intervals;
}

function hasStaffOffCampusBufferConflictV5150_(model, assignments, staffName, start, end, ignorePeriodLabel) {
  return getStaffOffCampusIntervalsV5150_(model, assignments, staffName, ignorePeriodLabel).some(function(interval) {
    return rangesOverlap_(start, end, interval.start, interval.end);
  });
}

function assignmentContainsIndividualV5150_(assignment) {
  if (!assignment) return false;
  if (assignment.containsIndividual) return true;
  return (assignment.needs || []).some(function(n) { return n && (n.support === 'INDIVIDUAL' || n.support === 'INDIVIDUAL_STAR'); });
}

function canStaffCoverCombinedOffCampusAssignmentsV5150_(model, staff, item, breakerAssignment, candidateAssignment) {
  if (!breakerAssignment || !candidateAssignment) return false;
  if (!offCampusLocationsCanShareCoverageV5150_(model, breakerAssignment.location, candidateAssignment.location)) return false;
  if (assignmentContainsIndividualV5150_(breakerAssignment) || assignmentContainsIndividualV5150_(candidateAssignment)) return false;
  const combined = (candidateAssignment.needs || []).concat(breakerAssignment.needs || []);
  if (!combined.length) return false;
  if (combined.some(function(n) { return !n || n.support !== 'GROUP'; })) return false;
  if (combined.length > getMaxGroupSizeForNeeds_(model, item, combined)) return false;
  for (let i = 0; i < combined.length; i++) {
    const need = combined[i];
    if (staff.blockedRooms && staff.blockedRooms.has(normalizeLocation_(need.location))) return false;
    if (!(item.type === 'lunch' && !model.config.lunchConformsToBlocking) && staff.blockedStudents && staff.blockedStudents.has(normalizeName_(need.student.name))) return false;
    if (!isStaffSupportTypeEligibleForNeedV51228_(model, need, staff)) return false;
  }
  return true;
}

