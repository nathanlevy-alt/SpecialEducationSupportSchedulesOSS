function getStudentDataUpdateAlertsV5_(students, daysStale) {
  const today = new Date();
  today.setHours(0,0,0,0);
  const rows = [];
  students.forEach(function(stu) {
    if (!stu.name || stu.absent) return;
    const url = clean_(stu.publishedDataUrl || stu.dataFiles || '');
    if (!url) return;
    const raw = stu.dataFilesLastUpdated;
    const dt = parseLooseDateV5_(raw);
    if (!dt) {
      rows.push({student: stu.name, url: url, lastUpdated: String(raw || ''), days: '', note: 'No update date found'});
      return;
    }
    const d0 = new Date(dt); d0.setHours(0,0,0,0);
    const days = Math.floor((today.getTime() - d0.getTime()) / 86400000);
    if (days >= daysStale) rows.push({student: stu.name, url: url, lastUpdated: formatDate_(dt), days: days, note: 'Older than threshold'});
  });
  rows.sort(function(a,b){return (b.days || 9999) - (a.days || 9999);});
  return rows;
}

function parseLooseDateV5_(value) {
  if (!value) return null;
  if (value instanceof Date && !isNaN(value.getTime())) return value;
  const s = String(value).trim();
  if (!s) return null;
  const d = new Date(s);
  if (!isNaN(d.getTime())) return d;
  return null;
}


