// remembered, and discovery results are still validated with FormApp before display.
// =====================================================================================

const V5_DATA_FILE_LIBRARY_PROP_V5210_ = 'V5_DATA_FILE_LIBRARY_V5210';
const V5_DATA_FILE_LIBRARY_LIMIT_V5210_ = 250;

function readDataFileLibraryV5210_() {
  try {
    const raw = getDocumentPropertiesV650_().getProperty(V5_DATA_FILE_LIBRARY_PROP_V5210_);
    const arr = raw ? JSON.parse(raw) : [];
    return Array.isArray(arr) ? arr : [];
  } catch (err) {
    return [];
  }
}

function writeDataFileLibraryV5210_(arr) {
  const cleaned = [];
  const seen = {};
  (Array.isArray(arr) ? arr : []).forEach(function(entry) {
    const id = String(entry && entry.id || '').trim();
    const url = String(entry && entry.url || '').trim();
    const key = id || url;
    if (!key || seen[key]) return;
    seen[key] = true;
    cleaned.push({
      id: id,
      name: String(entry && entry.name || '').trim(),
      url: url,
      publishedUrl: String(entry && entry.publishedUrl || '').trim(),
      updated: String(entry && entry.updated || '').trim(),
      source: String(entry && entry.source || 'Saved DATA_FILE').trim()
    });
  });
  getDocumentPropertiesV650_().setProperty(V5_DATA_FILE_LIBRARY_PROP_V5210_, JSON.stringify(cleaned.slice(0, V5_DATA_FILE_LIBRARY_LIMIT_V5210_)));
}

function rememberDataFileFormV5210_(payload, source) {
  if (!payload || !payload.ok) return payload;
  const id = String(payload.id || '').trim();
  const url = String(payload.url || '').trim();
  const name = String(payload.name || '').trim();
  if (!id && !url) return payload;
  const now = Utilities.formatDate(new Date(), 'America/Los_Angeles', 'M/d/yyyy h:mm a');
  const lib = readDataFileLibraryV5210_();
  const key = id || url;
  let found = false;
  for (let i = 0; i < lib.length; i++) {
    const existingKey = String(lib[i].id || lib[i].url || '').trim();
    if (existingKey === key) {
      lib[i] = {
        id: id,
        name: name || lib[i].name || 'Untitled DATA_FILE form',
        url: url || lib[i].url || '',
        publishedUrl: String(payload.publishedUrl || lib[i].publishedUrl || '').trim(),
        updated: now,
        source: source || lib[i].source || 'Saved DATA_FILE'
      };
      found = true;
      break;
    }
  }
  if (!found) {
    lib.unshift({
      id: id,
      name: name || 'Untitled DATA_FILE form',
      url: url,
      publishedUrl: String(payload.publishedUrl || '').trim(),
      updated: now,
      source: source || 'Saved DATA_FILE'
    });
  }
  writeDataFileLibraryV5210_(lib);
  return payload;
}


