}

function serializeCampusScopedPropertiesV5263_(map) {
  const rows = [];
  const stamp = Utilities.formatDate(new Date(), 'America/Los_Angeles', 'M/d/yyyy h:mm:ss a');
  Object.keys(map || {}).sort().forEach(function(key) {
    const value = String(map[key] == null ? '' : map[key]);
    if (value.length > V5263_CHUNK_SIZE) {
      const chunks = [];
      for (let i = 0; i < value.length; i += V5263_CHUNK_SIZE) chunks.push(value.substring(i, i + V5263_CHUNK_SIZE));
      rows.push([key, V5263_CHUNK_PREFIX + chunks.length, stamp]);
      chunks.forEach(function(chunk, idx) {
        rows.push([key + V5263_CHUNK_MARK + ('0000' + idx).slice(-4), chunk, stamp]);
      });
    } else {
      rows.push([key, value, stamp]);
    }
  });
  return rows;
}

