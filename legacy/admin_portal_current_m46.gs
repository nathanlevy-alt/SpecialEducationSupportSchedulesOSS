// V5.1.42 Attendance Manager
function attendanceReasonCodeV5162_(reason) {
  const s = String(reason || '').trim();
  if (!s) return 'A';
  const prefix = s.match(/^([A-Za-z]{1,2})\s*=/);
  if (prefix) return prefix[1].toUpperCase();
  const norm = s.toLowerCase();
  if (norm.indexOf('bereavement') >= 0) return 'B';
  if (norm.indexOf('jury') >= 0) return 'J';
  if (norm.indexOf('vacation') >= 0) return 'V';
  if (norm.indexOf('illness') >= 0 || norm.indexOf('sick') >= 0) return 'I';
  if (norm.indexOf('personal necessity') >= 0) return 'PN';
  if (norm.indexOf('personal reason') >= 0) return 'P';
  return 'A';
}

function getAttendanceManagerDataV542(payload) {
  payload = payload || {};
  const ss = getActiveSpreadsheetV5_();
  const monthKey = clean_(payload.month) || Utilities.formatDate(new Date(), 'America/Los_Angeles', 'yyyy-MM');
  const staffFilter = clean_(payload.staff);
  const staff = getActiveStaffNamesForAttendanceV542_(ss);
  const days = getWorkdaysForMonthV542_(monthKey);
  const records = getAttendanceRecordsV542_(ss, monthKey);
  const workdayCache = {};
  const byStaff = {};
  staff.forEach(function(n){ byStaff[n] = {}; });
  records.forEach(function(r) {
    if (!byStaff[r.name]) return;
    const key = r.startKey;
    if (!key) return;
    let value = '';
    const code = attendanceReasonCodeV5162_(r.reason) || 'A';
    if (/partial/i.test(r.dayPart || '')) {
      const hours = computePartialAbsenceHoursV542_(ss, r, workdayCache);
      value = hours ? (code + '-' + formatHoursV542_(hours)) : code;
    } else {
      value = code;
    }
    byStaff[r.name][key] = byStaff[r.name][key] ? byStaff[r.name][key] + ', ' + value : value;
  });
  const rows = staff.map(function(n){ return {staff:n, cells:byStaff[n] || {}}; });
  const monthDate = parseIsoDateOnlyV5_(monthKey + '-01') || new Date();
  return {
    month: monthKey,
    monthLabel: Utilities.formatDate(monthDate, 'America/Los_Angeles', 'MMMM yyyy'),
    days: days,
    staff: staff,
    rows: rows,
    records: staffFilter ? records.filter(function(r){return normalizeName_(r.name) === normalizeName_(staffFilter);}) : records
  };
}

function getActiveStaffNamesForAttendanceV542_(ss) {
  const sh = ss.getSheetByName(V5.SHEETS.STAFF);
  if (!sh || sh.getLastRow() < 2) return [];
  const values = sh.getDataRange().getValues();
  const display = sh.getDataRange().getDisplayValues();
  const headers = getHeaderMap_(sh);
  const nameCol = findHeaderCol_(headers, ['name','staff name'], 1);
  const statusCol = findHeaderCol_(headers, ['status'], 9);
  const seen = {};
  const names = [];
  for (let i = 1; i < values.length; i++) {
    const name = clean_(display[i][nameCol - 1] || values[i][nameCol - 1]);
    if (!name) continue;
    const status = clean_(display[i][statusCol - 1] || values[i][statusCol - 1]);
    if (!isActiveOrBlankStatusForOut_({status: status})) continue;
    const key = normalizeName_(name);
    if (!seen[key]) { seen[key] = true; names.push(name); }
  }
  names.sort(function(a,b){return String(a).localeCompare(String(b));});
  return names;
}

function getWorkdaysForMonthV542_(monthKey) {
  const m = String(monthKey || '').match(/^(\d{4})-(\d{2})$/);
  const now = new Date();
  const y = m ? Number(m[1]) : now.getFullYear();
  const mo = m ? Number(m[2]) - 1 : now.getMonth();
  const days = [];
  for (let d = new Date(y, mo, 1); d.getMonth() === mo; d.setDate(d.getDate() + 1)) {
    const dow = d.getDay();
    if (dow === 0 || dow === 6) continue;
    const copy = new Date(d.getFullYear(), d.getMonth(), d.getDate());
    days.push({day: copy.getDate(), key: dateKeyV5_(copy)});
  }
  return days;
}

function getAttendanceRecordsV542_(ss, monthKey) {
  const sh = ensureAttendanceHeadersV5_(ss);
  if (!sh || sh.getLastRow() < 2) return [];
  const values = sh.getDataRange().getValues();
  const display = sh.getDataRange().getDisplayValues();
  const headers = getHeaderMap_(sh);
  const cols = {
    timestamp: findHeaderCol_(headers, ['timestamp'], 1),
    name: findHeaderCol_(headers, ['name'], 2),
    source: findHeaderCol_(headers, ['source'], 3),
    startDate: findHeaderCol_(headers, ['start date'], 4),
    endDate: findHeaderCol_(headers, ['end date'], 5),
    reason: findHeaderCol_(headers, ['reason'], 6),
    dayPart: findHeaderCol_(headers, ['day part'], 7),
    arrival: findHeaderCol_(headers, ['arrival time'], 8),
    leave: findHeaderCol_(headers, ['leave time'], 9),
    notes: findHeaderCol_(headers, ['notes'], 10),
    status: findHeaderCol_(headers, ['status'], 11)
  };
  const out = [];
  for (let i = 1; i < values.length; i++) {
    const name = clean_(display[i][cols.name - 1] || values[i][cols.name - 1]);
    if (!name) continue;
    const start = parseAttendanceDateValueV5_(values[i][cols.startDate - 1], display[i][cols.startDate - 1]);
    if (!start) continue;
    const key = dateKeyV5_(start);
    if (monthKey && key.indexOf(monthKey) !== 0) continue;
    const arrivalRaw = values[i][cols.arrival - 1] || display[i][cols.arrival - 1];
    const leaveRaw = values[i][cols.leave - 1] || display[i][cols.leave - 1];
    out.push({
      rowIndex: i + 1,
      name: name,
      startKey: key,
      startDate: display[i][cols.startDate - 1] || formatDate_(start),
      reason: clean_(display[i][cols.reason - 1] || values[i][cols.reason - 1]),
      reasonCode: attendanceReasonCodeV5162_(display[i][cols.reason - 1] || values[i][cols.reason - 1]),
      dayPart: clean_(display[i][cols.dayPart - 1] || values[i][cols.dayPart - 1]) || 'Full day',
      arrival: clean_(display[i][cols.arrival - 1] || values[i][cols.arrival - 1]),
      leave: clean_(display[i][cols.leave - 1] || values[i][cols.leave - 1]),
      arrival24: minutesToHtmlTimeV542_(parseTimeToMinutes_(arrivalRaw)),
      leave24: minutesToHtmlTimeV542_(parseTimeToMinutes_(leaveRaw)),
      notes: clean_(display[i][cols.notes - 1] || values[i][cols.notes - 1]),
      status: clean_(display[i][cols.status - 1] || values[i][cols.status - 1])
    });
  }
  out.sort(function(a,b){return a.startKey.localeCompare(b.startKey) || a.name.localeCompare(b.name);});
  return out;
}

function computePartialAbsenceHoursV542_(ss, rec, cache) {
  const key = rec.startKey;
  if (!key) return 0;
  if (!cache[key]) cache[key] = getWorkdayWindowForDateV5_(ss, parseIsoDateOnlyV5_(key));
  const win = cache[key] || {};
  const start = win.startMinutes, end = win.endMinutes;
  if (start == null || end == null || end <= start) return 0;
  const arr = parseTimeToMinutes_(rec.arrival24 || rec.arrival);
  const leave = parseTimeToMinutes_(rec.leave24 || rec.leave);
  let missed = 0;
  if (arr != null && arr > start) missed += Math.max(0, Math.min(arr, end) - start);
  if (leave != null && leave < end) missed += Math.max(0, end - Math.max(leave, start));
  if (missed < 0) missed = 0;
  return missed / 60;
}

function formatHoursV542_(hours) {
  const rounded = Math.round(Number(hours || 0) * 10) / 10;
  return Math.abs(rounded - Math.round(rounded)) < 0.001 ? String(Math.round(rounded)) : rounded.toFixed(1);
}

function minutesToHtmlTimeV542_(m) {
  if (m == null || isNaN(m)) return '';
  const h = Math.floor(m / 60), mm = m % 60;
  return ('0' + h).slice(-2) + ':' + ('0' + mm).slice(-2);
}

function saveAttendanceRecordV542(payload) {
  payload = payload || {};
  const ss = getActiveSpreadsheetV5_();
  const sh = ensureAttendanceHeadersV5_(ss);
  const headers = getHeaderMap_(sh);
  const cols = {
    timestamp: findHeaderCol_(headers, ['timestamp'], 1),
    name: findHeaderCol_(headers, ['name'], 2),
    source: findHeaderCol_(headers, ['source'], 3),
    startDate: findHeaderCol_(headers, ['start date'], 4),
    endDate: findHeaderCol_(headers, ['end date'], 5),
    reason: findHeaderCol_(headers, ['reason'], 6),
    dayPart: findHeaderCol_(headers, ['day part'], 7),
    arrival: findHeaderCol_(headers, ['arrival time'], 8),
    leave: findHeaderCol_(headers, ['leave time'], 9),
    notes: findHeaderCol_(headers, ['notes'], 10),
    status: findHeaderCol_(headers, ['status'], 11)
  };
  const date = parseIsoDateOnlyV5_(payload.date) || parseAttendanceDateValueV5_(payload.date, payload.date);
  if (!clean_(payload.staff) || !date) throw new Error('Staff and date are required.');
  const width = Math.max(sh.getLastColumn(), 11);
  const rowIndex = Number(payload.rowIndex || 0);
  const row = rowIndex > 1 ? sh.getRange(rowIndex, 1, 1, width).getValues()[0] : new Array(width).fill('');
  row[cols.timestamp - 1] = row[cols.timestamp - 1] || new Date();
  row[cols.name - 1] = clean_(payload.staff);
  row[cols.source - 1] = row[cols.source - 1] || 'Attendance Manager';
  row[cols.startDate - 1] = date;
  row[cols.endDate - 1] = '';
  row[cols.reason - 1] = clean_(payload.reason);
  row[cols.dayPart - 1] = clean_(payload.dayPart) || 'Full day';
  row[cols.arrival - 1] = clean_(payload.arrival);
  row[cols.leave - 1] = clean_(payload.leave);
  row[cols.notes - 1] = clean_(payload.notes);
  row[cols.status - 1] = row[cols.status - 1] || 'Submitted';
  if (rowIndex > 1 && rowIndex <= sh.getLastRow()) sh.getRange(rowIndex, 1, 1, width).setValues([row]);
  else sh.getRange(sh.getLastRow() + 1, 1, 1, width).setValues([row]);
  return {ok:true, message:'Attendance record saved.'};
