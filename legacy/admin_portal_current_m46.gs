function getConfigStudentNamesFromSheetV5_(sheet) {
  if (!sheet || sheet.getLastRow() < 2) return [];
  return sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).getDisplayValues().flat().map(clean_).filter(Boolean).sort(function(a,b){return a.localeCompare(b);});
}

function buildPriorityHoldOptionsV5_(periods, locations, lunchLocations) {
  const out = ['Coach'];
  const assignmentLocations = uniqueByNormalizedName_(locations || []);
  const lunchList = uniqueByNormalizedName_(lunchLocations || []);
  periods.forEach(function(p) {
    const periodLabel = canonicalPeriodLabel_(p) || p;
    if (!periodLabel) return;
    if (normalizeName_(periodLabel) === 'lunch') {
      lunchList.forEach(function(l) {
        if (l) out.push('Lunch @ ' + l);
      });
    } else if (normalizeName_(periodLabel) !== 'break') {
      assignmentLocations.forEach(function(l) {
        if (l) out.push(periodLabel + ' @ Room ' + l);
      });
    }
  });
  return uniqueByNormalizedName_(out);
}

function saveStaffFromManagerV5367_original_(payload) {
  const ss = getActiveSpreadsheetV5_();
  ensureCoreSheetsV5_(ss);
  const sheet = ss.getSheetByName(V5.SHEETS.STAFF);
  const headers = getHeaderMap_(sheet);
  const cols = {
    name: findHeaderCol_(headers, ['name'], 1), absent: findHeaderCol_(headers, ['absent today'], 2), timeBlocks: findHeaderCol_(headers, ['time blocks'], 3),
    blockedStudents: findHeaderCol_(headers, ['blocked student(s)', 'blocked students'], 4), blockedRooms: findHeaderCol_(headers, ['blocked room(s) #', 'blocked rooms #', 'blocked room(s)', 'blocked rooms'], 5),
    priorityHolds: findHeaderCol_(headers, ['priority holds'], 6), overtime: findHeaderCol_(headers, ['overtime interest'], 7), totalAbsences: findHeaderCol_(headers, ['total absences'], 8), status: findHeaderCol_(headers, ['status'], 9), supportStaffType: findHeaderCol_(headers, ['support staff type', 'staff support type', 'support type', 'staff type', 'staff classification', 'classification', 'position', 'role', 'job title', 'title'], 10)
  };
  const oldName = clean_(payload.oldName || '');
  const newName = clean_(payload.name || '');
  if (!newName) throw new Error('Staff name is required.');
  let rowIndex = Number(payload.rowIndex || 0);
  if (!rowIndex || rowIndex < 2) rowIndex = findStaffRowByNameV5_(sheet, oldName || newName);
  if (!rowIndex) rowIndex = Math.max(sheet.getLastRow() + 1, 2);

  const width = Math.max(cols.name, cols.absent, cols.timeBlocks, cols.blockedStudents, cols.blockedRooms, cols.priorityHolds, cols.overtime, cols.totalAbsences, cols.status, cols.supportStaffType, 10);
  const rowRange = sheet.getRange(rowIndex, 1, 1, width);
  const row = rowRange.getValues()[0];
  const display = rowRange.getDisplayValues()[0];
  const formulas = rowRange.getFormulas()[0];
  const previousAbsent = checkboxOrYes_(row[cols.absent - 1], display[cols.absent - 1]);
  const previousStatus = clean_(display[cols.status - 1] || row[cols.status - 1] || 'Active');

  row[cols.name - 1] = newName;
  row[cols.absent - 1] = !!payload.absent;
  row[cols.timeBlocks - 1] = clean_(payload.timeBlocks || '');
  row[cols.blockedStudents - 1] = uniqueByNormalizedName_(payload.blockedStudents || []).join(', ');
  row[cols.blockedRooms - 1] = uniqueByNormalizedName_(payload.blockedRooms || []).join(', ');
  row[cols.priorityHolds - 1] = uniqueByNormalizedName_(payload.priorityHolds || []).join(' / ');
  row[cols.overtime - 1] = clean_(payload.overtime || '');
  row[cols.status - 1] = clean_(payload.status || 'Active');
  row[cols.supportStaffType - 1] = displayStaffSupportTypeV51227_(payload.supportStaffType || '');
  if (formulas[cols.totalAbsences - 1]) row[cols.totalAbsences - 1] = formulas[cols.totalAbsences - 1];

  rowRange.setValues([row]);
  try { sheet.getRange(rowIndex, cols.absent).insertCheckboxes(); } catch (e) {}
  syncManualStaffAbsenceFromManagerV5_(ss, newName, !!payload.absent, previousAbsent);
  saveStaffRestPreferenceForNameV51246_(oldName, newName, payload || {});
  markValidationDirtyV51222_('staff manager saved');
  // V05422: real auto-revoke-on-status-change -- any transition away from Active (LOA,
  // inactive, terminated, etc.) invalidates this staff member's existing portal/app
  // QR codes and links and clears their passcode. Reactivating them later requires a
  // fresh link/letter, which is the intended behavior, not an oversight.
  const newStatusClean = clean_(payload.status || 'Active');
  const wasActive = String(previousStatus).trim().toLowerCase() === 'active';
  const isActiveNow = String(newStatusClean).trim().toLowerCase() === 'active';
  if (wasActive && !isActiveNow) {
    try { bumpStaffTokenVersionV05421_(getSelectedCampusIdV5312_(), newName); } catch (e) {}
    try { clearStaffPasscodeV05422_(getSelectedCampusIdV5312_(), newName); } catch (e) {}
  }
  return { ok: true, rowIndex: rowIndex, name: newName, message: 'Saved ' + newName + '. Validation helpers will refresh only when needed.' };
}



