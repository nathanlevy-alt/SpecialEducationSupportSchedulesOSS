  function periodDisplayTextForOptimizerV5160(value){
    var text=String(value||'');
    if(!text)return '';
    function labelFor(p){
      try{return periodDisplayNameV5140(p)||p;}catch(e){return p;}
    }
    // Replace longer period numbers first so Period 10 does not partially match Period 1.
    for(var n=30;n>=1;n--){
      var key='Period '+n;
      var label=labelFor(key);
      if(label && label!==key){
        text=text.split(key).join(label);
      }
    }
    return text;
  }
