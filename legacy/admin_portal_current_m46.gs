function staffNameSimilarityV5288_(a, b) {
  a = normalizeName_(a || ''); b = normalizeName_(b || '');
  if (!a || !b) return 0;
  if (a === b) return 1;
  if ((a.length >= 5 && b.indexOf(a) >= 0) || (b.length >= 5 && a.indexOf(b) >= 0)) return 0.86;
  const at = new Set(a.split(' ').filter(Boolean));
  const bt = new Set(b.split(' ').filter(Boolean));
  let hit = 0;
  at.forEach(function(t){ if (bt.has(t)) hit++; });
  const denom = Math.max(at.size, bt.size, 1);
  return hit / denom;
}

function inferSubmittedStaffV5288_(formResponse, staffNames) {
  const responses = (formResponse && formResponse.getItemResponses && formResponse.getItemResponses()) || [];
  const candidates = [];
  responses.forEach(function(ir) {
    const title = clean_(ir.getItem && ir.getItem() && ir.getItem().getTitle && ir.getItem().getTitle());
    let ans = ir.getResponse && ir.getResponse();
    if (Array.isArray(ans)) ans = ans.join(' ');
    ans = clean_(ans);
    if (!ans) return;
    const lowerTitle = normalizeName_(title);
    const titleWeight = /staff|employee|submitted|submitter|provider|observer|aide|assistant|interventionist|teacher|name/.test(lowerTitle) ? 1 : 0;
    candidates.push({ title: title, answer: ans, titleWeight: titleWeight });
  });
  let best = { submittedStaffName: '', matchedStaff: '', matchConfidence: 'unknown', score: 0 };
  candidates.forEach(function(c) {
    staffNames.forEach(function(staff) {
      const sim = staffNameSimilarityV5288_(c.answer, staff);
      const score = sim + (c.titleWeight ? 0.05 : 0);
      if (score > best.score) {
        best = { submittedStaffName: c.answer, matchedStaff: staff, matchConfidence: sim >= 1 ? 'exact' : (sim >= 0.67 ? 'similar' : 'unknown'), score: score };
      }
    });
  });
  if (best.score < 0.67) {
    const fallback = candidates.find(function(c){ return c.titleWeight; }) || candidates[0];
    return { submittedStaffName: fallback ? fallback.answer : '', matchedStaff: '', matchConfidence: 'unknown' };
  }
  return { submittedStaffName: best.submittedStaffName, matchedStaff: best.matchedStaff, matchConfidence: best.matchConfidence };
}


function formatDateMmDdYyV5305_(dateObj, includeTime) {
  if (!(dateObj instanceof Date)) return '';
  const tz = 'America/Los_Angeles';
  const iso = Utilities.formatDate(dateObj, tz, 'yyyy-MM-dd');
  const parts = String(iso || '').split('-');
  if (parts.length !== 3) return String(iso || '');
  let out = parts[1] + '/' + parts[2] + '/' + String(parts[0]).slice(2);
  if (includeTime) out += ' ' + Utilities.formatDate(dateObj, tz, 'h:mm a');
  return out;
}

function formatIsoDateMmDdYyV5305_(isoValue) {
  const s = String(isoValue || '').trim();
  const m = s.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!m) return s;
  return m[2] + '/' + m[3] + '/' + m[1].slice(2);
}

function getStudentDataPointDetailsV5288(payload) {
  payload = payload || {};
  const ss = getActiveSpreadsheetV5_();
  const sh = ss.getSheetByName(V5.SHEETS.STUDENTS);
  if (!sh) return { ok:false, rows:[], message:'Students sheet not found.' };
  const headers = getHeaderMap_(sh);
  const nameCol = findHeaderCol_(headers, ['name'], 1);
  const linkCol = findHeaderCol_(headers, ['data files'], 37);
  let rowIndex = Number(payload.rowIndex || 0);
  if (!rowIndex && payload.studentName) {
    const vals = sh.getRange(2, nameCol, Math.max(0, sh.getLastRow()-1), 1).getDisplayValues();
    for (let i=0;i<vals.length;i++) if (normalizeName_(vals[i][0]) === normalizeName_(payload.studentName)) { rowIndex = i + 2; break; }
  }
  if (!rowIndex || rowIndex < 2 || rowIndex > sh.getLastRow()) return { ok:false, rows:[], message:'Student row was not found.' };
  const studentName = clean_(sh.getRange(rowIndex, nameCol).getDisplayValue());
  const url = clean_(sh.getRange(rowIndex, linkCol).getDisplayValue());
  if (!url || !/docs\.google\.com\/forms/i.test(url)) return { ok:true, studentName:studentName, rows:[], schoolYearStartDate:getSchoolYearStartDateV5288_(), message:'No Google Form data file was found for this student.' };
  const staffNames = getStaffNamesV5288_(ss);
