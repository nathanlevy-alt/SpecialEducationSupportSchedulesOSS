  createdUserProps.setProperty('V5_SELECTED_CAMPUS_SPREADSHEET_ID', newSs.getId());
  createdUserProps.setProperty('V5_SELECTED_CAMPUS_NAME', campusName);
  try { invalidateV5RuntimeCachesV51222_(); } catch (e) {}
