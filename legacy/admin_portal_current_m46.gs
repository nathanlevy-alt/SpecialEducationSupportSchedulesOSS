  const sheet = ss.getSheetByName(V5.SHEETS.ATTENDANCE);
  const out = {};
  if (!sheet || sheet.getLastRow() < 2) return out;
  const headers = getHeaderMap_(sheet);
  const colTimestamp = findHeaderCol_(headers, ['timestamp'], 1);
  const colName = findHeaderCol_(headers, ['name'], 2);
  const colSource = findHeaderCol_(headers, ['source'], 3);
  const colStart = findHeaderCol_(headers, ['start date', 'absence date', 'date'], 4);
  const colEnd = findHeaderCol_(headers, ['end date', 'last day absent', 'last day'], 5);
  const colDayPart = findHeaderCol_(headers, ['day part', 'absence length', 'absence details'], 7);
  const colArrival = findHeaderCol_(headers, ['arrival time'], 8);
  const colLeave = findHeaderCol_(headers, ['leave time'], 9);
  const values = sheet.getDataRange().getValues();
  const display = sheet.getDataRange().getDisplayValues();
  const targetKey = dateKeyV5_(parseAttendanceDateValueV5_(date, date) || date);
  for (let r = 1; r < values.length; r++) {
    const name = clean_(display[r][colName - 1] || values[r][colName - 1]);
    if (!name) continue;
    if (!attendanceRowMatchesDateV5_(targetKey, values[r][colStart - 1], display[r][colStart - 1], values[r][colEnd - 1], display[r][colEnd - 1])) continue;
    const key = normalizeName_(name);
    if (!out[key]) out[key] = {fullDay:false, timeBlocks:[], notes:[], partialAbsenceWindows:[]};
    const dayPart = clean_(display[r][colDayPart - 1] || values[r][colDayPart - 1]).toLowerCase();
    if (dayPart.indexOf('partial') >= 0) {
      const arrival = display[r][colArrival - 1] || values[r][colArrival - 1];
      const leave = display[r][colLeave - 1] || values[r][colLeave - 1];
      const arrivalText = formatAttendanceTimeForRuleV5_(arrival);
      const leaveText = formatAttendanceTimeForRuleV5_(leave);
      const arrivalMinutes = arrivalText ? parseTimeToMinutes_(arrivalText) : null;
      const leaveMinutes = leaveText ? parseTimeToMinutes_(leaveText) : null;
      if (arrivalText) {
        out[key].timeBlocks.push('< ' + arrivalText);
        out[key].notes.push('Arrives after ' + arrivalText);
        if (arrivalMinutes != null) out[key].partialAbsenceWindows.push({type:'before', start:null, end:arrivalMinutes, raw:'< ' + arrivalText});
      }
      if (leaveText) {
        out[key].timeBlocks.push('> ' + leaveText);
        out[key].notes.push('Leaves after ' + leaveText);
        if (leaveMinutes != null) out[key].partialAbsenceWindows.push({type:'after', start:leaveMinutes, end:null, raw:'> ' + leaveText});
      }
    } else {
      out[key].fullDay = true;
    }
  }
  return out;
}

function dateInRangeV5_(target, start, end) {
  const t = dateOnly_(target).getTime();
  return t >= dateOnly_(start).getTime() && t <= dateOnly_(end).getTime();
}

function formatAttendanceTimeForRuleV5_(value) {
  if (!value) return '';
  if (value instanceof Date) return Utilities.formatDate(value, 'America/Los_Angeles', 'h:mm a');
  const s = String(value || '').trim();
  const m24 = s.match(/^(\d{1,2}):(\d{2})$/);
  if (m24) {
    let h = Number(m24[1]), min = m24[2], ap = h >= 12 ? 'PM' : 'AM';
    h = h % 12; if (h === 0) h = 12;
    return h + ':' + min + ' ' + ap;
  }
  return s;
}

