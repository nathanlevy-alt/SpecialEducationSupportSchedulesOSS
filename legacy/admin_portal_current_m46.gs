function getStudentDisruptionReportV5189() {
  const ss = getActiveSpreadsheetV5_();
  const model = loadModelV5_(ss);
  const run = buildAssignmentsBreaksWithEmergencyLunchV5_(model);
  const rows = [];
  function studentPriority_(name) {
    const st = model.studentsByName && model.studentsByName.get(normalizeName_(name || ''));
    return st && st.priority != null ? st.priority : '';
  }
  function addDisruption_(studentName, period, location, type, minutes, staff, reason) {
    if (!studentName) return;
    rows.push({
      student: studentName,
      priority: studentPriority_(studentName),
      period: getPeriodDisplayLabelForOutputV5158_ ? getPeriodDisplayLabelForOutputV5158_(period || '') : (period || ''),
      location: location || '',
      disruptionType: type || '',
      minutes: minutes ? String(minutes) : '',
      staffInvolved: staff || '',
      reason: reason || ''
    });
  }
  ((run.breaks && run.breaks.items) || []).forEach(function(b) {
    const isTemporary = b.notes === 'Temporary grouping' || b.daisyChain || b.helperStaff;
    if (!isTemporary) return;
    const minutes = b.startMinutes != null && b.endMinutes != null ? Math.max(0, b.endMinutes - b.startMinutes) : '';
    const restType = String(b.type || '').toLowerCase().indexOf('lunch') >= 0 ? 'Lunch' : 'Break';
    splitStudentNamesV5190_(b.students).forEach(function(name) {
      const need = getStudentNeedByNamePeriodV5190_(model, name, b.period);
      const support = need ? String(need.supportRaw || need.support || '') : '';
      const individualRelaxed = /individual/i.test(support);
      addDisruption_(name, b.period, b.location || '', individualRelaxed ? (support + ' treated as temporary group') : (b.daisyChain ? 'Daisy-chain temporary coverage' : 'Direct temporary grouping'), minutes, [b.staffOnBreak, b.coveringStaff, b.helperStaff].filter(Boolean).filter(function(x){return String(x).toUpperCase() !== 'N/A';}).join(' / '), 'Needed to cover ' + (b.staffOnBreak || 'staff') + "'s " + restType.toLowerCase());
    });
    splitStudentNamesV5190_(b.helperStudents).forEach(function(name) {
      const need = getStudentNeedByNamePeriodV5190_(model, name, b.period);
      const support = need ? String(need.supportRaw || need.support || '') : '';
      const individualRelaxed = /individual/i.test(support);
      addDisruption_(name, b.period, b.helperLocation || '', individualRelaxed ? (support + ' treated as temporary group/helper leg') : 'Daisy-chain helper coverage', minutes, [b.helperStaff, b.coveringStaff].filter(Boolean).join(' / '), (b.helperStaff || 'Helper staff') + ' temporarily covered for ' + (b.coveringStaff || 'staff'));
    });
  });
  ((run.assignments && run.assignments.unassigned) || []).forEach(function(n) {
    if (!n || !n.student) return;
    addDisruption_(n.student.name, n.period, n.location, 'Uncovered need', '', '', 'No valid staff assignment found for this student/period.');
  });
  rows.sort(function(a,b){
    const ap = Number(a.priority), bp = Number(b.priority);
    if (isFinite(ap) && isFinite(bp) && ap !== bp) return ap - bp;
    return String(a.student).localeCompare(String(b.student));
  });
  return {ok:true, rows:rows};
}

function getRuleConflictDetectorV5119() {
  const ss = getActiveSpreadsheetV5_();
  const model = loadModelV5_(ss);
  const run = buildAssignmentsBreaksWithEmergencyLunchV5_(model);
  const assignments = run.assignments || buildAssignmentsV5_(model);
  const warnings = getStaffingWarningsV5_(model, assignments).map(function(w){
    return {severity:w.severity || 'Medium', type:w.type || 'Warning', period:w.period || '', periodDisplay:getPeriodDisplayLabelForOutputV5158_(w.period || ''), staff:w.staff || '', detail:w.detail || '', explanation:w.explanation || '', nextStep:'Review setup and rerun generation after changes.', students:w.students || []};
  });
  ((run.breaks && run.breaks.items) || []).forEach(function(b){
    if (b.notes === 'Temporary grouping') warnings.push({severity:'Medium', type:'Temporary grouping used', period:b.period || '', periodDisplay:getPeriodDisplayLabelForOutputV5158_(b.period || ''), detail:'Temporary grouping used for ' + (b.staffOnBreak || 'staff') + ' during ' + ((b.startMinutes != null && b.endMinutes != null) ? formatTimeRange_(b.startMinutes,b.endMinutes) : 'rest coverage') + '.', explanation:'This means normal assignment rules were relaxed for this rest window. Check Student Disruption Report for student priority impact.', nextStep:'Open Student Disruption Report and confirm low numeric priority students were not unnecessarily disrupted.'});
    if (b.daisyChain) warnings.push({severity:'Medium', type:'Daisy-chain coverage used', period:b.period || '', periodDisplay:getPeriodDisplayLabelForOutputV5158_(b.period || ''), detail:'Daisy-chain coverage used for ' + (b.staffOnBreak || 'staff') + '.', explanation:'A helper staff member covered the covering staff member’s original assignment so the covering staff member could move.', nextStep:'Open Break Coverage Review and confirm all legs of the chain are represented.'});
  });
  try {
    (getRestPreferenceConflictAnalyzerV51251().rows || []).filter(function(r){ return r.severity !== 'Info'; }).forEach(function(r){ warnings.push(r); });
    (getSupportTypeCoverageAnalyzerV51251().rows || []).filter(function(r){ return r.severity !== 'Info'; }).forEach(function(r){ warnings.push(r); });
  } catch (analyzerErr) {
    warnings.push({severity:'Low', type:'Analyzer warning', detail:'New rest/support analyzer could not run: ' + (analyzerErr && analyzerErr.message || analyzerErr), explanation:'This does not stop schedule generation.', nextStep:'Refresh data and rerun Logic Review.'});
  }
  ((assignments && assignments.unassigned) || []).forEach(function(n){
    warnings.push({severity:'High', type:'Uncovered student need', period:n.period || '', periodDisplay:getPeriodDisplayLabelForOutputV5158_(n.period || ''), detail:(n.student ? n.student.name : 'Student') + ' is uncovered at ' + (n.location || 'location') + '.', explanation:'This is a direct assignment failure that should be reviewed before publishing.', nextStep:'Use Assignment Analyzer for this student/period.'});
  });
  (model.staff || []).forEach(function(st){
    if (!st || !st.name) return;
    if (st.absent && st.priorityHolds && st.priorityHolds.length) warnings.push({severity:'Medium', type:'Absent staff has priority hold', period:'', staff:st.name, detail:st.name + ' is absent/unavailable but still has priority hold rule(s).', explanation:'The scheduler will skip the absent staff member, but the hold may create confusion when reviewing expected coverage.', nextStep:'Remove or update the priority hold if it should not apply.'});
    if (st.attendancePartial) warnings.push({severity:'Medium', type:'Partial-day staff absence', period:'', staff:st.name, detail:st.name + ': ' + ((st.attendanceNotes || []).join(' / ') || (st.attendance && st.attendance.timeBlocks ? st.attendance.timeBlocks.join(' / ') : 'Partial-day absence')), explanation:'Partial-day absences become staff blocked-time rules for the unavailable portion of the day.', nextStep:'Confirm the unavailable window matches the staff report.'});
  });
  if (!model.staff || !model.staff.filter(function(s){ return !s.absent; }).length) warnings.push({severity:'High', type:'No available staff', detail:'No active/present staff were found for the selected schedule date.', explanation:'Generation cannot assign students without available staff.', nextStep:'Check Staff Manager and Attendance.'});
  if (!model.schedule || !model.schedule.assignmentItems || !model.schedule.assignmentItems.length) warnings.push({severity:'High', type:'No active schedule items', detail:'The current bell schedule has no active periods/items.', explanation:'Check Calendar Manager and Bell Schedule Manager.', nextStep:'Assign a schedule type for today and ensure the bell schedule has active items.'});
  buildOffCampusConflictRowsV5153_(model).forEach(function(row){ row.nextStep = row.nextStep || 'Review Off-Campus Sites and buffer/group settings.'; warnings.push(row); });
  warnings.sort(function(a,b){ const rank={High:0,Medium:1,Low:2}; return (rank[a.severity]||9)-(rank[b.severity]||9) || String(a.type).localeCompare(String(b.type)); });
  return {ok:true, count:warnings.length, rows:warnings};
}


