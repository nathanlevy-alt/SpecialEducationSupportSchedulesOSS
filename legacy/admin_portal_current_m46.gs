      });
      if (Object.keys(migrated).length) writeCampusScopedPropertiesMapV5263_(ss, migrated);
    } catch (e) {}
  }

  const raw = {};
  if (sheet.getLastRow() >= 2) {
    const values = sheet.getRange(2, 1, sheet.getLastRow() - 1, Math.max(2, sheet.getLastColumn())).getDisplayValues();
    values.forEach(function(r) {
      const key = String(r[0] || '').trim();
      if (!key) return;
      raw[key] = String(r[1] || '');
    });
  }
  const map = {};
  Object.keys(raw).forEach(function(key) {
    if (key.indexOf(V5263_CHUNK_MARK) >= 0) return;
    const val = raw[key] || '';
    if (val.indexOf(V5263_CHUNK_PREFIX) === 0) {
      const count = Number(val.substring(V5263_CHUNK_PREFIX.length)) || 0;
      let combined = '';
      for (let i = 0; i < count; i++) {
        const ck = key + V5263_CHUNK_MARK + ('0000' + i).slice(-4);
