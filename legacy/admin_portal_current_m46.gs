      entry = entry || {};
      var reason = entry.reason || entry.decisionReason || entry.message || 'No reason text recorded.';
      var count = entry.count || (Array.isArray(entry.staff) ? entry.staff.length : '');
      var staff = Array.isArray(entry.staff) ? entry.staff.filter(Boolean).slice(0,6).join(', ') : '';
      var line = reason;
      if(count) line += ' ('+count+' staff)';
      if(staff) line += ': '+staff;
      return line;
    });
    if(summary.length > 8) rows.push('Additional rejection categories were recorded but are hidden for readability. Use raw details if needed.');
    return logicSummaryListHtml_(rows);
  }
  function logicDrilldownHtmlFromRow(r,idx){
    var row=logicRowToObject(r); var ctx=row.context||{}; var blob=(row.message+' '+row.contextText+' '+row.raw).toLowerCase();
    var student=logicField(ctx,['student','studentName','name']);
    var staff=logicField(ctx,['staff','staffName','assignedStaff','coveringStaff','primaryStaff','secondaryStaff']);
    var period=logicField(ctx,['period','item','scheduleItem','block']);
    var location=logicField(ctx,['location','room','classroom']);
    var support=logicField(ctx,['support','supportType','need']);
    var rule=logicField(ctx,['rule','reason','constraint','type','decisionReason']);
    var recordedExplanation = ctx.explanation || ctx.detail || '';
    var decisionReason = ctx.decisionReason || ctx.reason || ctx.constraint || '';
    var rejectionSummary = Array.isArray(ctx.rejectionSummary) ? ctx.rejectionSummary : [];
    var candidateCount = ctx.candidateStaffChecked || ctx.candidatesChecked || '';
    var why = recordedExplanation || decisionReason || row.message || 'This logic row did not include detailed decision context.';
    var checks=[];
    var specificHtml='';

    if(rejectionSummary.length){
      specificHtml += '<div style="font-weight:700;margin-top:10px">Recorded rejection summary</div>'+logicFormatRejectionSummary_(rejectionSummary);
      if(candidateCount) specificHtml += '<div class="dashMeta" style="margin-top:5px">Candidate staff checked: '+esc(candidateCount)+'</div>';
      if(decisionReason) specificHtml += '<div style="margin-top:8px"><b>Top recorded reason:</b> '+esc(decisionReason)+'</div>';
    } else if(decisionReason){
      specificHtml += '<div style="margin-top:8px"><b>Recorded reason:</b> '+esc(decisionReason)+'</div>';
    }

    if(blob.indexOf('unassigned')>=0||blob.indexOf('could not assign')>=0||blob.indexOf('needs support')>=0){
      if(!recordedExplanation) why='This student was left unassigned because the scheduler could not find a legal staff assignment for this exact period/location/support need.';
      checks=['Check the recorded rejection summary above first; it is the actual audit explanation from the generator.','If preferred staff were listed, check whether they were absent, blocked, already assigned, or in a different room.','If most staff were rejected for different location or capacity, use Customize Schedule only if cross-room or higher group size is acceptable.','If the row predates the detailed audit update, regenerate the schedule so the drilldown can record exact rejection categories.'];
    }
    else if(blob.indexOf('blocked')>=0||blob.indexOf('block')>=0){
      if(!recordedExplanation) why='A blocked-time, blocked-student, or blocked-room rule was involved in this scheduling decision.';
      checks=['Review the named staff member in Staff Manager.','Check Blocked Times, Blocked Students, and Blocked Rooms.','Remove or narrow the rule only if it should not apply to this period.'];
    }
    else if(blob.indexOf('priority')>=0||blob.indexOf('hold')>=0||blob.indexOf('coach')>=0){
      if(!recordedExplanation) why='A priority hold or Coach hold was involved in this scheduling decision.';
      checks=['Review the named staff member Priority Holds.','Coach holds protect staff from generated breaks/lunches.','Room/period holds affect assignment preference/reservation, but do not override blocked time.'];
    }
    else if(blob.indexOf('break')>=0||blob.indexOf('lunch')>=0){
      if(!recordedExplanation) why='Break or lunch placement was affected by coverage availability, blocked time, Coach hold status, or existing assignments.';
      checks=['Check staff absences and blocked times for the break/lunch window.','Check Coach priority holds.','Review whether the staff member was already covering a student or another rest event during that window.'];
    }
    else if(blob.indexOf('publish')>=0||blob.indexOf('portal')>=0||blob.indexOf('regular')>=0){
      if(!recordedExplanation) why='This row is related to schedule publication or Staff Portal visibility.';
      checks=['Confirm whether the intended schedule was published.','For Regular Schedule, confirm the snapshot is locked and display is enabled.','Ask staff to refresh the Staff Portal tab.'];
    }
    else if(blob.indexOf('absence')>=0||blob.indexOf('absent')>=0){
      if(!recordedExplanation) why='Attendance or absence information changed staff or student availability.';
      checks=['Open Attendance Manager and confirm the absence record.','Refresh Data after attendance changes.','Regenerate or customize after confirming coverage impact.'];
    }
    else {
      checks=['This row does not currently have enough structured audit data for a precise explanation.','Use the message and raw details to identify the related student, staff member, room, or period.','For more exact future drilldowns, regenerate the schedule in this version so newer audit fields are recorded.'];
    }

    var facts=[];
    if(student)facts.push('<b>Student:</b> '+esc(student));
    if(staff)facts.push('<b>Staff:</b> '+esc(staff));
    if(period)facts.push('<b>Period/item:</b> '+esc(period));
    if(location)facts.push('<b>Location:</b> '+esc(location));
    if(support)facts.push('<b>Support:</b> '+esc(support));
    if(rule && String(rule)!==String(decisionReason))facts.push('<b>Rule/reason:</b> '+esc(rule));
    var factHtml=facts.length?'<div class="logicFacts" style="margin-top:8px;line-height:1.7">'+facts.join('&nbsp;&nbsp;&nbsp;')+'</div>':'';
    var checkHtml='<div style="font-weight:700;margin-top:10px">What to check next</div>'+logicSummaryListHtml_(checks);
    return '<div id="logicDetail_'+idx+'" class="logicDrilldown" style="display:none;margin-top:8px;padding:12px;border:1px solid #dbe3ef;border-radius:12px;background:#f8fafc;color:#334155"><div style="font-weight:800;color:#0f172a;margin-bottom:6px">Logic Drilldown</div><div><b>Why this row exists:</b> '+esc(why)+'</div>'+factHtml+specificHtml+checkHtml+'</div>';
