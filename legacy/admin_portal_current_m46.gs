  Object.keys(vars).forEach(function(key) {
    const re = new RegExp('\\{\\{\\s*' + key + '\\s*\\}\\}', 'g');
    text = text.replace(re, String(vars[key] == null ? '' : vars[key]));
  });
  return text;
}

function plainTemplateToHtmlV5317_(text) {
  text = String(text || '').replace(/\r\n/g, '\n').replace(/\r/g, '\n');
  const blocks = text.split(/\n\s*\n/);
  return blocks.map(function(block) {
    const lines = block.split('\n');
    if (lines.every(function(l) { return /^\s*[-•]\s+/.test(l); })) {
      return '<ul>' + lines.map(function(l) { return '<li>' + escHtml_(l.replace(/^\s*[-•]\s+/, '')) + '</li>'; }).join('') + '</ul>';
    }
    return '<p>' + lines.map(function(l) { return escHtml_(l); }).join('<br>') + '</p>';
  }).join('\n');
}

