  return buildScenarioResultMatrixV520_(attendance);
}

function runScenarioPreviewWithProjectedV523(payload) {
  payload = payload || {};
  const model = buildScenarioModelV5_({date: payload.date || payload.scenarioDate || '', scheduleType: payload.scheduleType || payload.scenarioType || ''});
  const targetKey = scenarioDateKeyFromInputV5_(payload.date || payload.scenarioDate || '') || dateKeyV5_(model.schedule.date);
  const attendanceRows = getAttendanceRowsForDateKeyV5_(model.ss, targetKey);
