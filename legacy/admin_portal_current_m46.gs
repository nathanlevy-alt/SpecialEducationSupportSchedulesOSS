  const width = Math.max(sheet.getLastColumn(), nameCol, statusCol || 1, idCol || 1);
  const vals = sheet.getRange(2, 1, sheet.getLastRow() - 1, width).getDisplayValues();
  const rows = [];
  vals.forEach(function(r, i) {
