function syncSpecialEventCalendarNotesV5143_(ss, previousEvents, currentEvents) {
  const cal = ss.getSheetByName(V5.SHEETS.CALENDAR);
  if (!cal) return;
  ensureCalendarHeadersV5_(ss);
  const oldByDate = specialEventNamesByIsoV5143_(previousEvents || []);
  const newByDate = specialEventNamesByIsoV5143_(currentEvents || []);
  const allDates = {};
  Object.keys(oldByDate).forEach(function(k){ allDates[k] = true; });
  Object.keys(newByDate).forEach(function(k){ allDates[k] = true; });
  if (!Object.keys(allDates).length) return;

  const values = cal.getDataRange().getValues();
  const display = cal.getDataRange().getDisplayValues();
  const rowByIso = {};
  for (let r = 1; r < values.length; r++) {
    const iso = calendarIsoFromValueV5_(values[r][0], display[r][0]);
    if (iso) rowByIso[iso] = r + 1;
  }

  const rowsToDelete = [];
  Object.keys(allDates).forEach(function(iso) {
    const oldNames = oldByDate[iso] || [];
    const newNames = newByDate[iso] || [];
    const rowIndex = rowByIso[iso];
    let scheduleType = '';
    let notes = '';
    if (rowIndex) {
      scheduleType = clean_(cal.getRange(rowIndex, 2).getDisplayValue() || cal.getRange(rowIndex, 2).getValue());
      notes = clean_(cal.getRange(rowIndex, 3).getDisplayValue() || cal.getRange(rowIndex, 3).getValue());
    }
    let parts = splitCalendarNotePartsV5143_(notes).filter(function(part) {
      return oldNames.indexOf(part) < 0;
    });
    newNames.forEach(function(name) { if (parts.indexOf(name) < 0) parts.push(name); });
    const newNote = parts.join(' / ');
    if (rowIndex) {
      if (!scheduleType && !newNote) rowsToDelete.push(rowIndex);
      else cal.getRange(rowIndex, 1, 1, 3).setValues([[dateFromIsoV5_(iso), scheduleType, newNote]]);
    } else if (newNote) {
      cal.appendRow([dateFromIsoV5_(iso), '', newNote]);
    }
  });
  rowsToDelete.sort(function(a, b){ return b - a; }).forEach(function(row){ cal.deleteRow(row); });
  sortCalendarSheetV5_(cal);
  setupDataValidationV5_(ss);
}

