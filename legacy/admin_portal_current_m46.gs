function saveCampusUserAccessV5258(payload) {
  payload = payload || {};
  setupMultiCampusV5253();
  const ctx = getAllowedCampusesV5253();
  if (!(ctx.systemAdmin || ctx.actualSystemAdmin)) throw new Error('Only District/System Admin users can manage school users.');
  const email = String(payload.email || '').trim().toLowerCase();
  const role = normalizeRoleV5258_(payload.role || 'Site');
  const originalEmail = String(payload.originalEmail || '').trim().toLowerCase();
  const originalRole = payload.originalRole ? normalizeRoleV5258_(payload.originalRole) : '';
  const status = clean_(payload.status || 'Active');
  if (!email) throw new Error('Email is required.');
  let campusIds = [];
  if (role === 'District') {
    campusIds = ['*'];
  } else if (Array.isArray(payload.campusIds)) {
    campusIds = payload.campusIds.map(function(x) { return clean_(x); }).filter(Boolean);
  } else {
    campusIds = String(payload.campusId || '').split(/[;,\n]+/).map(function(x) { return clean_(x); }).filter(Boolean);
  }
  if (role === 'Site' && !campusIds.length) throw new Error('Choose at least one school for Site access.');
  const validCampusIds = getCampusRowsV5253_().map(function(c) { return c.campusId; });
  campusIds = campusIds.filter(function(cid, idx, arr) { return cid === '*' || (validCampusIds.indexOf(cid) >= 0 && arr.indexOf(cid) === idx); });
  if (role === 'Site' && !campusIds.length) throw new Error('No valid schools were selected.');

  const controller = getControllerSpreadsheetV5253_();
  const sh = controller.getSheetByName(V5253_MC.USER_SHEET);
  let rows = sh.getLastRow() > 1 ? sh.getRange(2, 1, sh.getLastRow() - 1, 7).getValues() : [];
  const now = new Date();
  const by = getCurrentUserEmailV5253_();
  const desired = {};
  campusIds.forEach(function(cid) { desired[cid] = true; });

  // V5.1.265: remove old/de-selected access rows instead of leaving cluttered Inactive rows.
  // The Status dropdown is still available when an admin intentionally wants to keep a visible
  // access row but temporarily disable it.
  const deleteIndexes = {};
  if (originalEmail && (originalEmail !== email || (originalRole && originalRole !== role))) {
    for (let oi = 0; oi < rows.length; oi++) {
      const oldEmail = String(rows[oi][0] || '').trim().toLowerCase();
      const oldRole = normalizeRoleV5258_(rows[oi][2]);
      if (oldEmail === originalEmail && (!originalRole || oldRole === originalRole)) deleteIndexes[oi] = true;
    }
  }

  for (let i = 0; i < rows.length; i++) {
    const rowEmail = String(rows[i][0] || '').trim().toLowerCase();
    if (rowEmail !== email) continue;
    const rowCampus = clean_(rows[i][1] || '*');
    const rowRole = normalizeRoleV5258_(rows[i][2]);
    if (rowRole !== role || !desired[rowCampus]) deleteIndexes[i] = true;
  }

  Object.keys(deleteIndexes).map(Number).sort(function(a, b) { return b - a; }).forEach(function(i) {
    sh.deleteRow(i + 2);
  });

  rows = sh.getLastRow() > 1 ? sh.getRange(2, 1, sh.getLastRow() - 1, 7).getValues() : [];
  campusIds.forEach(function(cid) {
    let found = -1;
    for (let i = 0; i < rows.length; i++) {
      if (String(rows[i][0] || '').trim().toLowerCase() === email && clean_(rows[i][1] || '*') === cid && normalizeRoleV5258_(rows[i][2]) === role) { found = i; break; }
    }
    const row = [email, cid, role, status, now, by, clean_(payload.notes || '')];
    if (found >= 0) {
      row[4] = rows[found][4] || now;
      row[5] = rows[found][5] || by;
      row[6] = clean_(payload.notes || rows[found][6] || '');
      sh.getRange(found + 2, 1, 1, 7).setValues([row]);
