  }
  const allowedUnstaffedRows = (assignments.allowedUnstaffed || []).map(function(n) { return [n.student.name, n.student.priority, n.location, n.supportRaw, n.period]; });
  if (allowedUnstaffedRows.length) {
    const allowedStart = 3 + unassignedRows.length + (unassignedRows.length ? 1 : 0);
    sheet.getRange(allowedStart, unassignedStart, 1, 5).merge().setValue('Allowed Unstaffed (Optimization)').setBackground('#fff2cc').setFontWeight('bold').setHorizontalAlignment('center');
    sheet.getRange(allowedStart + 1, unassignedStart, 1, 5).setValues([['Student / Staff', 'Priority', 'Location', 'Support / Assignment', 'Period']]).setFontWeight('bold').setBackground('#fce5cd');
    sheet.getRange(allowedStart + 2, unassignedStart, allowedUnstaffedRows.length, 5).setValues(allowedUnstaffedRows);
    const allowedRich = (assignments.allowedUnstaffed || []).map(function(n) {
      return [buildLinkedStudentText_([n], n.student.name)];
    });
    sheet.getRange(allowedStart + 2, unassignedStart, allowedUnstaffedRows.length, 1).setRichTextValues(allowedRich);
  }

  // Staff free time.
  sheet.getRange(1, freeStart, 1, 2).merge().setValue('Staff Free Time').setBackground('#ff0000').setFontWeight('bold').setHorizontalAlignment('center');
  sheet.getRange(2, freeStart, 1, 2).setValues([['Staff', 'Minutes']]).setFontWeight('bold').setBackground('#bfbfbf');
  const freeRows = Array.from(freeTime.entries()).sort(function(a, b) { return b[1] - a[1]; });
  if (freeRows.length) sheet.getRange(3, freeStart, freeRows.length, 2).setValues(freeRows);

  // Staff-out and student-out.
  sheet.getRange(1, outStart, 1, 2).setValues([['Staff-Out', 'Student-Out']]).setFontWeight('bold').setBackground('#ea9999').setHorizontalAlignment('center');
  const maxOut = Math.max(absentStaff.length, absentStudents.length, 1);
