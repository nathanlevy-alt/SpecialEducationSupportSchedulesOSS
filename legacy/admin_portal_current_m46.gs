    const cached = cache.get(key);
    if (cached) return parseStudentDataMetricV51222_(cached);
  } catch (e) {}
  const metric = computeStudentDataMetricV51222_(url);
  try {
    cache.put(key, serializeStudentDataMetricV51222_(metric), 3600);
  } catch (e2) {}
  metric.cached = false;
