function syncManualStaffAbsenceFromManagerV5_(ss, staffName, isAbsent, wasAbsent) {
  if (!staffName) return;
  if (isAbsent) {
    ensureManualStaffAbsenceEntryV5_(ss, staffName);
  } else {
    removeManualStaffAbsenceEntryV5_(ss, staffName);
  }
}

function ensureManualStaffAbsenceEntryV5_(ss, staffName) {
  const sheet = ss.getSheetByName(V5.SHEETS.ATTENDANCE) || ss.insertSheet(V5.SHEETS.ATTENDANCE);
  if (sheet.getLastRow() === 0) sheet.getRange(1, 1, 1, 3).setValues([['Timestamp', 'Name', 'Source']]);
  const todayKey = dateKeyV5_(new Date());
  const values = sheet.getDataRange().getValues();
  for (let r = 1; r < values.length; r++) {
    const rowDate = values[r][0] instanceof Date ? values[r][0] : null;
    const rowName = clean_(values[r][1]);
    if (rowDate && dateKeyV5_(rowDate) === todayKey && normalizeName_(rowName) === normalizeName_(staffName)) return;
  }
  sheet.appendRow([new Date(), staffName, 'Manual Staff Manager']);
}

function removeManualStaffAbsenceEntryV5_(ss, staffName) {
  const sheet = ss.getSheetByName(V5.SHEETS.ATTENDANCE);
  if (!sheet || sheet.getLastRow() < 2) return;
  const todayKey = dateKeyV5_(new Date());
  const values = sheet.getDataRange().getValues();
  for (let r = values.length - 1; r >= 1; r--) {
    const rowDate = values[r][0] instanceof Date ? values[r][0] : null;
    const rowName = clean_(values[r][1]);
    const source = clean_(values[r][2]);
    if (rowDate && dateKeyV5_(rowDate) === todayKey && normalizeName_(rowName) === normalizeName_(staffName) && source === 'Manual Staff Manager') {
      sheet.deleteRow(r + 1);
    }
  }
}

function dateKeyV5_(date) {
  return Utilities.formatDate(new Date(date), 'America/Los_Angeles', 'yyyy-MM-dd');
}

function deleteStaffFromManagerV5367_original_(payload) {
  const ss = getActiveSpreadsheetV5_();
  const sheet = ss.getSheetByName(V5.SHEETS.STAFF);
  const name = clean_((payload && (payload.oldName || payload.name)) || '');
  const rowIndex = Number(payload && payload.rowIndex) || findStaffRowByNameV5_(sheet, name);
  if (!rowIndex || rowIndex < 2) throw new Error('Staff not found.');
  const deletedName = clean_(sheet.getRange(rowIndex, 1).getDisplayValue()) || name;
  sheet.deleteRow(rowIndex);
  refreshV5ValidationHelpers();
  return { ok: true, message: 'Deleted ' + deletedName + '.' };
}

function findStaffRowByNameV5_(sheet, name) {
  const target = normalizeName_(name);
  if (!target) return null;
  const names = sheet.getRange(2, 1, Math.max(sheet.getLastRow() - 1, 1), 1).getDisplayValues().flat();
  for (let i = 0; i < names.length; i++) if (normalizeName_(names[i]) === target) return i + 2;
  return null;
}

