function scheduledCacheWarmCheckV5396() {
  const settings = getPerformanceSettingsV5396();
  const started = Date.now();
  const out = { ok: true, version: '5.1.399', autoWarmEnabled: !!settings.autoWarmEnabled, minutesBefore: settings.autoWarmMinutesBefore, rows: [] };
  if (!settings.autoWarmEnabled) { out.message = 'Auto warm is disabled.'; return out; }
  let campuses = [];
  try { campuses = getCampusRowsV5253_().filter(function(c) { return String(c.status || 'Active').toLowerCase() !== 'inactive'; }); } catch (err) { out.ok = false; out.error = String(err && err.message || err); return out; }
  const tz = 'America/Los_Angeles';
  const now = new Date();
  const todayKey = Utilities.formatDate(now, tz, 'yyyy-MM-dd');
  const nowMinutes = now.getHours() * 60 + now.getMinutes();
  const props = PropertiesService.getScriptProperties();
  campuses.forEach(function(c) {
    const row = { campusId: c.campusId, campusName: c.campusName, warmed: false, skipped: false };
    const t = Date.now();
    try {
      const ss = SpreadsheetApp.openById(c.spreadsheetId);
      const win = getWorkdayWindowForDateV5_(ss, now);
      row.schoolStartMinutes = win && win.startMinutes;
      row.scheduleType = win && win.scheduleType || '';
      if (row.schoolStartMinutes == null) { row.skipped = true; row.message = 'No school start time found.'; out.rows.push(row); return; }
      const warmStart = Number(row.schoolStartMinutes) - Number(settings.autoWarmMinutesBefore || 30);
      if (nowMinutes < warmStart || nowMinutes >= Number(row.schoolStartMinutes)) { row.skipped = true; row.message = 'Outside warm window.'; out.rows.push(row); return; }
      const key = 'V5396_AUTO_WARM_LAST_' + c.campusId + '_' + todayKey + '_' + settings.autoWarmMinutesBefore;
      if (props.getProperty(key)) { row.skipped = true; row.message = 'Already warmed for this window.'; out.rows.push(row); return; }
      const warm = withSelectedCampusV5396_(c.campusId, function() { return warmCurrentSchoolCacheV5396_({ includeAdvanced: true, source: 'auto' }); });
      props.setProperty(key, new Date().toISOString());
      row.warmed = true;
      row.message = warm && warm.message || 'Warmed.';
    } catch (err2) {
      row.error = String(err2 && err2.message || err2);
    }
    row.ms = Date.now() - t;
    out.rows.push(row);
  });
  out.totalMs = Date.now() - started;
  return out;
}

function sheetHealthRowsV5396_(ss) {
  const rows = [];
  ss.getSheets().forEach(function(sh) {
    const name = sh.getName();
    const maxRows = sh.getMaxRows();
    const maxCols = sh.getMaxColumns();
    const lastRow = sh.getLastRow();
    const lastCol = sh.getLastColumn();
    const dataRange = sh.getDataRange();
    const dataRows = dataRange ? dataRange.getNumRows() : 0;
    const dataCols = dataRange ? dataRange.getNumColumns() : 0;
    const extraRows = Math.max(0, maxRows - Math.max(lastRow, 1));
    const extraCols = Math.max(0, maxCols - Math.max(lastCol, 1));
    let cfRules = 0;
    let wideCfRules = 0;
    try {
      const rules = sh.getConditionalFormatRules() || [];
      cfRules = rules.length;
      rules.forEach(function(rule) {
        (rule.getRanges() || []).forEach(function(rg) {
          if (rg.getNumRows() >= Math.max(500, maxRows - 5) || rg.getNumColumns() >= Math.max(20, maxCols - 2)) wideCfRules++;
        });
      });
    } catch (e) {}
    rows.push({ sheet: name, maxRows: maxRows, maxColumns: maxCols, lastRow: lastRow, lastColumn: lastCol, dataRangeRows: dataRows, dataRangeColumns: dataCols, extraBlankRows: extraRows, extraBlankColumns: extraCols, conditionalFormatRules: cfRules, wideConditionalFormatRanges: wideCfRules, recommendTrim: extraRows > 250 || extraCols > 25 || wideCfRules > 0 });
  });
  return rows;
}

function auditSelectedSchoolSheetsV5396() {
