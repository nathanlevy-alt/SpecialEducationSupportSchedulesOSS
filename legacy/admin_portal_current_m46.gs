function parseScheduleItemMinutesV5_(txt) {
  txt = String(txt || '');
  const re = /(\d{1,2}:\d{2}\s*(?:[AP]M?)?)/ig;
  const vals = [];
  let m;
  while ((m = re.exec(txt)) && vals.length < 2) vals.push(parseTimeToMinutes_(m[1]));
  if (vals.length >= 2 && vals[0] != null && vals[1] != null) return {start: vals[0], end: vals[1]};
  return null;
}

