function getFormMetricsFromUrlV5_(url) {
  url = String(url || '').trim();
  if (!url) return { points: '', lastUpdated: '', note: '' };
  if (!/docs\.google\.com\/forms/i.test(url)) return { points: '', lastUpdated: '', note: 'Not a Google Form URL' };
  try {
    const form = FormApp.openByUrl(url);
    const responses = form.getResponses() || [];
    let latest = null;
