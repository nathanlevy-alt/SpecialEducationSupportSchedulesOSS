  (model.staff || []).forEach(function(s){ if (absentByStaff[normalizeName_(s.name)] || projected.indexOf(normalizeName_(s.name)) >= 0) s.absent = true; });
  const run = buildAssignmentsBreaksWithEmergencyLunchV5_(model);
  const views = buildPortalScheduleViewsV5_(model, run.assignments, run.breaks);
  const absentNames = new Set((model.staff || []).filter(function(s){ return s.absent; }).map(function(s){ return normalizeName_(s.name); }));
  views.staffSchedules = (views.staffSchedules || []).filter(function(row){ return !absentNames.has(normalizeName_(row.staff)); });
  views.breakItems = ((run.breaks && run.breaks.items) || []).map(function(b){ const c={}; for (var k in b) c[k]=b[k]; if (!c.time && c.startMinutes != null && c.endMinutes != null) c.time = formatTimeRange_(c.startMinutes, c.endMinutes); return c; });
  views.scenarioDate = model.schedule.date;
