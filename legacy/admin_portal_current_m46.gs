function applyRestCoverageSelectionV5208_(candidate, staffName, assignment, cover, options, dutyBusyByStaff, breakMinutesByStaff, duration) {
  addBusyIntervalV5_(dutyBusyByStaff, staffName, candidate.start, candidate.end);
  addBusyIntervalV5_(dutyBusyByStaff, cover.name, candidate.start, candidate.end);
  if (cover.helperStaff) addBusyIntervalV5_(dutyBusyByStaff, cover.helperStaff, candidate.start, candidate.end);
  addBreakMinutes_(breakMinutesByStaff, staffName, duration);
  let note = getRestDutyNoteV5_(options.type, candidate.item);
  if (cover.daisyChain) note = 'Daisy-chain coverage';
  else if (cover.temporaryGroupForRest) note = 'Temporary grouping';
  else if (cover.leadRestCoverage) note = 'Lead coverage';
  const itemOut = makeBreakScheduleItemV5_(candidate, staffName, cover.name, assignment.location, assignment.studentNames.join(', '), options.type, note);
  if (cover.daisyChain) {
    itemOut.daisyChain = true;
    itemOut.helperStaff = cover.helperStaff || '';
    itemOut.helperCoveringFor = cover.helperCoveringFor || cover.name || '';
    itemOut.helperLocation = cover.helperLocation || '';
    itemOut.helperStudents = cover.helperStudents || '';
  }
  if (cover.leadRestCoverage) {
    itemOut.leadRestCoverage = true;
    itemOut.leadZeroGroupRestCoverage = !!cover.leadZeroGroupRestCoverage;
    itemOut.leadLowPriorityRestCoverage = !!cover.leadLowPriorityRestCoverage;
  }
  return itemOut;
}


