  const url = 'https://generativelanguage.googleapis.com/v1beta/models/' + encodeURIComponent(model) + ':generateContent?key=' + encodeURIComponent(apiKey);
  const payload = {
    contents: [{ role: 'user', parts: [{ text: String(promptText || '') }] }],
    generationConfig: {
      temperature: options.temperature == null ? 0.15 : Number(options.temperature),
      maxOutputTokens: options.maxOutputTokens || 1800
    }
  };
  const res = UrlFetchApp.fetch(url, {
    method: 'post',
    contentType: 'application/json',
    muteHttpExceptions: true,
    payload: JSON.stringify(payload)
  });
  const code = res.getResponseCode();
  const body = res.getContentText() || '';
  if (code < 200 || code >= 300) {
    let detail = body.substring(0, 700);
    try {
      const parsed = JSON.parse(body);
      detail = parsed && parsed.error && parsed.error.message ? parsed.error.message : detail;
    } catch (e) {}
    throw new Error('Gemini API error ' + code + ': ' + detail);
  }
  const json = JSON.parse(body || '{}');
  const candidate = (json.candidates || [])[0] || {};
  const parts = candidate.content && candidate.content.parts ? candidate.content.parts : [];
  const text = parts.map(function(p) { return p.text || ''; }).join('\n').trim();
  if (!text && candidate.finishReason) return 'Gemini returned no text. Finish reason: ' + candidate.finishReason;
  return text;
}

