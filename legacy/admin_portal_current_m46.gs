function getSplitWindowLabelForNeedV05418DF_(need) {
  if (!need || !need.splitPeriodSupport || need.splitStartMinutes == null || need.splitEndMinutes == null) return '';
  try { return formatTimeRange_(need.splitStartMinutes, need.splitEndMinutes); } catch (e) { return ''; }
}

function getDisplayNameForNeedV05418DF_(need) {
  const raw = need && need.student ? String(need.student.baseName || need.student.name || '') : '';
  const base = raw.replace(/\s*\(2:1 support\)\s*$/i, '');
  const win = getSplitWindowLabelForNeedV05418DF_(need);
  return base + (win ? ' (' + win + ')' : '');
}

function getDisplayNamesForAssignmentV05418DF_(assignment) {
  const needs = (assignment && assignment.needs) || [];
  if (needs.length) return needs.map(getDisplayNameForNeedV05418DF_).filter(Boolean);
  return ((assignment && assignment.studentNames) || []).filter(Boolean);
}

function getBusyIntervalsForAssignmentV05418DF_(assignment, item) {
  if (!assignment || !item || item.startMinutes == null || item.endMinutes == null) return [];
  const needs = assignment.needs || [];
  if (!needs.length) return [{start:item.startMinutes, end:item.endMinutes}];
  const out = [];
  for (let i = 0; i < needs.length; i++) {
    const n = needs[i] || {};
    if (n.splitPeriodSupport && n.splitStartMinutes != null && n.splitEndMinutes != null) {
      out.push({ start: Math.max(item.startMinutes, n.splitStartMinutes), end: Math.min(item.endMinutes, n.splitEndMinutes) });
    } else {
      return [{start:item.startMinutes, end:item.endMinutes}];
    }
  }
  return out.filter(function(x){ return x.end > x.start; });
}

function getDashboardCellForStaffPeriod_(staffName, item, assignments, breaks) {
  const periodResult = assignments.byPeriod.get(item.label);
  if (periodResult && periodResult.staffAssignments.has(staffName)) {
    const a = periodResult.staffAssignments.get(staffName);
    return getDisplayNamesForAssignmentV05418DF_(a).join(', ') + (a.location ? ' - ' + a.location : '');
  }
  const breakItems = (breaks.items || []).filter(function(b) { return b.staffOnBreak === staffName && b.period === item.label; });
  if (breakItems.length) return breakItems.map(function(b) { return b.type || b.notes || 'Break'; }).join('\n');
  if (item.type === 'lunch' || item.label === 'Lunch') return 'Lunch Break';
  return '';
}

function getDashboardRichTextForStaffPeriod_(staffName, item, assignments, breaks) {
  const periodResult = assignments.byPeriod.get(item.label);
  if (periodResult && periodResult.staffAssignments.has(staffName)) {
    const a = periodResult.staffAssignments.get(staffName);
    const text = getDisplayNamesForAssignmentV05418DF_(a).join(', ') + (a.location ? ' - ' + a.location : '');
    return buildLinkedStudentText_(a.needs || [], text);
  }

  const breakItems = (breaks.items || []).filter(function(b) {
    return b.staffOnBreak === staffName && b.period === item.label;
  });
  if (breakItems.length) {
    return SpreadsheetApp.newRichTextValue()
      .setText(breakItems.map(function(b) { return b.type || b.notes || 'Break'; }).join('\n'))
      .build();
  }
  if (item.type === 'lunch' || item.label === 'Lunch') {
    return SpreadsheetApp.newRichTextValue().setText('Lunch Break').build();
  }
  return SpreadsheetApp.newRichTextValue().setText('').build();
}

function buildLinkedStudentText_(needs, fallbackText) {
  const safeNeeds = Array.isArray(needs) ? needs : [];
  const text = String(fallbackText || safeNeeds.map(function(n) {
    return n && n.student ? n.student.name : '';
  }).filter(Boolean).join(', ') || '');

  const builder = SpreadsheetApp.newRichTextValue().setText(text);
  safeNeeds.forEach(function(n) {
    if (!n || !n.student || !n.student.name || !n.student.dataFiles) return;
    const url = String(n.student.publishedDataUrl || n.student.dataFiles).trim();
    if (!/^https?:\/\//i.test(url)) return;

    const studentName = String(n.student.name);
    let start = 0;
    while (start >= 0 && start < text.length) {
      const idx = text.indexOf(studentName, start);
      if (idx < 0) break;
      builder.setLinkUrl(idx, idx + studentName.length, url);
      start = idx + studentName.length;
    }
  });
  return builder.build();
}

