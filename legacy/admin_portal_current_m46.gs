function getCachedManagerDataV5367_(kind, builder, seconds) {
  const ss = getActiveSpreadsheetV5_();
  const cache = CacheService.getScriptCache();
  const key = getV5367CacheKey_(kind, ss);
  try {
    const raw = cache.get(key);
    if (raw) {
      const parsed = JSON.parse(raw);
      if (parsed && typeof parsed === 'object') {
        parsed.cacheStatusV5367 = { hit: true, kind: kind, cachedAt: parsed.cacheStatusV5367 && parsed.cacheStatusV5367.cachedAt || '' };
      }
      return parsed;
    }
  } catch (err) {}
  const started = Date.now();
  const data = builder(ss) || {};
  try {
    if (data && typeof data === 'object') data.cacheStatusV5367 = { hit: false, kind: kind, builtMs: Date.now() - started, cachedAt: new Date().toISOString() };
    const json = JSON.stringify(data);
    // Apps Script cache values are size-limited. Keep a conservative ceiling.
    if (json.length < 90000) cache.put(key, json, seconds || V5367_MANAGER_CACHE_SECONDS_);
