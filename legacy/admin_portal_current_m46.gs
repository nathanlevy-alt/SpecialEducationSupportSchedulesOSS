function generateStaffPortalLettersPdfV5317(payload) {
  const info = getStaffPortalLetterSchoolContextV5319_();
  const settings = getStaffPortalSettingsV5312();
  const schoolName = info.schoolName || clean_((settings && settings.currentCampusName) || 'School');
  const schoolId = info.schoolId || clean_((settings && settings.selectedCampusId) || getSelectedCampusIdV5312_());
  const baseUrl = clean_((settings && settings.effectiveBaseUrl) || getStaffPortalEffectiveBaseUrlV5312_());
  if (!baseUrl) throw new Error('Set a Staff Portal Base URL in System Admin before generating staff QR letters.');

  const templateProp = getStaffPortalLetterTemplatePropV5319_();
  const template = String((payload && payload.template) || '').trim() || (PropertiesService.getScriptProperties().getProperty(templateProp) || PropertiesService.getScriptProperties().getProperty(V5_STAFF_PORTAL_LETTER_TEMPLATE_PROP_V5317) || defaultStaffPortalLetterTemplateV5317_());
  PropertiesService.getScriptProperties().setProperty(templateProp, template);

  const data = getStaffManagerDataV5();
  const staff = (data && data.staff || []).filter(function(s) {
    const name = clean_(s && s.name || '');
    if (!name) return false;
    const status = normalizeName_(s.status || 'Active');
    return !status || status === 'active' || status === 'lead';
  }).sort(function(a, b) { return clean_(a.name).localeCompare(clean_(b.name)); });
  if (!staff.length) throw new Error('No active staff were found for this school.');

  const today = Utilities.formatDate(new Date(), 'America/Los_Angeles', 'MM/dd/yy');
  const pages = [];
  staff.forEach(function(s) {
    const staffName = clean_(s.name || '');
    const staffLink = buildStaffPortalUrlV5312_({ baseUrl: baseUrl, schoolId: schoolId, staffName: staffName });
    const qrDataUri = fetchStaffPortalQrDataUriV5317_(staffLink);
    const vars = {
      firstName: firstNameV5317_(staffName),
      staffName: staffName,
      schoolName: schoolName,
      staffPortalLink: staffLink,
      date: today
    };
    pages.push(buildStaffPortalLetterPageHtmlV5317_(template, vars, qrDataUri));
  });

  const html = buildStaffPortalLetterDocumentHtmlV5317_(pages, schoolName);
  const blob = HtmlService.createHtmlOutput(html).getBlob().setName('Staff Portal QR Letters.html');
  const pdf = blob.getAs(MimeType.PDF).setName('Staff Portal QR Letters - ' + schoolName + ' - ' + Utilities.formatDate(new Date(), 'America/Los_Angeles', 'yyyyMMdd-HHmm') + '.pdf');
  const file = DriveApp.createFile(pdf);
  const shareInfo = makeStaffQrLetterPdfAccessibleV5320_(file);
  return { ok: true, count: staff.length, url: file.getUrl(), id: file.getId(), name: file.getName(), sharing: shareInfo };
}

function makeStaffQrLetterPdfAccessibleV5320_(file) {
  const info = { mode: 'private' };
  if (!file) return info;
  try {
    const activeEmail = String(Session.getActiveUser().getEmail() || '').trim();
    if (activeEmail) {
      try { file.addViewer(activeEmail); info.viewerAdded = activeEmail; } catch (viewerErr) { info.viewerError = String(viewerErr && viewerErr.message || viewerErr); }
    }
  } catch (emailErr) {
    info.viewerLookupError = String(emailErr && emailErr.message || emailErr);
  }
  try {
    file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    info.mode = 'anyoneWithLink';
    return info;
  } catch (anyoneErr) {
    info.anyoneWithLinkError = String(anyoneErr && anyoneErr.message || anyoneErr);
  }
  try {
    file.setSharing(DriveApp.Access.DOMAIN_WITH_LINK, DriveApp.Permission.VIEW);
    info.mode = 'domainWithLink';
    return info;
  } catch (domainErr) {
    info.domainWithLinkError = String(domainErr && domainErr.message || domainErr);
  }
  return info;
}

function firstNameV5317_(fullName) {
  fullName = clean_(fullName || '');
  if (!fullName) return '';
  const comma = fullName.indexOf(',');
  if (comma >= 0) {
    const after = clean_(fullName.slice(comma + 1));
    return clean_(after.split(/\s+/)[0] || fullName);
  }
  return clean_(fullName.split(/\s+/)[0] || fullName);
}

function fetchStaffPortalQrDataUriV5317_(url) {
  const endpoint = V5_STAFF_PORTAL_QR_ENDPOINT_V5317 + '?text=' + encodeURIComponent(url) + '&size=300&margin=2&format=png';
  const res = UrlFetchApp.fetch(endpoint, { muteHttpExceptions: true, followRedirects: true });
  const code = res.getResponseCode();
  if (code < 200 || code >= 300) throw new Error('QR code API returned HTTP ' + code + '.');
  const blob = res.getBlob();
  return 'data:' + (blob.getContentType() || 'image/png') + ';base64,' + Utilities.base64Encode(blob.getBytes());
}

function replaceStaffLetterPlaceholdersV5317_(text, vars) {
  text = String(text || '');
