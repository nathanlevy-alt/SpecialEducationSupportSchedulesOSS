  const current = getRawBellScheduleNamesFromSheetV5324_(ss);
  if (!current.length) return getScheduleBuilderDataV5();
  const currentByKey = {};
  current.forEach(function(name) { currentByKey[normalizeName_(name)] = name; });
  const seen = {};
  const ordered = [];
  requested.forEach(function(name) {
    const key = normalizeName_(name);
    if (!key || seen[key] || !currentByKey[key]) return;
    seen[key] = true;
