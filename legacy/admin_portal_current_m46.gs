function eventStudentGroupsByStaffV5143_(students, staffNames) {
  const groups = {};
  staffNames.forEach(function(st){ groups[st] = []; });
  if (!staffNames.length) return groups;
  if (!students.length) return groups;
  if (staffNames.length === 1) {
    groups[staffNames[0]] = students.slice();
    return groups;
  }
  students.forEach(function(stu, idx) {
    const staff = staffNames[idx % staffNames.length];
    groups[staff].push(stu);
  });
  return groups;
}

function applySpecialEventsForItemV5143_(model, item, needs, periodResult) {
  const events = (model && model.specialEvents) || [];
  if (!events.length || !item) return;
  const studentNamesToRemove = {};
  events.forEach(function(ev) {
    if (!specialEventOverlapsItemV5143_(model, ev, item)) return;
    (ev.students || []).forEach(function(name) { if (name) studentNamesToRemove[normalizeName_(name)] = true; });
  });
  if (Object.keys(studentNamesToRemove).length) {
    for (let i = needs.length - 1; i >= 0; i--) {
      if (needs[i] && needs[i].student && studentNamesToRemove[normalizeName_(needs[i].student.name)]) needs.splice(i, 1);
    }
  }
  events.forEach(function(ev) {
    if (!specialEventOverlapsItemV5143_(model, ev, item)) return;
    const staffNames = (ev.staff || []).map(clean_).filter(Boolean);
    const eventStudents = (ev.students || []).map(clean_).filter(Boolean);
    if (!staffNames.length) return;
    const groups = eventStudentGroupsByStaffV5143_(eventStudents, staffNames);
    staffNames.forEach(function(staffName) {
      const staff = model.staffByName.get(normalizeName_(staffName));
      if (!staff || staff.absent) {
        v5Log_('WARN', 'Special Event staff was not available for ' + (ev.name || 'Special Event') + '.', { staff: staffName, event: ev.name || '', period: item.label });
        return;
      }
      const studentList = groups[staffName] || [];
      if (!studentList.length && eventStudents.length) return;
      const specialNeeds = (studentList.length ? studentList : [ev.name || 'Special Event']).map(function(studentName) {
        return specialEventNeedV5143_(model, ev, item, studentName);
      });
      assignSpecialEventGroupToStaffV5143_(model, staff, item, specialNeeds, periodResult, ev);
    });
  });
}

function assignSpecialEventGroupToStaffV5143_(model, staff, item, group, periodResult, ev) {
  if (!group || !group.length) return;
  const existing = periodResult.staffAssignments.get(staff.name);
  if (existing) {
    existing.needs = existing.needs.concat(group);
    existing.studentNames = existing.studentNames.concat(group.map(function(n){return n.student.name;}));
    existing.specialEvent = true;
    existing.source = existing.source || 'Special Event: ' + (ev.name || 'Special Event');
    group.forEach(function(n){ periodResult.studentToStaff.set(n.student.name, staff.name); });
    return;
  }
  periodResult.staffAssignments.set(staff.name, {
    staff: staff.name,
    period: item.label,
    location: ev.name || 'Special Event',
    locationKey: normalizeLocation_(ev.name || 'Special Event'),
    needs: group.slice(),
    studentNames: group.map(function(n){return n.student.name;}),
    support: 'SPECIAL_EVENT',
    containsIndividual: false,
    source: 'Special Event: ' + (ev.name || 'Special Event'),
    specialEvent: true,
    notes: ['Special Event']
  });
  group.forEach(function(n){ periodResult.studentToStaff.set(n.student.name, staff.name); });
  periodResult.specialEventCount = (periodResult.specialEventCount || 0) + group.length;
  v5Log_('INFO', 'Assigned Special Event ' + (ev.name || '') + ' to ' + staff.name + ' for ' + item.label + '.', {
    event: ev.name || '',
    staff: staff.name,
    students: group.map(function(n){return n.student.name;}),
    period: item.label
  });
}

function getAssignedNeedForStudentItemV5143_(assignments, periodLabel, studentName) {
  const pr = assignments && assignments.byPeriod ? assignments.byPeriod.get(periodLabel) : null;
  if (!pr || !pr.staffAssignments) return null;
  let found = null;
  pr.staffAssignments.forEach(function(a) {
    if (found) return;
    (a.needs || []).forEach(function(n) {
      if (!found && n && n.student && normalizeName_(n.student.name) === normalizeName_(studentName)) found = n;
    });
  });
  return found;
}

function buildAssignmentsBreaksWithEmergencyLunchV5_(model) {
  model.emergencyLunchStaff = new Set();
  let assignments = buildAssignmentsV5_(model);
  let breaks = buildBreakScheduleV5_(model, assignments);
  let freeTime = computeStaffFreeTimeV5_(model, assignments, breaks);

  const lunchResult = assignments.byPeriod && assignments.byPeriod.get('Lunch');
  const initialLunchUnassigned = lunchResult ? (lunchResult.unassigned || []) : [];
  if (!model.config.allowEmergencyLunchCoverage || !initialLunchUnassigned.length) {
    return { assignments: assignments, breaks: breaks, freeTime: freeTime, emergencyLunchStaff: Array.from(model.emergencyLunchStaff) };
  }

  const eligibleOvertimeStaff = model.staff.filter(function(staff) {
    return staff && staff.overtimeInterest && !staff.absent;
  });
  if (!eligibleOvertimeStaff.length) {
    v5Log_('INFO', 'Emergency lunch coverage was enabled, but no present staff are marked Overtime Interest = Yes.', {
      lunchUnassigned: initialLunchUnassigned.map(function(n) { return n.student.name; })
    });
    return { assignments: assignments, breaks: breaks, freeTime: freeTime, emergencyLunchStaff: Array.from(model.emergencyLunchStaff) };
  }

  v5Log_('INFO', 'Emergency lunch coverage cycle started.', {
    explanation: 'Lunch still had uncovered students after primary/secondary coverage. The script will add staff marked Overtime Interest = Yes to emergency lunch coverage one at a time, rerunning assignments and breaks after each addition.',
    lunchUnassigned: initialLunchUnassigned.map(function(n) { return n.student.name; }),
    overtimeStaff: eligibleOvertimeStaff.map(function(s) { return s.name; })
  });

  let best = { assignments: assignments, breaks: breaks, freeTime: freeTime, unassignedCount: initialLunchUnassigned.length };
  for (let i = 0; i < eligibleOvertimeStaff.length; i++) {
    const staff = eligibleOvertimeStaff[i];
    model.emergencyLunchStaff.add(staff.name);
    v5Log_('INFO', 'Emergency lunch coverage added overtime staff and reran schedule.', {
      staff: staff.name,
      explanation: staff.name + ' is now available for emergency lunch coverage and will not be scheduled for a regular lunch-time break.'
    });
    assignments = buildAssignmentsV5_(model);
    breaks = buildBreakScheduleV5_(model, assignments);
    freeTime = computeStaffFreeTimeV5_(model, assignments, breaks);
    const lr = assignments.byPeriod && assignments.byPeriod.get('Lunch');
    const remaining = lr ? (lr.unassigned || []) : [];
    if (remaining.length < best.unassignedCount) {
      best = { assignments: assignments, breaks: breaks, freeTime: freeTime, unassignedCount: remaining.length };
    }
    v5Log_('INFO', 'Emergency lunch coverage pass finished.', {
      emergencyLunchStaff: Array.from(model.emergencyLunchStaff),
      remainingLunchUnassigned: remaining.map(function(n) { return n.student.name; })
    });
    if (!remaining.length) {
      v5Log_('INFO', 'Emergency lunch coverage cycle completed. All lunch students are covered.', {
        emergencyLunchStaff: Array.from(model.emergencyLunchStaff)
      });
      return { assignments: assignments, breaks: breaks, freeTime: freeTime, emergencyLunchStaff: Array.from(model.emergencyLunchStaff) };
    }
  }

  v5Log_('WARN', 'Emergency lunch coverage cycle finished with lunch students still uncovered.', {
    emergencyLunchStaff: Array.from(model.emergencyLunchStaff),
    explanation: 'All present staff marked Overtime Interest = Yes were tried. Remaining uncovered lunch students could not be assigned without violating availability, room, student-block, support-type, or group-size rules.'
  });
  return { assignments: assignments, breaks: breaks, freeTime: freeTime, emergencyLunchStaff: Array.from(model.emergencyLunchStaff) };
}

function buildAssignmentsV5_(model) {
  const result = {
    byPeriod: new Map(),
    unassigned: [],
    allowedUnstaffed: [],
    assignedCount: 0,
    periodSummaries: []
  };

  model.schedule.assignmentItems.forEach(function(item) {
    const periodResult = initializePeriodResult_(item);
    const needs = getNeedsForItem_(model, item);
    applySpecialEventsForItemV5143_(model, item, needs, periodResult);
    periodResult.needs = needs;
    v5Log_('INFO', 'Assigning ' + item.label, { needCount: needs.length, specialEventCount: (periodResult.specialEventCount || 0) });

    applyPriorityHoldsV5_(model, item, needs, periodResult);
    assignForcedRestStaffDirectSupportV5189_(model, item, needs, periodResult);
    assignByPreferenceV5_(model, item, needs, periodResult);
    assignByGeneralPoolV5_(model, item, needs, periodResult);

    if (model.config.shuffleStaffToAvoidUncovered) {
      runIndividualStarRescueV5_(model, item, needs, periodResult);
      runSimpleSwapRescueV5_(model, item, needs, periodResult);
    }

    applyAssignmentOptimizationPostPeriodV5_(model, item, needs, periodResult);

    const allUnassigned = needs.filter(function(n) { return !periodResult.studentToStaff.has(n.student.name); });
    const unassigned = [];
    allUnassigned.forEach(function(n) {
      if (isAllowedUnstaffedNeedV5_(model, n)) {
        periodResult.allowedUnstaffed.push(n);
        result.allowedUnstaffed.push(n);
        v5Log_('WARN', 'Allowed unstaffed by Assignment Optimization: ' + n.student.name + ' for ' + item.label + '.', {
          period: item.label,
          student: n.student.name,
          priority: n.student.priority,
          location: n.location,
          support: n.supportRaw,
          explanation: 'This student is intentionally published without staff because the accepted Assignment Optimization option explicitly allowed the student to remain unstaffed for this period.'
        });
      } else {
        unassigned.push(n);
      }
    });
    unassigned.forEach(function(n) {
      periodResult.unassigned.push(n);
      result.unassigned.push(n);
      const drilldown = buildUnassignedDecisionContextV512_(model, item, n, periodResult);
      v5Log_('WARN', 'Could not assign ' + n.student.name + ' (Priority ' + n.student.priority + ') for ' + item.label + ' in ' + n.location + '.', {
        period: item.label,
        student: n.student.name,
        priority: n.student.priority,
        location: n.location,
        support: n.supportRaw,
        primaryStaff: n.primary || '',
        secondaryStaff: n.secondary || '',
        explanation: drilldown.explanation,
        decisionReason: drilldown.decisionReason,
        rejectionSummary: drilldown.rejectionSummary,
        candidateStaffChecked: drilldown.candidateStaffChecked
      });
    });

    periodResult.assignedCount = needs.length - allUnassigned.length;
    result.assignedCount += periodResult.assignedCount;
    result.byPeriod.set(item.label, periodResult);
    result.periodSummaries.push({ period: item.label, assigned: periodResult.assignedCount, unassigned: unassigned.length, allowedUnstaffed: periodResult.allowedUnstaffed.length, total: needs.length });
  });

  return result;
}

function initializePeriodResult_(item) {
  return {
    item: item,
    staffAssignments: new Map(),
    studentToStaff: new Map(),
    unassigned: [],
    allowedUnstaffed: [],
    needs: [],
    assignedCount: 0
  };
}

function getNeedsForItem_(model, item) {
  const needs = [];
  model.students.forEach(function(student) {
    if (student.absent) return;
    const need = student.needs[item.label];
    if (!need) return;
    if (!need.location || isNA_(need.location)) return;
    if (canonicalStudentSupportTypeV51227_(need.supportType || 'N/A') === 'NA') return;
    if (!need.support || need.support === 'NA') return;
    needs.push({
      student: student,
      period: item.label,
      item: item,
      location: need.location,
      locationKey: need.locationKey,
      support: need.support,
      supportRaw: need.supportRaw,
      supportType: displayStudentSupportTypeV51227_(need.supportType || 'N/A'),
      primary: need.primary,
      secondary: need.secondary,
      source: '',
      notes: []
    });
  });
  needs.sort(compareNeedPriority_);
  return needs;
}

function applyPriorityHoldsV5_(model, item, needs, periodResult) {
  const holdsForItem = [];
  model.staff.forEach(function(staff) {
    staff.priorityHolds.forEach(function(hold) {
      if (hold.period === item.label) holdsForItem.push({ staff: staff, hold: hold });
    });
  });

  holdsForItem.forEach(function(entry) {
    const staff = entry.staff;
    const hold = entry.hold;
    if (staff.absent) return;
    if (isStaffBlockedForItem_(staff, item)) {
      v5Log_('WARN', 'Priority Hold ignored because staff is time-blocked', { staff: staff.name, hold: hold.raw });
      return;
    }
    const candidates = needs.filter(function(n) {
      return !periodResult.studentToStaff.has(n.student.name) && normalizeLocation_(n.location) === normalizeLocation_(hold.location);
    }).sort(function(a, b) {
      const am = supportTypeMatchScoreV51227_(a, staff);
      const bm = supportTypeMatchScoreV51227_(b, staff);
      if (am !== bm) return bm - am;
      return compareNeedPriority_(a, b);
    });

    for (let i = 0; i < candidates.length; i++) {
      const anchor = candidates[i];
      const group = buildAssignableGroupForStaff_(model, item, anchor, needs, staff, periodResult, 'Priority Hold');
      if (group.length && canStaffTakeGroup_(model, staff, item, group, periodResult)) {
        assignGroupToStaff_(model, staff, item, group, periodResult, 'Priority Hold: ' + hold.raw);
        return;
      }
    }
    v5Log_('INFO', 'Priority Hold found no eligible student/group', { staff: staff.name, hold: hold.raw });
  });
}

function assignByPreferenceV5_(model, item, needs, periodResult) {
  needs.forEach(function(anchor) {
    if (periodResult.studentToStaff.has(anchor.student.name)) return;
    const prefs = unique_([anchor.primary, anchor.secondary].filter(Boolean));
    for (let i = 0; i < prefs.length; i++) {
      const staff = model.staffByName.get(normalizeName_(prefs[i]));
      if (!staff) continue;
      let source = i === 0 ? 'Primary Staff' : 'Secondary Staff';
      if (anchor.secondaryPrimarySwap) source = i === 0 ? 'Secondary-as-Primary Staff' : 'Original Primary as Secondary Staff';
      const group = buildAssignableGroupForStaff_(model, item, anchor, needs, staff, periodResult, source);
      if (group.length && canStaffTakeGroup_(model, staff, item, group, periodResult)) {
        assignGroupToStaff_(model, staff, item, group, periodResult, source);
        return;
      }
    }
  });
}


