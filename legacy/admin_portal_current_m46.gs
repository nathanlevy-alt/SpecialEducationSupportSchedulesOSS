function buildDaisyChainRestCandidatesV5180_(model, assignments, item, restAssignment, breakerName, start, end, dutyBusyByStaff, periodResult) {
  const out = [];
  if (!periodResult || !periodResult.staffAssignments) return out;
  periodResult.staffAssignments.forEach(function(moverAssignment, moverName) {
    if (moverName === breakerName) return;
    const mover = model.staffByName.get(normalizeName_(moverName));
    if (!mover || mover.absent) return;
    if (!isStaffAvailableForWindowV5_(mover, item, start, end, dutyBusyByStaff, model, assignments)) return;
    if (!canStaffCoverGroupDuringWindowV5_(model, mover, item, restAssignment.needs, start, end)) return;
    periodResult.staffAssignments.forEach(function(helperAssignment, helperName) {
      if (helperName === breakerName || helperName === moverName) return;
      const helper = model.staffByName.get(normalizeName_(helperName));
      if (!helper || helper.absent) return;
      if (!isStaffAvailableForWindowV5_(helper, item, start, end, dutyBusyByStaff, model, assignments)) return;
      const helperScore = canStaffTemporarilyCoverRestWithExistingAssignmentV5166_(model, helper, item, moverAssignment, helperAssignment, start, end);
      if (!helperScore) return;
      const impactedNeeds = (restAssignment.needs || []).concat(moverAssignment.needs || []).concat(helperAssignment.needs || []);
      const score = priorityImpactScoreForNeedsV5180_(model, impactedNeeds, restAssignment.location || moverAssignment.location || helperAssignment.location, V5_DAISY_CHAIN_PENALTY_V5205_);
      score.familiarity = Math.max(helperScore.familiarity || 0, familiarScoreForRestAssignmentV5202_(mover, restAssignment));
      out.push({
        name: mover.name,
        staff: mover,
        score: score,
        daisyChain: true,
        helperStaff: helper.name,
        helperCoveringFor: mover.name,
        helperLocation: moverAssignment.location || '',
        helperStudents: (moverAssignment.studentNames || []).join(', '),
        impactedStudents: (moverAssignment.studentNames || []).concat(helperAssignment.studentNames || [])
      });
    });
  });
  return out;
}

function findCoverForRestDutyNoDaisyV5208_(model, assignments, item, assignment, breakerName, start, end, dutyBusyByStaff) {
  const periodResult = assignments.byPeriod.get(item.label);
  const breakerOffCampus = (typeof isOffCampusLocationV5150_ === 'function') && isOffCampusLocationV5150_(model, assignment && assignment.location);

  const freeCandidates = model.staff.filter(function(staff) {
    if (!staff || staff.absent || staff.name === breakerName) return false;
    if (!isStaffAvailableForWindowV5_(staff, item, start, end, dutyBusyByStaff, model, assignments)) return false;
    if (periodResult && periodResult.staffAssignments && periodResult.staffAssignments.has(staff.name)) return false;
    if (breakerOffCampus) return false;
    return canStaffCoverGroupDuringWindowV5_(model, staff, item, assignment.needs, start, end);
  }).sort(compareFreeRestCoverageStaffV5202_(assignment));
  if (freeCandidates.length) return freeCandidates[0];

  if (model.config.temporaryGroupForRest && periodResult && periodResult.staffAssignments) {
    const directCandidates = [];
    periodResult.staffAssignments.forEach(function(existingAssignment, staffName) {
      if (staffName === breakerName) return;
      const staff = model.staffByName.get(normalizeName_(staffName));
      if (!staff || staff.absent) return;
      if (!isStaffAvailableForWindowV5_(staff, item, start, end, dutyBusyByStaff, model, assignments)) return;
      let score = null;
      if (breakerOffCampus) {
        if (typeof canStaffCoverCombinedOffCampusAssignmentsV5150_ === 'function' && canStaffCoverCombinedOffCampusAssignmentsV5150_(model, staff, item, assignment, existingAssignment)) {
          score = priorityImpactScoreForNeedsV5180_(model, (assignment.needs || []).concat(existingAssignment.needs || []), assignment.location || existingAssignment.location, 0);
        }
      } else {
        score = canStaffTemporarilyCoverRestWithExistingAssignmentV5166_(model, staff, item, assignment, existingAssignment, start, end);
      }
      if (score) directCandidates.push({ name: staff.name, staff: staff, score: score, temporaryGroupForRest: true, directTemporaryGroup: true });
    });
    directCandidates.sort(compareDirectTemporaryRestCandidateV5202_(assignment));
    if (directCandidates.length) {
      const d = directCandidates[0];
      const chosenDirect = Object.assign({}, d.staff);
      chosenDirect.temporaryGroupForRest = true;
      chosenDirect.directTemporaryGroup = true;
      v5Log_('INFO', 'Direct same-location temporary grouping selected for staff rest.', {
        staffOnBreak: breakerName,
        coveringStaff: chosenDirect.name,
        period: item.label,
        score: d.score,
        explanation: 'V5.1.208 non-daisy pass: direct same-location grouping is preferred after true free coverage. Max Group Size = 0 students are never grouped.'
      });
      return chosenDirect;
    }
  }

  const leadCandidates = buildLeadRestCoverageCandidatesV5202_(model, item, assignment, breakerName, start, end, dutyBusyByStaff);
  if (leadCandidates.length) {
    v5Log_('WARN', 'Lead staff used for protected rest coverage.', {
      staffOnBreak: breakerName,
      coveringStaff: leadCandidates[0].name,
      period: item.label,
      students: (assignment.needs || []).map(function(n) { return n.student && n.student.name; }).filter(Boolean),
      minPriority: minPriorityForNeedsV5205_(assignment.needs),
      hasZeroMaxGroupSize: hasZeroMaxGroupSizeNeedV5202_(assignment.needs),
      explanation: 'V5.1.208 non-daisy pass: Lead coverage is used after free/direct options for Max Group Size = 0 or very low numeric priority students.'
    });
    return leadCandidates[0];
  }

  return null;
}

function findDaisyOnlyForRestDutyV5208_(model, assignments, item, assignment, breakerName, start, end, dutyBusyByStaff) {
  const periodResult = assignments.byPeriod.get(item.label);
  const breakerOffCampus = (typeof isOffCampusLocationV5150_ === 'function') && isOffCampusLocationV5150_(model, assignment && assignment.location);
  if (!model.config.temporaryGroupForRest || !periodResult || !periodResult.staffAssignments || breakerOffCampus) return null;
  const daisyCandidates = buildDaisyChainRestCandidatesV5180_(model, assignments, item, assignment, breakerName, start, end, dutyBusyByStaff, periodResult);
  daisyCandidates.sort(compareTemporaryRestScoresV5180_);
  if (!daisyCandidates.length) return null;
  const c = daisyCandidates[0];
  const chosen = Object.assign({}, c.staff || { name: c.name });
  chosen.temporaryGroupForRest = true;
  chosen.daisyChain = true;
  chosen.helperStaff = c.helperStaff || '';
  chosen.helperCoveringFor = c.helperCoveringFor || '';
