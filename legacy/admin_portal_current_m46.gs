  return [].concat(base, [
    'Staff','Staff Manager','StaffData','Staff Data',
    'Students','Student Manager','StudentData','Student Data',
    'Attendance','_ScheduleHistory','_V5Properties','_CampusRegistry','_CampusUsers','_CampusSystem'
  ]).filter(Boolean).filter(function(n){ const k=String(n); if(seen[k])return false; seen[k]=true; return true; });
}

function stripDatabaseValidationRulesV5340_(ss) {
  ss = ss || getActiveSpreadsheetV5_();
  const names = databaseSheetNamesV5340_();
  let sheetsTouched = 0, cellsTouched = 0;
  names.forEach(function(name) {
    const sh = ss.getSheetByName(name);
    if (!sh) return;
    const rows = Math.max(1, sh.getMaxRows ? sh.getMaxRows() : sh.getLastRow());
    const cols = Math.max(1, sh.getMaxColumns ? sh.getMaxColumns() : sh.getLastColumn());
    if (!rows || !cols) return;
    try {
      sh.getRange(1, 1, rows, cols).clearDataValidations();
      sheetsTouched++;
      cellsTouched += rows * cols;
    } catch (err) {
      try { sh.getDataRange().clearDataValidations(); sheetsTouched++; cellsTouched += Math.max(1, sh.getLastRow()) * Math.max(1, sh.getLastColumn()); } catch (err2) {}
    }
  });
  return { sheetsTouched: sheetsTouched, cellsTouched: cellsTouched };
}

