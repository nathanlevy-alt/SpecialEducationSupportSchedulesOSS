  function formatPublishNavStampV51248(stamp){
    var s=String(stamp||'').trim();
    if(!s)return '';
    var parts=s.split(' ').filter(function(x){return !!x;});
    if(parts.length>=2){
      var datePart=parts.shift();
      var bits=datePart.split('/');
      if(bits.length>=2 && bits[0] && bits[1]) return bits[0]+'/'+bits[1]+' '+parts.join(' ');
    }
    var d=new Date(s);
    if(!isNaN(d.getTime())){
      var hr=d.getHours();
      var ampm=hr>=12?'PM':'AM';
      hr=hr%12; if(!hr)hr=12;
      var min=d.getMinutes();
      var mm=(min<10?'0':'')+min;
      return (d.getMonth()+1)+'/'+d.getDate()+' '+hr+':'+mm+' '+ampm;
    }
    return s;
  }
