  sheet.getRange(2, unassignedStart, 1, 5).setValues([['Student / Staff', 'Priority', 'Location', 'Support / Assignment', 'Period']]).setFontWeight('bold').setBackground('#bfbfbf');
  const unassignedRows = assignments.unassigned.map(function(n) { return [n.student.name, n.student.priority, n.location, n.supportRaw, n.period]; });
  if (unassignedRows.length) {
    sheet.getRange(3, unassignedStart, unassignedRows.length, 5).setValues(unassignedRows);
