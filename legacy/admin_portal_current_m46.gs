function configureAutoPublishTriggerV543_() {
  const handler = 'autoPublishScheduleCheckV543';
  const triggers = ScriptApp.getProjectTriggers();
  triggers.forEach(function(t) {
    if (t.getHandlerFunction && t.getHandlerFunction() === handler) ScriptApp.deleteTrigger(t);
  });
  const offset = getDocumentPropertiesV650_().getProperty('V5_AUTO_PUBLISH_OFFSET_MINUTES') || '';
  if (['15','30','45','60'].indexOf(offset) < 0) return {enabled:false};
  ScriptApp.newTrigger(handler).timeBased().everyMinutes(5).create();
  return {enabled:true, offsetMinutes:Number(offset)};
}

function autoPublishScheduleCheckV543() {
  const props = getDocumentPropertiesV650_();
  const offset = Number(props.getProperty('V5_AUTO_PUBLISH_OFFSET_MINUTES') || 0);
  if ([15,30,45,60].indexOf(offset) < 0) return {ok:false, message:'Auto-publish not enabled.'};
  const ss = getActiveSpreadsheetV5_();
  ensureCoreSheetsV5_(ss);
  const today = dateOnly_(new Date());
  const key = dateKeyV5_(today);
  const win = getWorkdayWindowForDateV5_(ss, today);
  if (!win || win.startMinutes == null) return {ok:false, message:'No workday start found.'};
  const now = new Date();
  const nowM = now.getHours() * 60 + now.getMinutes();
  const target = win.startMinutes - offset;
  if (nowM < target || nowM >= target + 5) return {ok:false, message:'Not in auto-publish window.'};
  const runKey = key + '|' + offset;
  if (props.getProperty('V5_AUTO_PUBLISH_LAST_KEY') === runKey) return {ok:false, message:'Already auto-published.'};
  const status = publishCurrentSchedulesV5();
  props.setProperty('V5_AUTO_PUBLISH_LAST_KEY', runKey);
  v5Toast_('Schedule auto-published ' + offset + ' minutes before the workday start.', 'Auto-publish', 5);
  return {ok:true, status:status};
}


// V5.1.62 Scenario Preview: lightweight direct run, no initial precomputation.
function getScenarioPreviewMetaV562() {
