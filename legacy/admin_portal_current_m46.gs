function isOnOrAfterSchoolYearStartV5288_(dateValue) {
  const start = parseSchoolYearStartDateV5288_();
  if (!start) return true;
  const d = dateValue instanceof Date ? dateValue : parseAttendanceDateValueV5_(dateValue, dateValue);
  if (!d) return false;
  const dd = new Date(d.getFullYear(), d.getMonth(), d.getDate());
  const ss = new Date(start.getFullYear(), start.getMonth(), start.getDate());
  return dd.getTime() >= ss.getTime();
}

