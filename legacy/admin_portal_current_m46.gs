function runScenarioPreviewWithProjectedV562(payload) {
  payload = payload || {};
  const selectedDate = String(payload.date || payload.scenarioDate || '').trim();
  const selectedType = String(payload.scheduleType || payload.scenarioType || '').trim();
  const projectedStaff = (payload.projectedAbsences || payload.projectedStaffAbsences || []).map(function(x) { return normalizeName_(x); }).filter(Boolean);
  const projectedStudents = (payload.projectedStudentAbsences || payload.projectedStudents || []).map(function(x) { return normalizeName_(x); }).filter(Boolean);
  const ignoredKnown = (payload.ignoredKnownAbsences || payload.suppressedKnownAbsences || []).map(function(x) { return normalizeName_(x); }).filter(Boolean);

  const model = buildScenarioModelV5_({ date: selectedDate, scheduleType: selectedType });
  const targetKey = scenarioDateKeyFromInputV5_(selectedDate) || dateKeyV5_(model.schedule.date);
  const attendanceRows = getAttendanceRowsForDateKeyV5_(model.ss, targetKey);

  const knownAbsent = {};
  attendanceRows.forEach(function(row) {
    const key = normalizeName_(row.name);
    if (!key) return;
    const dayPart = String(row.dayPart || '').toLowerCase();
    if (dayPart.indexOf('partial') < 0) knownAbsent[key] = true;
  });

  (model.staff || []).forEach(function(staff) {
    const key = normalizeName_(staff.name);
    if ((knownAbsent[key] && ignoredKnown.indexOf(key) < 0) || projectedStaff.indexOf(key) >= 0) staff.absent = true;
  });
  (model.students || []).forEach(function(student) {
    const key = normalizeName_(student.name);
    if (projectedStudents.indexOf(key) >= 0) student.absent = true;
  });

  const run = buildAssignmentsBreaksWithEmergencyLunchV5_(model);
  const views = buildPortalScheduleViewsV5_(model, run.assignments, run.breaks);
  const absentStaffKeys = new Set((model.staff || []).filter(function(s) { return s.absent; }).map(function(s) { return normalizeName_(s.name); }));
  views.staffSchedules = (views.staffSchedules || []).filter(function(row) { return !absentStaffKeys.has(normalizeName_(row.staff)); });
  views.breakItems = ((run.breaks && run.breaks.items) || []).map(function(b) {
    const c = {};
    for (var k in b) c[k] = b[k];
    if (!c.time && c.startMinutes != null && c.endMinutes != null) c.time = formatTimeRange_(c.startMinutes, c.endMinutes);
    return c;
  });
  views.scenarioDate = targetKey;
  views.scheduleType = model.schedule.scheduleType || selectedType;
  views.upcomingLabel = 'Upcoming Schedule - ' + targetKey;

  const activeStaffKeysForScenario = new Set(getActiveStaffNamesV5_(model.ss).map(function(n) { return normalizeName_(n); }));
  const absentStaff = (model.staff || []).filter(function(s) {
    return s.absent && activeStaffKeysForScenario.has(normalizeName_(s.name)) && isActiveOrBlankStatusForOut_(s);
  }).map(function(s) {
    const key = normalizeName_(s.name);
    return { staff: s.name, detail: (knownAbsent[key] && ignoredKnown.indexOf(key) < 0) ? 'Known absence from Attendance' : 'Projected potential absence' };
  }).sort(function(a, b) { return String(a.staff).localeCompare(String(b.staff)); });
  const absentStudents = (model.students || []).filter(function(s) { return projectedStudents.indexOf(normalizeName_(s.name)) >= 0; }).map(function(s) {
    return { student: s.name, detail: 'Projected student absence' };
  }).sort(function(a, b) { return String(a.student).localeCompare(String(b.student)); });
  const unassigned = extractUnassignedFromViewsV5_(views);

  return {
    views: views,
    impact: {
      absentStaff: absentStaff,
      absentStaffCount: absentStaff.length,
      knownAbsentNames: Object.keys(knownAbsent).filter(function(k){ return ignoredKnown.indexOf(k) < 0 && activeStaffKeysForScenario.has(k); }).map(function(k){ const st=(model.staff||[]).find(function(s){return normalizeName_(s.name)===k;}); return st ? st.name : k; }),
      absentStudents: absentStudents,
      absentStudentCount: absentStudents.length,
      attendanceRowsMatched: attendanceRows.length,
      targetDate: targetKey,
      requestedDate: selectedDate,
      modelDate: dateKeyV5_(model.schedule.date),
      unassigned: unassigned,
      unassignedCount: unassigned.length
    }
  };
}

function publishScenarioScheduleV562(scenarioData) {
  const views = scenarioData && scenarioData.views ? scenarioData.views : scenarioData;
  if (!views) throw new Error('Run a scenario preview before publishing.');
