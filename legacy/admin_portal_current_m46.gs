function reorderStaffOrderFromManagerV5367_original_(payload) {
  const ss = getActiveSpreadsheetV5_();
  ensureCoreSheetsV5_(ss);
  const sheet = ss.getSheetByName(V5.SHEETS.STAFF);
  const order = (payload && payload.order) || [];
  if (!order.length) throw new Error('No staff order was provided.');

  const lastRow = sheet.getLastRow();
  const lastCol = Math.max(sheet.getLastColumn(), 9);
  if (lastRow < 2) return { ok: true, message: 'No staff rows to reorder.' };

  const range = sheet.getRange(2, 1, lastRow - 1, lastCol);
  const values = range.getValues();
  const formulas = range.getFormulas();
  const display = range.getDisplayValues();

  const rowObjects = [];
  for (let i = 0; i < values.length; i++) {
    const name = clean_(display[i][0] || values[i][0]);
    if (!name) continue;
    rowObjects.push({ rowIndex: i + 2, name: name, values: values[i], formulas: formulas[i] });
  }

  const byRow = new Map();
  rowObjects.forEach(function(obj) { byRow.set(String(obj.rowIndex), obj); });

  const seenRows = new Set();
  const reordered = [];
  order.forEach(function(item) {
    const rowKey = String(item.rowIndex || '');
    if (!rowKey || seenRows.has(rowKey)) return;
    const obj = byRow.get(rowKey);
    if (obj) {
      reordered.push(obj);
      seenRows.add(rowKey);
    }
  });

  rowObjects.forEach(function(obj) {
    const rowKey = String(obj.rowIndex);
    if (!seenRows.has(rowKey)) reordered.push(obj);
  });

  if (reordered.length !== rowObjects.length) {
    throw new Error('Staff order could not be saved because one or more staff rows could not be matched. Refresh data and try again.');
  }

  const output = reordered.map(function(obj) {
    return obj.values.map(function(value, colIndex) {
      // Preserve formulas when present. Formula columns are repaired below when needed.
      return obj.formulas[colIndex] || value;
    });
  });

  if (output.length) sheet.getRange(2, 1, output.length, lastCol).setValues(output);
  ensureStaffTotalAbsenceFormulasV5_(sheet);
  try { sheet.getRange(2, 2, output.length, 1).insertCheckboxes(); } catch (e) {}
  SpreadsheetApp.flush();
  refreshV5ValidationHelpers();
  return { ok: true, message: 'Saved staff order. General available staff now follows the physical order on Staff.' };
}

function ensureStaffTotalAbsenceFormulasV5_(sheet) {
  if (!sheet) return;
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return;
  const formulas = [];
  for (let r = 2; r <= lastRow; r++) {
    formulas.push(['=IF(A' + r + '="", "", COUNTIF(Attendance!B:B, A' + r + '))']);
  }
  // H = Total Absences in the confirmed staff layout.
  sheet.getRange(2, 8, formulas.length, 1).setFormulas(formulas);
}


