    function restHtml(events){return (events||[]).map(function(ev){var t=String(ev.type||'').toLowerCase(); var kind=t.indexOf('lunch')>=0?'Lunch':(t.indexOf('break')>=0?'Break':'Rest'); var who=ev.role==='helperCover'?("Covering for "+(ev.helperCoveringFor||ev.coveringStaff||'staff')):(ev.role==='cover'?("Covering "+(ev.staffOnBreak||'staff')+"'s "+kind):kind); if(ev.role==='cover'&&ev.daisyChain&&ev.helperStaff){who='Covered by '+ev.helperStaff+'; '+who;} var standalone=(ev.role!=='cover'&&ev.role!=='helperCover'&&(who==='Break'||who==='Lunch')); var students=String(ev.students||'').trim(); var location=String(ev.location||'').trim(); var html='<div class="rest"><b>'+(standalone?'<span style="background:#fff59d;padding:1px 3px;border-radius:3px">'+esc(who)+'</span>':esc(who))+'</b>'+(ev.time?'<br>'+esc(ev.time):''); if(students&&students.toUpperCase()!=='N/A') html+='<br>'+esc(students); if(location&&location.toUpperCase()!=='N/A') html+='<div class="muted">'+esc(location)+'</div>'; return html+'</div>';}).join('');}
    function normPortalNameV5313(v){return String(v||'').toLowerCase().trim().replace(/[^a-z0-9]+/g,'');}
    function renderMySchedule(){var staff=linkedStaffName(); var tab=id('myScheduleTab'), box=id('myScheduleContent'), stamp=id('myScheduleStaff'); if(tab)tab.style.display=staff?'inline-flex':'none'; if(stamp)stamp.textContent=staff?staff:''; if(!box)return !!staff; if(!staff){box.innerHTML='<div class="muted">Open a staff-specific link to view My Schedule.</div>'; return false;} var items=DATA.items||[], row=(DATA.staffSchedules||[]).find(function(s){return normPortalNameV5313(s.staff)===normPortalNameV5313(staff);}); if(!row){box.innerHTML='<div class="mCard muted">No published schedule found for '+esc(staff)+'.</div>'; return true;} var cards=items.map(function(it){var r=(row.rows||[]).find(function(x){return x.period===it.label;})||{}; var html=cellStaff(r); return '<div class="mCard"><div class="mTitle">'+esc(it.title||it.label||'')+'</div><div>'+html+'</div></div>';}).join(''); var related=(DATA.breakItems||[]).filter(function(b){return normPortalNameV5313(b.staffOnBreak)===normPortalNameV5313(staff)||normPortalNameV5313(b.coveringStaff)===normPortalNameV5313(staff)||normPortalNameV5313(b.helperStaff)===normPortalNameV5313(staff)||normPortalNameV5313(b.helperCoveringFor)===normPortalNameV5313(staff);}); if(related.length){function clean(v){v=String(v||'').trim(); return (v.toUpperCase()==='N/A'||v.toUpperCase()==='NA')?'':v;} cards+='<h3>Break / Lunch / Coverage</h3>'+related.map(function(b){var role=normPortalNameV5313(b.staffOnBreak)===normPortalNameV5313(staff)?'Scheduled '+(b.type||'break/lunch'):'Covering '+(b.staffOnBreak||'staff'); var detail=[clean(b.students),clean(b.location)].filter(Boolean).join(' · '); return '<div class="mCard"><div class="mTitle">'+esc(b.time||'')+'</div><div><b>'+esc(role)+'</b></div><div class="muted">'+esc(detail)+'</div></div>';}).join('');} box.innerHTML=cards||'<div class="mCard muted">No schedule rows found.</div>'; return true;}
    function renderStaff(){var items=DATA.items||[], titles=itemTitles(), rows=DATA.staffSchedules||[]; id('staffDesktop').innerHTML='<table class="scheduleTable"><thead><tr><th>Staff</th>'+titles.map(function(t){return '<th>'+esc(t)+'</th>'}).join('')+'</tr></thead><tbody>'+rows.map(function(s){return '<tr><td>'+esc(s.staff)+'</td>'+items.map(function(it){var r=(s.rows||[]).find(function(x){return x.period===it.label;})||{}; return '<td>'+cellStaff(r)+'</td>';}).join('')+'</tr>'}).join('')+'</tbody></table>'; id('staffMobile').innerHTML='';}
