  const vals = sheet.getRange(2, col, last - 1, 1).getDisplayValues().flat();
  return unique_(vals.map(function(v) { return cleanLocationDisplay_(v); }).filter(Boolean));
}

function getColumnValues_(sheet, col, startRow) {
  const last = sheet.getLastRow();
  if (last < startRow) return [];
  return sheet.getRange(startRow, col, last - startRow + 1, 1).getDisplayValues().flat().map(clean_).filter(Boolean);
}

function getScheduleTypesV5_() {
  const ss = getActiveSpreadsheetV5_();
  const names = getRawBellScheduleNamesFromSheetV5324_(ss);
  return applyBellScheduleOrderV5324_(names);
}

function getRawBellScheduleNamesFromSheetV5324_(ss) {
  ss = ss || getActiveSpreadsheetV5_();
  const sheet = ss.getSheetByName(V5.SHEETS.SCHEDULES);
  if (!sheet || sheet.getLastRow() < 2) return [];
  return unique_(sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).getDisplayValues().flat().map(clean_).filter(Boolean));
}

function getSavedBellScheduleOrderV5324_() {
  try {
    const raw = getV5PublishProps_().getProperty('V5_BELL_SCHEDULE_ORDER_JSON') || '';
    const parsed = raw ? JSON.parse(raw) : [];
    return Array.isArray(parsed) ? parsed.map(clean_).filter(Boolean) : [];
  } catch (e) {
    return [];
  }
}

function applyBellScheduleOrderV5324_(names) {
  names = unique_((names || []).map(clean_).filter(Boolean));
  if (!names.length) return [];
  const byKey = {};
  names.forEach(function(name) { byKey[normalizeName_(name)] = name; });
  const seen = {};
  const out = [];
  getSavedBellScheduleOrderV5324_().forEach(function(savedName) {
    const key = normalizeName_(savedName);
    if (!key || seen[key] || !byKey[key]) return;
    seen[key] = true;
    out.push(byKey[key]);
  });
  names.slice().sort(function(a, b) { return a.localeCompare(b); }).forEach(function(name) {
    const key = normalizeName_(name);
    if (!seen[key]) {
      seen[key] = true;
      out.push(name);
    }
  });
  return out;
}

function saveBellScheduleOrderV5324_(names) {
  const cleaned = unique_((names || []).map(clean_).filter(Boolean));
  try { getV5PublishProps_().setProperty('V5_BELL_SCHEDULE_ORDER_JSON', JSON.stringify(cleaned)); } catch (e) {}
  return cleaned;
}

function syncBellScheduleOrderAfterTemplateSaveV5324_(ss, savedName) {
  const current = getRawBellScheduleNamesFromSheetV5324_(ss);
  if (!current.length) return [];
  const ordered = applyBellScheduleOrderV5324_(current);
  const key = normalizeName_(savedName);
  if (key && !ordered.some(function(name) { return normalizeName_(name) === key; })) ordered.push(savedName);
  const currentKeys = {};
  current.forEach(function(name) { currentKeys[normalizeName_(name)] = true; });
  return saveBellScheduleOrderV5324_(ordered.filter(function(name) { return currentKeys[normalizeName_(name)]; }));
}

function syncBellScheduleOrderAfterTemplateDeleteV5324_(ss, deletedName) {
  const current = getRawBellScheduleNamesFromSheetV5324_(ss);
  const currentKeys = {};
  current.forEach(function(name) { currentKeys[normalizeName_(name)] = true; });
  const deletedKey = normalizeName_(deletedName);
  const ordered = applyBellScheduleOrderV5324_(current).filter(function(name) {
    const key = normalizeName_(name);
    return key && key !== deletedKey && currentKeys[key];
  });
  return saveBellScheduleOrderV5324_(ordered);
}

function indexByName_(items) {
  const m = new Map();
  items.forEach(function(item) { m.set(normalizeName_(item.name), item); });
  return m;
}

function getHeaderMap_(sheet) {
  const headers = sheet.getRange(1, 1, 1, Math.max(1, sheet.getLastColumn())).getDisplayValues()[0];
  const map = new Map();
  headers.forEach(function(h, idx) { if (h) map.set(normalizeHeader_(h), idx + 1); });
  return map;
}

function findHeaderCol_(headerMap, aliases, fallback) {
  // Defensive lookup: most callers pass a Map from getHeaderMap_(), but a few
  // older utility paths can pass a plain object/array. Keep this tolerant so
  // setup UI changes cannot crash load with "headerMap.has is not a function".
  const map = headerMap instanceof Map
    ? headerMap
    : (function() {
        const rebuilt = new Map();
        if (Array.isArray(headerMap)) {
          headerMap.forEach(function(h, idx) {
            if (h) rebuilt.set(normalizeHeader_(h), idx + 1);
          });
        } else if (headerMap && typeof headerMap === 'object') {
          Object.keys(headerMap).forEach(function(k) {
            rebuilt.set(normalizeHeader_(k), headerMap[k]);
          });
        }
        return rebuilt;
      })();
  for (let i = 0; i < aliases.length; i++) {
    const key = normalizeHeader_(aliases[i]);
    if (map.has(key)) return map.get(key);
  }
  return fallback || null;
}

function normalizeHeader_(value) {
  return String(value || '').toLowerCase().replace(/[#*]/g, '').replace(/\s+/g, ' ').trim();
}

function normalizeName_(value) {
  return String(value || '').trim().replace(/\s+/g, ' ').toLowerCase();
}

function normalizeLocation_(value) {
  return cleanLocationDisplay_(value).toLowerCase().replace(/\s+/g, ' ').trim();
}

function normalizeKey_(value) {
  // Used by drag-and-drop row reordering and lookup helpers.
  // Keep this intentionally aligned with normalizeName_ so names match consistently.
  return normalizeName_(value);
}

function cleanLocationDisplay_(value) {
  let s = clean_(value);
  s = s.replace(/\.0$/, '');
  return s;
}

function clean_(value) {
  if (value === null || value === undefined) return '';
  return String(value).trim();
}

function isNA_(value) {
  const s = String(value || '').trim().toLowerCase();
  return !s || s === 'n/a' || s === 'na' || s === 'none';
}

function unique_(arr) {
  const out = [];
  const seen = new Set();
  (arr || []).forEach(function(v) {
    const s = clean_(v);
    if (!s) return;
    const key = s.toLowerCase();
    if (!seen.has(key)) { seen.add(key); out.push(s); }
  });
  return out;
}

function numberOrDefault_(value, def) {
  const n = Number(value);
  return isNaN(n) ? def : n;
}

function positiveNumberOrNull_(value) {
  const n = Number(value);
  return (!isNaN(n) && n > 0) ? n : null;
}

/**
 * Staff-Out should only list staff who are genuinely absent today, not rows that are out
 * because their Status is LOA, LEAD, Vacancy, Inactive, etc.
 * Blank is treated as active so formula-driven absence rows still display.
 */
function isActiveOrBlankStatusForOut_(staff) {
  const status = clean_(staff && staff.status ? staff.status : '').toLowerCase();
  if (!status) return true;
  return status === 'active';
}

function yesNo_(value, defaultValue) {
  const s = String(value || '').trim().toLowerCase();
  if (['yes', 'y', 'true', '1', 'checked'].indexOf(s) >= 0) return true;
  if (['no', 'n', 'false', '0', 'unchecked'].indexOf(s) >= 0) return false;
  if (value === true) return true;
  if (value === false) return false;
  return defaultValue;
}

function checkboxOrYes_(raw, display) {
  if (raw === true) return true;
  if (raw === false) return false;
  return yesNo_(display || raw, false);
}

function normalizeGroupingStrategy_(value) {
  const s = String(value || '').trim().toLowerCase().replace(/[^a-z]/g, '');
  if (['heterogenous', 'hetrogenous', 'heterogeneous', 'hetrogeneous'].indexOf(s) >= 0) return 'HETEROGENOUS';
  return 'HOMOGENOUS';
}

function dateOnly_(date) {
  const d = new Date(date);
  d.setHours(0, 0, 0, 0);
  return d;
}

function sameDate_(a, b) {
  if (!a) return false;
  const da = dateOnly_(a);
  const db = dateOnly_(b);
  return da.getTime() === db.getTime();
}

function formatDate_(date) {
  return Utilities.formatDate(dateOnly_(date), 'America/Los_Angeles', 'M/d/yyyy');
}

function valuesToHtmlTable_(values) {
  return '<table border="1" cellpadding="4" cellspacing="0" style="border-collapse:collapse;font-family:Arial;font-size:12px;">' +
    values.map(function(row) {
      return '<tr>' + row.map(function(cell) { return '<td>' + escapeHtml_(cell) + '</td>'; }).join('') + '</tr>';
    }).join('') + '</table>';
}

function escapeHtml_(value) {
  return String(value || '').replace(/[&<>"]/g, function(c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]; });
}

// V5.1.266: Alias used by newer Staff Portal HTML title rendering.
function escHtml_(value) {
  return escapeHtml_(value);
}

function writeHeadersIfEmptyOrDifferent_(sheet, headers) {
  const current = sheet.getRange(1, 1, 1, headers.length).getDisplayValues()[0];
  const allBlank = current.every(function(v) { return !String(v || '').trim(); });
  if (allBlank) sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
  formatHeaderRow_(sheet, headers.length);
}

function formatHeaderRow_(sheet, cols) {
  sheet.getRange(1, 1, 1, cols).setFontWeight('bold').setBackground('#c9c9c9').setWrap(true).setVerticalAlignment('middle');
  sheet.setFrozenRows(1);
}

function setDefaultIfBlank_(range, value) {
  if (String(range.getDisplayValue() || '').trim() === '') range.setValue(value);
}

function clearSheetFully_(sheet) {
  try { sheet.getRange(1, 1, sheet.getMaxRows(), sheet.getMaxColumns()).breakApart(); } catch (e) {}
  sheet.clear();
}

function v5Log_(level, message, context) {
  V5_LOG.push({ timestamp: new Date(), level: level, message: message, context: context || null });
  try { Logger.log(level + ': ' + message + (context ? ' ' + JSON.stringify(context) : '')); } catch (e) {}
}

function resetV5Log_() { V5_LOG = []; }

function v5Toast_(message, title, seconds) {
  try { getActiveSpreadsheetV5_().toast(message, title || 'Admin Portal', seconds || 5); } catch (e) {}
}


