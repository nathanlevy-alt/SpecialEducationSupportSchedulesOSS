        if (!name || normalizeName_(name).indexOf('vacancy') === 0) return;
        const statusKey = normalizeName_(row[8] || 'Active');
        const active = !statusKey || statusKey === 'active' || /^active\b/.test(statusKey);
        if (!active) return;
        if (boolV5392_(row[1])) addStaffAbsence_(name, 'Full day', '', false);
      });
    }
  } catch (staffErr) { out.staffFastError = String(staffErr && staffErr.message || staffErr); }

  try {
    const attendanceRows = getAttendanceRowsForDateKeyV5_(ss, todayKey) || [];
    attendanceRows.forEach(function(r) {
      const dayPart = clean_(r.dayPart || 'Full day');
      const partial = normalizeName_(dayPart).indexOf('partial') >= 0;
      const detail = partial ? (dayPart || 'Partial day') : '';
      addStaffAbsence_(r.name, partial ? 'Partial day' : 'Full day', detail, partial);
    });
  } catch (attErr) { out.attendanceFastError = String(attErr && attErr.message || attErr); }

  out.staffAbsences = Object.keys(staffByKey).map(function(k){ return staffByKey[k]; }).sort(function(a,b){ return String(a.staff||'').localeCompare(String(b.staff||'')); });
  out.studentAbsences.sort(function(a,b){ return String(a.student||'').localeCompare(String(b.student||'')); });
  out.dataUpdates.sort(function(a,b){ return (Number(b.days) || 9999) - (Number(a.days) || 9999); });
  out.elapsedMs = Date.now() - started;
  try { getDocumentCacheV650_().put(key, JSON.stringify(out), 180); } catch (e2) {}
  return out;
}

function boolV5392_(value) {
  const s = String(value == null ? '' : value).trim().toLowerCase();
  if (!s) return false;
  return s === 'true' || s === 'yes' || s === 'y' || s === '1' || s === 'checked' || s === 'x';
}

// =====================================================================================
// V5.1.393 Staff Manager chunked cache + diagnostics.
// This keeps the V5.1.392 dashboard behavior and only speeds/reliabilizes Staff Manager.
// =====================================================================================
const V5393_STAFF_MANAGER_CACHE_SECONDS_ = 20 * 60;
const V5393_STAFF_MANAGER_CACHE_PREFIX_ = 'V5393_STAFF_MANAGER_GZIP_';

function getStaffManagerCacheKeyV5393_(ss) {
  ss = ss || getActiveSpreadsheetV5_();
  const sid = ss.getId();
  const props = PropertiesService.getScriptProperties();
  const bust = props.getProperty('V5393_STAFF_MANAGER_BUST_' + sid) || '0';
  return V5393_STAFF_MANAGER_CACHE_PREFIX_ + sid + '_' + bust;
}

function removeChunkedCacheV5393_(cache, key) {
  try {
    cache = cache || CacheService.getScriptCache();
    const metaRaw = cache.get(key + '_META');
    const keys = [key + '_META'];
    if (metaRaw) {
      const meta = JSON.parse(metaRaw);
      const count = Number(meta && meta.chunkCount || 0);
      for (let i = 0; i < count; i++) keys.push(key + '_' + i);
    }
    cache.removeAll(keys);
  } catch (err) {}
}

function readChunkedCacheV5393_(cache, key) {
  try {
    cache = cache || CacheService.getScriptCache();
    const metaRaw = cache.get(key + '_META');
    if (!metaRaw) return null;
    const meta = JSON.parse(metaRaw);
    const count = Number(meta && meta.chunkCount || 0);
    if (!count) return null;
    let b64 = '';
    for (let i = 0; i < count; i++) {
      const part = cache.get(key + '_' + i);
      if (!part) return null;
      b64 += part;
    }
    const bytes = Utilities.base64Decode(b64);
    const blob = Utilities.newBlob(bytes, 'application/gzip', 'staff-manager.json.gz');
    const json = Utilities.ungzip(blob).getDataAsString('UTF-8');
    const parsed = JSON.parse(json);
    if (parsed && typeof parsed === 'object') {
      parsed.cacheStatusV5393 = { hit: true, cachedAt: meta.cachedAt || '', compressedBytes: b64.length, chunkCount: count };
    }
    return parsed;
  } catch (err) {
    return null;
  }
}

function writeChunkedCacheV5393_(cache, key, data, seconds) {
  try {
    cache = cache || CacheService.getScriptCache();
    const json = JSON.stringify(data || {});
    const gz = Utilities.gzip(Utilities.newBlob(json, 'application/json', 'staff-manager.json')).getBytes();
    const b64 = Utilities.base64Encode(gz);
    const chunkSize = 85000;
    const chunks = [];
    for (let i = 0; i < b64.length; i += chunkSize) chunks.push(b64.substring(i, i + chunkSize));
    const meta = { version: '5.1.393', cachedAt: new Date().toISOString(), jsonBytes: json.length, compressedChars: b64.length, chunkCount: chunks.length };
    const values = {};
    values[key + '_META'] = JSON.stringify(meta);
    chunks.forEach(function(part, i) { values[key + '_' + i] = part; });
    Object.keys(values).forEach(function(k) { cache.put(k, values[k], seconds || V5393_STAFF_MANAGER_CACHE_SECONDS_); });
    return meta;
  } catch (err) {
    return { error: String(err && err.message || err) };
  }
}

function getStaffManagerDataV5() {
  const ss = getActiveSpreadsheetV5_();
  const cache = CacheService.getScriptCache();
  const key = getStaffManagerCacheKeyV5393_(ss);
  const cached = readChunkedCacheV5393_(cache, key);
  if (cached) return cached;
  const started = Date.now();
  const data = getStaffManagerDataV5367_uncached_() || {};
  if (data && typeof data === 'object') {
    data.cacheStatusV5393 = { hit: false, builtMs: Date.now() - started, cachedAt: new Date().toISOString() };
  }
  const meta = writeChunkedCacheV5393_(cache, key, data, V5393_STAFF_MANAGER_CACHE_SECONDS_);
  if (data && typeof data === 'object') data.cacheStatusV5393.writeMeta = meta;
  return data;
}

function invalidateStaffManagerCacheV5393_(ss) {
  try {
    ss = ss || getActiveSpreadsheetV5_();
    const sid = ss.getId();
    const props = PropertiesService.getScriptProperties();
    const oldKey = getStaffManagerCacheKeyV5393_(ss);
