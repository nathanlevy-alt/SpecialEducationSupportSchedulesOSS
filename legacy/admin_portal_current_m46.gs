function chooseRestCoverageByMethodV5209_(model, assignments, rows, staffName, dutyBusyByStaff, method) {
  for (let i = 0; i < rows.length; i++) {
    const row = rows[i];
    if (!row || !row.assignment) continue;
    let cover = null;
    if (method === 'free') cover = findFreeCoverForRestWindowV5209_(model, assignments, row, staffName, dutyBusyByStaff);
    else if (method === 'direct') cover = findDirectCoverForRestWindowV5209_(model, assignments, row, staffName, dutyBusyByStaff);
    else if (method === 'lead') cover = findLeadCoverForRestWindowV5209_(model, assignments, row, staffName, dutyBusyByStaff);
    else if (method === 'daisy') cover = findDaisyCoverForRestWindowV5209_(model, assignments, row, staffName, dutyBusyByStaff);
    if (cover) {
      v5Log_(method === 'daisy' ? 'WARN' : 'INFO', 'Rest coverage selected by method-wide pass.', {
