  } else {
    const parsedMaxGroupSizeV5203 = Number(rawMaxGroupSizeSaveV5203);
    rowValues[35] = isFinite(parsedMaxGroupSizeV5203) && parsedMaxGroupSizeV5203 >= 0 ? parsedMaxGroupSizeV5203 : '';
  }
  // Data Files URL is written through the canonical Data Manager column helper below.
  // Do not write it as part of the broad row save, because databases with older validation
  // rules can reject unrelated period/support cells when the whole row is re-written.
  rowValues[36] = existingFormulas[36] || existingValues[36] || '';
  // Data Points and Data Files Last Updated are display/read-only fields. Preserve formulas/values.
  rowValues[37] = existingFormulas[37] || existingValues[37] || '';
  rowValues[38] = existingFormulas[38] || existingValues[38] || '';

  setStudentCoreRowValuesSafelyV5335_(sheet, rowIndex, rowValues, existingValues, existingFormulas, isNewRowV5335);
  // V5.1.204: force-write Max Group Size after row write so 0 cannot be lost by falsy handling or stale formatting.
  writeMaxGroupSizeCellV5204_(sheet, rowIndex, rowValues[35]);
  writeStudentDataFilesUrlCellV5334_(sheet, rowIndex, payload.dataFiles || '');
  try { sheet.getRange(rowIndex, 3).insertCheckboxes(); } catch (e) {}

