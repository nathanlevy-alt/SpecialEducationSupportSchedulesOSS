  if (V5263_CAMPUS_PROPERTY_CACHE[ssId]) return V5263_CAMPUS_PROPERTY_CACHE[ssId];
  const sheet = getCampusPropertySheetV5263_(ss);

  // One-time migration for the original/backing school only. This preserves the
  // old single-school published/regular state without leaking it to newly copied schools.
