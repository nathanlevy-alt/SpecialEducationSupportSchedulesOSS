const V5_DATA_FILE_DISCOVERY_TYPE_SCAN_V5212_ = 3000;

function compactDataFileSearchTextV5212_(value) {
  return String(value || '').toLowerCase().replace(/[^a-z0-9]+/g, '');
}

function tokenDataFileSearchTextV5212_(value) {
  const tokens = String(value || '').toLowerCase().split(/[^a-z0-9]+/).filter(function(t) { return t && t.length > 1; });
  const seen = {};
  return tokens.filter(function(t) { if (seen[t]) return false; seen[t] = true; return true; });
}

function dataFileSearchMatchesV5212_(rawQuery, parts) {
  const q = String(rawQuery || '').trim();
  if (!q) return true;
  const hay = String((parts || []).join(' '));
  const normalizedHay = normalizeName_(hay);
  const normalizedQ = normalizeName_(q);
  if (normalizedHay.indexOf(normalizedQ) >= 0) return true;
  const compactHay = compactDataFileSearchTextV5212_(hay);
  const compactQ = compactDataFileSearchTextV5212_(q);
  if (compactQ && compactHay.indexOf(compactQ) >= 0) return true;
  const tokens = tokenDataFileSearchTextV5212_(q);
  if (tokens.length && tokens.every(function(t) { return compactHay.indexOf(t) >= 0 || normalizedHay.indexOf(t) >= 0; })) return true;
  return false;
}

function dataFileNameLooksRelevantV5212_(name, rawQuery) {
  const n = String(name || '');
  if (isApprovedDataFileNameV5207_(n)) return true;
  const compact = compactDataFileSearchTextV5212_(n);
  if (compact.indexOf('datafile') >= 0) return true;
  if (compact.indexOf('data') >= 0 && compact.indexOf('file') >= 0) return true;
  if (rawQuery && dataFileSearchMatchesV5212_(rawQuery, [n])) return true;
  return false;
}


