function getPortalDashboardSummaryFastV5195(daysStale) {
  daysStale = Number(daysStale || 14);
  if (!isFinite(daysStale) || daysStale < 0) daysStale = 14;
  const key = 'DASH_SUMMARY_V5195_' + (getActiveSpreadsheetV5_().getId ? getActiveSpreadsheetV5_().getId() : 'default') + '_' + daysStale;
  try {
    const cache = getDocumentCacheV650_();
    const cached = cache.get(key);
    if (cached) {
      const parsed = JSON.parse(cached);
      parsed.cacheStatus = 'cached';
      return parsed;
    }
    const fresh = getPortalDashboardSummaryV5(daysStale);
    fresh.cacheStatus = 'fresh';
    try { cache.put(key, JSON.stringify(fresh), 45); } catch (e) {}
    return fresh;
