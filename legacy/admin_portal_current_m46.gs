function dataFileDriveQueriesV5209_(rawQuery, broad) {
  const base = "mimeType = '" + V5_DATA_FILE_FORM_MIME_V5207_ + "' and trashed = false";
  const queries = [];
  const add = function(q) { if (queries.indexOf(q) < 0) queries.push(q); };
  const suffix = driveQueryEscapeV5207_(V5_DATA_FILE_SUFFIX_V5207_);
  const raw = driveQueryEscapeV5207_(rawQuery || '');
  if (raw) {
    add(base + " and name contains '" + raw + "'");
    add(base + " and fullText contains '" + raw + "'");
  }
  add(base + " and name contains '" + suffix + "'");
  add(base + " and fullText contains '" + suffix + "'");
  if (broad) add(base);
  return queries;
}

function listDriveFilesRestV5209_(q, extraParams, out, seen, rawQuery, source, diagnostics, scanLimit) {
  let pageToken = '';
  let scannedForQuery = 0;
  do {
    const params = Object.assign({
      q: q,
      spaces: 'drive',
      pageSize: 100,
      fields: 'nextPageToken,files(id,name,mimeType,webViewLink,modifiedTime,driveId)',
      orderBy: 'modifiedTime desc',
      includeItemsFromAllDrives: true,
      supportsAllDrives: true
    }, extraParams || {});
    if (pageToken) params.pageToken = pageToken;
    const response = v5DriveRestFetchV5209_('files', params);
    const files = (response && response.files) || [];
    for (let i = 0; i < files.length; i++) {
      if (out.length >= V5_DATA_FILE_SEARCH_MAX_RESULTS_V5207_) break;
      if (scannedForQuery >= scanLimit) break;
      scannedForQuery++;
      addValidatedDataFileResultV5209_(out, seen, files[i], rawQuery, source, diagnostics);
    }
    pageToken = (response && response.nextPageToken) || '';
  } while (pageToken && out.length < V5_DATA_FILE_SEARCH_MAX_RESULTS_V5207_ && scannedForQuery < scanLimit);
}

function listSharedDrivesRestV5209_(diagnostics) {
  const drives = [];
