    function cellStudent(r,mobile){var support=String(r.support||'').trim(); var location=String(r.location||'').trim(); var sNorm=support.toUpperCase(); var lNorm=location.toUpperCase(); var noSupport=!support||sNorm==='N/A'||sNorm==='NA'||sNorm==='NONE'||sNorm==='NO SUPPORT NEEDED'; var noLocation=!location||lNorm==='N/A'||lNorm==='NA'; var hasNeed=!noSupport&&!noLocation; var h=r.staff?esc(r.staff):(r.allowedUnstaffed?'<span class="need">Allowed unstaffed</span>':(hasNeed?'<span class="need">Needs support - unassigned</span>':'<span class="free">No support needed</span>')); var meta=[]; if(!noLocation)meta.push(location); if(!noSupport)meta.push(support); if(meta.length) h+='<div class="muted">'+esc(meta.join(' · '))+'</div>'; return mobile?'<div>'+h+'</div>':'<td>'+h+'</td>';}
