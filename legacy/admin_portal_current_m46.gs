function buildCoverageCoachStaffRestrictionSummaryV5347_(rows) {
  rows = rows || [];
  const out = rows.map(function(s) {
    const timeBlocks = splitCoverageCoachListV5347_(s.timeBlocks);
    const blockedStudents = splitCoverageCoachListV5347_(s.blockedStudents);
    const blockedRooms = splitCoverageCoachListV5347_(s.blockedRooms);
    const holds = splitCoverageCoachListV5347_(s.priorityHolds);
    const rest = [s.lunchPreference, s.lunchPreferenceStrength, s.lunchPreferenceDetail, s.breakPreference, s.breakPreferenceStrength, s.breakPreferenceDetail].filter(function(x) { return clean_(x) && !/^no preference$/i.test(clean_(x)); });
    const statusPenalty = (!isCoverageCoachActiveStatusV5345_(s.status) || /^lead$/i.test(clean_(s.status || '')) || s.absent || s.absentToday) ? 1 : 0;
    const hardCount = timeBlocks.length + blockedStudents.length + blockedRooms.length + statusPenalty;
    const preferenceCount = holds.length + rest.length;
    const total = hardCount + preferenceCount;
    const impact = hardCount >= 5 ? 'High' : (hardCount >= 2 || total >= 5 ? 'Medium' : (total ? 'Low' : 'None'));
    return {
      staff: s.name,
      status: s.status || '',
      supportStaffType: s.supportStaffType || '',
      absent: !!(s.absent || s.absentToday),
      totalConstraints: total,
      hardConstraints: hardCount,
      preferenceConstraints: preferenceCount,
      impact: impact,
      timeBlockCount: timeBlocks.length,
      blockedStudentCount: blockedStudents.length,
      blockedRoomCount: blockedRooms.length,
      priorityHoldCount: holds.length,
      restPreferenceCount: rest.length,
      examples: timeBlocks.slice(0, 3).concat(blockedStudents.slice(0, 2)).concat(blockedRooms.slice(0, 2)).concat(holds.slice(0, 3)).slice(0, 8)
    };
  }).sort(function(a, b) {
    return (b.hardConstraints - a.hardConstraints) || (b.totalConstraints - a.totalConstraints) || String(a.staff).localeCompare(String(b.staff));
  });
  return { count: out.length, mostRestricted: out.slice(0, 15), noRestrictionCount: out.filter(function(x) { return !x.totalConstraints; }).length };
}

