        coveringStaff: cover.name,
        method: restCoverageMethodNameV5209_(method),
        period: row.item && row.item.label,
        targetBlock: !!row.targetBlock,
        explanation: 'V5.1.209 evaluates this coverage method across the whole target/non-target window group before trying the next lower-preference method.'
