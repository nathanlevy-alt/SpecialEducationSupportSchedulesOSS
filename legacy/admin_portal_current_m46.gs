  return uniqueByNormalizedName_(out);
}

function parsePriorityHolds_(text) {
  return parseMultiValueCell_(text).map(function(part) {
    const s = stripDayQualifierIfApplicable_(part);
    if (!s) return null;
    const m = String(s).match(/^(.+?)\s*@\s*(?:Room\s*)?(.+)$/i);
    if (!m) return null;
    const period = periodDisplayToInternalKeyV5322_(m[1]);
    const location = cleanLocationDisplay_(m[2]);
    if (!period || !location) return null;
    return { period: period, location: location, raw: part };
