function parseTimeBlockRules_(text) {
  const parts = splitRules_(text);
  return parts.map(function(raw) {
    const applicable = stripDayQualifierIfApplicable_(raw);
    if (!applicable) return null;
    const s = applicable.trim();
    const period = canonicalPeriodLabel_(s);
    if (period) return { type: 'period', period: period, raw: raw };
    const mAfter = s.match(/^>\s*(\d{1,2}:\d{2}\s*[AP]M)$/i);
    if (mAfter) return { type: 'after', minutes: parseTimeToMinutes_(mAfter[1]), raw: raw };
    const mBefore = s.match(/^<\s*(\d{1,2}:\d{2}\s*[AP]M)$/i);
    if (mBefore) return { type: 'before', minutes: parseTimeToMinutes_(mBefore[1]), raw: raw };
    const mRange = s.match(/^(\d{1,2}:\d{2}\s*[AP]M)\s*-\s*(\d{1,2}:\d{2}\s*[AP]M)$/i);
    if (mRange) return { type: 'range', start: parseTimeToMinutes_(mRange[1]), end: parseTimeToMinutes_(mRange[2]), raw: raw };
    return { type: 'unknown', raw: raw };
  }).filter(Boolean);
}

function isStaffBlockedForItem_(staff, item) {
  if (!staff || !staff.timeBlockRules || !staff.timeBlockRules.length) return false;
  for (let i = 0; i < staff.timeBlockRules.length; i++) {
    const rule = staff.timeBlockRules[i];
    if (rule.type === 'period' && rule.period === item.label) return true;
    if (item.startMinutes == null || item.endMinutes == null) continue;
    if (rule.type === 'after' && rule.minutes != null && item.endMinutes > rule.minutes) return true;
    if (rule.type === 'before' && rule.minutes != null && item.startMinutes < rule.minutes) return true;
    if (rule.type === 'range' && rule.start != null && rule.end != null && rangesOverlap_(item.startMinutes, item.endMinutes, rule.start, rule.end)) return true;
  }
  return false;
}

function parsePriorityHolds_(text) {
  const parts = splitRules_(text);
  const holds = [];
  parts.forEach(function(part) {
    const s = stripDayQualifierIfApplicable_(part);
    if (!s) return;
    const m = s.match(/^(Period\s*\d{1,2}|\d{1,2}|Lunch)\s*@\s*(?:Room\s*)?(.+)$/i);
    if (!m) return;
    const period = canonicalPeriodLabel_(m[1]);
    const location = cleanLocationDisplay_(m[2]);
    if (period && location) holds.push({ period: period, location: location, raw: part });
  });
  return holds;
}

function splitRules_(text) {
  return String(text || '')
    .split(/\s*\/\s*|\n|;|,(?=\s*(?:Period|Lunch|[1-6]|>|<|\d{1,2}:))/i)
    .map(function(s) { return s.trim(); })
    .filter(Boolean);
}

function stripDayQualifierIfApplicable_(raw) {
  const s = String(raw || '').trim();
  const m = s.match(/^(.*?)\s*\[([^\]]+)\]\s*$/);
  if (!m) return s;
  const wanted = m[2].trim().toLowerCase();
  const today = ['sunday','monday','tuesday','wednesday','thursday','friday','saturday'][new Date().getDay()];
  return today === wanted ? m[1].trim() : '';
}

function parseMultiValueCell_(value) {
  return String(value || '')
    .split(/\s*\/\s*|\n|;|,/)
    .map(function(s) { return clean_(s); })
    .filter(Boolean);
}



