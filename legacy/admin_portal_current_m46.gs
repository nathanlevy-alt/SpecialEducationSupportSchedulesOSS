          warnings.push({type:'Room-blocked preferred staff', severity:'High', period:item.label, staff:staff.name, detail:staff.name+' is listed as '+kind+' for '+n.student.name+' but is blocked from '+n.location+'.', students:[n.student.name], explanation:'Blocked room/location rules are treated as safety constraints and will not be overridden.'});
