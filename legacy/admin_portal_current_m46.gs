function canStaffTakeIndividualStarRescueGroup_(model, staff, item, group, periodResult) {
  if (!group.length) return false;
  const location = group[0].location;
  if (!isHighlyStructuredRoom_(model, location)) return false;
  if (group.some(function(n) { return normalizeLocation_(n.location) !== normalizeLocation_(location); })) return false;
  if (group.length > getMaxGroupSizeForNeeds_(model, item, group)) return false;
  for (let i = 0; i < group.length; i++) {
    const n = group[i];
    if (staff.blockedRooms.has(normalizeLocation_(n.location))) return false;
    if (staff.blockedStudents.has(normalizeName_(n.student.name))) return false;
  }
  return true;
}

function runSimpleSwapRescueV5_(model, item, needs, periodResult) {
  const initiallyUnassigned = needs.filter(function(n) { return !periodResult.studentToStaff.has(n.student.name); }).sort(compareNeedPriority_);
  if (!initiallyUnassigned.length) return;

  v5Log_('INFO', 'Priority audit started for ' + item.label + '.', {
    period: item.label,
    explanation: 'Priority 1 is highest. This audit checks whether a lower-priority assignment can be displaced so a higher-priority unassigned student can be covered.'
  });

  let changed = true;
  let pass = 0;
  const maxPasses = Math.max(1, needs.length + 2);

  while (changed && pass < maxPasses) {
    changed = false;
    pass++;

    const unassigned = needs.filter(function(n) { return !periodResult.studentToStaff.has(n.student.name); }).sort(compareNeedPriority_);
    if (!unassigned.length) break;

    for (let u = 0; u < unassigned.length; u++) {
      const target = unassigned[u];
      if (periodResult.studentToStaff.has(target.student.name)) continue;

      v5Log_('INFO', 'Priority audit reviewing ' + target.student.name + ' (Priority ' + target.student.priority + ') for ' + item.label + '.', {
        period: item.label,
        student: target.student.name,
        priority: target.student.priority,
        location: target.location,
        support: target.supportRaw
      });

      const rescued = tryPriorityDisplacementForTargetV5_(model, item, needs, periodResult, target);
      if (rescued) {
        changed = true;
        break; // Restart from the top so the next highest-priority unassigned student is reviewed first.
      }
    }
  }

  const stillUnassigned = needs.filter(function(n) { return !periodResult.studentToStaff.has(n.student.name); }).sort(compareNeedPriority_);
  if (stillUnassigned.length) {
    v5Log_('INFO', 'Priority audit finished for ' + item.label + ' with unassigned students remaining.', {
      period: item.label,
      unassigned: stillUnassigned.map(function(n) { return n.student.name + ' (P' + n.student.priority + ', ' + n.location + ')'; }),
      explanation: 'Any still-unassigned student could not legally displace a lower-priority assignment without taking staff from a higher/equal-priority student or violating time, room, student-block, support-type, or group-size rules.'
    });
  } else {
    v5Log_('INFO', 'Priority audit finished for ' + item.label + '. All students are assigned.', { period: item.label });
  }
}

function tryPriorityDisplacementForTargetV5_(model, item, needs, periodResult, target) {
  const donorAssignments = [];
  periodResult.staffAssignments.forEach(function(assignment, staffName) {
    const priorities = assignment.needs.map(function(n) { return n.student.priority; });
    const protectedNeeds = assignment.needs.filter(function(n) { return n.student.priority <= target.student.priority; });

    if (protectedNeeds.length) {
      v5Log_('INFO', 'Priority audit did not take ' + staffName + ' from ' + describeAssignmentNeeds_(assignment) + '.', {
        period: item.label,
        staff: staffName,
        target: target.student.name,
        targetPriority: target.student.priority,
        explanation: 'This assignment is protected because it includes student(s) with equal or higher priority than ' + target.student.name + ': ' + protectedNeeds.map(function(n) { return n.student.name + ' (P' + n.student.priority + ')'; }).join(', ') + '.'
      });
      return;
    }

    donorAssignments.push({
      assignment: assignment,
      staffName: staffName,
      count: assignment.needs.length,
      worstPriority: priorities.length ? Math.max.apply(null, priorities) : 999,
      bestPriority: priorities.length ? Math.min.apply(null, priorities) : 999
    });
  });

  donorAssignments.sort(function(a, b) {
    // Prefer displacing the fewest students, then the assignment with the lowest urgency (largest priority numbers).
    if (a.count !== b.count) return a.count - b.count;
    if (a.bestPriority !== b.bestPriority) return b.bestPriority - a.bestPriority;
    if (a.worstPriority !== b.worstPriority) return b.worstPriority - a.worstPriority;
    return String(a.staffName).localeCompare(String(b.staffName));
  });

  for (let i = 0; i < donorAssignments.length; i++) {
    const donor = donorAssignments[i];
    const staff = model.staffByName.get(normalizeName_(donor.staffName));
    if (!staff) {
      v5Log_('INFO', 'Priority audit skipped a possible donor because the staff record was not found: ' + donor.staffName + '.', { period: item.label, staff: donor.staffName });
      continue;
    }

    // IMPORTANT: actually remove the lower-priority donor assignment before testing the donor staff.
    // The previous rescue used a temporary ignore wrapper that could still leave the old assignment
    // in place during parts of the group-building/checking flow. That caused cases where P15/P16
    // stayed assigned while P11/P14 remained uncovered.
    const savedAssignment = cloneAssignmentForRescue_(donor.assignment);
    removeFullAssignment_(periodResult, donor.staffName);

    let targetGroup = [];
    let canUseStaff = false;
    let reason = '';
    try {
      targetGroup = buildAssignableGroupForStaff_(model, item, target, needs, staff, periodResult, 'Priority Rescue');
      if (!targetGroup.length) {
        reason = 'No legal target group could be formed for ' + target.student.name + '.';
      } else if (canStaffTakeGroup_(model, staff, item, targetGroup, periodResult)) {
        canUseStaff = true;
      } else {
        reason = explainStaffCannotTakeGroup_(model, staff, item, targetGroup, periodResult);
      }

      // If the normal group-building could not work, try the target alone. This prevents a
      // lower-priority assigned group from being protected just because another same-room
      // partner could not also fit.
      if (!canUseStaff) {
        const targetAlone = [target];
        if (canStaffTakeGroup_(model, staff, item, targetAlone, periodResult)) {
          targetGroup = targetAlone;
          canUseStaff = true;
          reason = '';
        }
      }
    } finally {
      if (!canUseStaff) {
        restoreAssignmentForRescue_(periodResult, donor.staffName, savedAssignment);
      }
    }

    if (!canUseStaff) {
      v5Log_('INFO', 'Priority audit checked ' + donor.staffName + ' for ' + target.student.name + ' but could not use this staff member.', {
        period: item.label,
        staff: donor.staffName,
        target: target.student.name,
        targetPriority: target.student.priority,
        donorAssignment: describeAssignmentNeeds_(savedAssignment),
        attemptedStudents: targetGroup.length ? targetGroup.map(function(n) { return n.student.name + ' (P' + n.student.priority + ')'; }) : [target.student.name + ' (P' + target.student.priority + ')'],
        explanation: reason || 'The donor staff could not legally cover the target after removing the lower-priority assignment.'
      });
      continue;
    }

    const displacedNames = savedAssignment.needs.map(function(n) { return n.student.name + ' (P' + n.student.priority + ')'; });
    const assignedNames = targetGroup.map(function(n) { return n.student.name + ' (P' + n.student.priority + ')'; });

    assignGroupToStaff_(model, staff, item, targetGroup, periodResult, 'Priority Rescue');

    v5Log_('WARN', 'Priority rescue moved ' + donor.staffName + ' from lower-priority student(s) to higher-priority student(s): ' + assignedNames.join(', ') + '.', {
      period: item.label,
      staff: donor.staffName,
      assignedTo: assignedNames,
      displaced: displacedNames,
      explanation: 'Priority 1 is highest. Every displaced student had a larger priority number than ' + target.student.name + ' (P' + target.student.priority + '), so the lower-number priority was protected first.'
    });
    return true;
  }

  v5Log_('INFO', 'Priority audit could not rescue ' + target.student.name + ' (Priority ' + target.student.priority + ') for ' + item.label + '.', {
    period: item.label,
    student: target.student.name,
    priority: target.student.priority,
    explanation: 'There was no lower-priority-only assignment that could legally be moved to this student.'
  });
  return false;
}

function buildGroupForPriorityRescue_(model, item, target, needs, staff, periodResult, staffToIgnore) {
  const saved = periodResult.staffAssignments.get(staffToIgnore);
  if (saved) {
    saved.needs.forEach(function(n) { periodResult.studentToStaff.delete(n.student.name); });
    periodResult.staffAssignments.delete(staffToIgnore);
  }
  let group = [];
  try {
    group = buildAssignableGroupForStaff_(model, item, target, needs, staff, periodResult, 'Priority Rescue');
  } finally {
    if (saved) {
      periodResult.staffAssignments.set(staffToIgnore, saved);
      saved.needs.forEach(function(n) { periodResult.studentToStaff.set(n.student.name, staffToIgnore); });
    }
  }
  return group;
}


function cloneAssignmentForRescue_(assignment) {
  return {
    staff: assignment.staff,
    period: assignment.period,
    location: assignment.location,
    locationKey: assignment.locationKey,
    needs: assignment.needs.slice(),
    studentNames: assignment.studentNames.slice(),
    support: assignment.support,
    containsIndividual: assignment.containsIndividual,
    source: assignment.source,
    notes: (assignment.notes || []).slice()
  };
}

function restoreAssignmentForRescue_(periodResult, staffName, savedAssignment) {
  periodResult.staffAssignments.set(staffName, savedAssignment);
  savedAssignment.needs.forEach(function(n) { periodResult.studentToStaff.set(n.student.name, staffName); });
}


function describeExistingAssignmentConflictV5130_(assignment) {
  assignment = assignment || {};
  const needs = assignment.needs || [];
  if (!needs.length) return 'Staff already has an assignment in a different location.';
  const first = needs[0] || {};
  const role = String(assignment.source || '').toLowerCase().indexOf('secondary') >= 0 ? 'Secondary' : (String(assignment.source || '').toLowerCase().indexOf('primary') >= 0 ? 'Primary' : 'Other');
  const studentNames = unique_(needs.map(function(n) { return n && n.student ? n.student.name : ''; }).filter(Boolean));
  const priorityText = unique_(needs.map(function(n) { return n && n.student && n.student.priority != null ? String(n.student.priority) : ''; }).filter(Boolean)).join(', ');
  const supportText = unique_(needs.map(function(n) { return n && (n.supportRaw || n.support) ? String(n.supportRaw || n.support) : ''; }).filter(Boolean)).join(', ');
  const locationText = assignment.location || first.location || '';
  let text = 'Supporting ' + role + ' assignment with ' + (studentNames.join(', ') || 'assigned student');
  const pieces = [];
  if (priorityText) pieces.push('priority ' + priorityText);
  if (supportText) pieces.push(supportText);
  if (pieces.length) text += ' (' + pieces.join(' for ') + ')';
  if (locationText) text += ' in ' + locationText;
  return text + '.';
}

function explainStaffCannotTakeGroup_(model, staff, item, group, periodResult) {
  if (!staff) return 'Staff record was not found.';
  if (staff.absent) return 'Staff is absent.';
  if (isStaffBlockedForItem_(staff, item)) return 'Staff is blocked during ' + item.label + '.';
  if (!group || !group.length) return 'No student/group was provided for the assignment check.';
  const firstLocation = normalizeLocation_(group[0].location);
  for (let i = 0; i < group.length; i++) {
    const need = group[i];
    if (normalizeLocation_(need.location) !== firstLocation) return 'The attempted group contains students in different locations.';
    if (staff.blockedRooms.has(normalizeLocation_(need.location))) return 'Staff is blocked from location ' + need.location + '.';
    if (!(item.type === 'lunch' && !model.config.lunchConformsToBlocking) && staff.blockedStudents.has(normalizeName_(need.student.name))) {
      return 'Staff is blocked from student ' + need.student.name + '.';
    }
    const typeReason = supportTypeRestrictionReasonV51228_(model, need, staff);
    if (typeReason) return typeReason;
  }
  if (group.length > getMaxGroupSizeForNeeds_(model, item, group)) return 'The attempted group exceeds the max group size.';
  const existing = periodResult.staffAssignments.get(staff.name);
  if (existing) {
    if (normalizeLocation_(existing.location) !== firstLocation) return describeExistingAssignmentConflictV5130_(existing);
    if (existing.containsIndividual) return 'Staff already has an individual assignment: ' + describeExistingAssignmentConflictV5130_(existing);
    if (group.some(function(n) { return n.support !== 'GROUP'; })) return 'Staff already has a group assignment and the new target is not group-compatible: ' + describeExistingAssignmentConflictV5130_(existing);
    const total = existing.needs.length + group.length;
    if (total > getMaxGroupSizeForNeeds_(model, item, existing.needs.concat(group))) return 'Adding this group would exceed max group size. Existing assignment: ' + describeExistingAssignmentConflictV5130_(existing);
  }
  return 'The assignment conflicts with an assignment rule that could not be narrowed further.';
}


function buildUnassignedDecisionContextV512_(model, item, need, periodResult) {
  const out = {
    explanation: 'After primary staff, secondary staff, general coverage, optimization allowances, and priority rescue were checked, no legal staff assignment remained.',
    decisionReason: '',
    rejectionSummary: [],
    candidateStaffChecked: 0
  };
  try {
    const reasons = new Map();
    const namedOrder = unique_([need.primary, need.secondary].filter(Boolean));
    const orderedStaff = [];
    namedOrder.forEach(function(n) {
      const st = model.staffByName && model.staffByName.get(normalizeName_(n));
      if (st && orderedStaff.indexOf(st) < 0) orderedStaff.push(st);
    });
    (model.staff || []).forEach(function(st) {
      if (orderedStaff.indexOf(st) < 0) orderedStaff.push(st);
    });
    orderedStaff.forEach(function(staff) {
      if (!staff) return;
      out.candidateStaffChecked++;
      let reason = explainStaffCannotTakeGroup_(model, staff, item, [need], periodResult);
      if (namedOrder.indexOf(staff.name) >= 0) reason = (staff.name === need.primary ? 'Primary staff: ' : 'Secondary staff: ') + reason;
      if (!reasons.has(reason)) reasons.set(reason, []);
      const bucket = reasons.get(reason);
      if (bucket.length < 6) bucket.push(staff.name);
    });
    out.rejectionSummary = Array.from(reasons.keys()).map(function(reason) {
      const staff = reasons.get(reason) || [];
      return { reason: reason, staff: staff, count: staff.length };
    });
    if (out.rejectionSummary.length) {
      out.decisionReason = out.rejectionSummary[0].reason;
    }
  } catch (e) {
    out.decisionReason = 'Could not build detailed rejection summary: ' + e.message;
  }
  return out;
}

function removeFullAssignment_(periodResult, staffName) {
  const assignment = periodResult.staffAssignments.get(staffName);
  if (!assignment) return;
  assignment.needs.forEach(function(n) { periodResult.studentToStaff.delete(n.student.name); });
  periodResult.staffAssignments.delete(staffName);
}

function describeAssignmentNeeds_(assignment) {
  if (!assignment || !assignment.needs || !assignment.needs.length) return 'an empty assignment';
  return assignment.needs.map(function(n) { return n.student.name + ' (P' + n.student.priority + ', ' + n.location + ')'; }).join(', ');
}

function explainStaffCannotTakeGroupIgnoringCurrent_(model, staff, item, group, periodResult, staffToIgnore) {
  if (!staff) return 'Staff record was not found.';
  if (staff.absent) return 'Staff is absent.';
  if (isStaffBlockedForItem_(staff, item)) return 'Staff is blocked during ' + item.label + '.';
  for (let i = 0; i < group.length; i++) {
    const need = group[i];
    if (staff.blockedRooms.has(normalizeLocation_(need.location))) return 'Staff is blocked from location ' + need.location + '.';
    if (!(item.type === 'lunch' && !model.config.lunchConformsToBlocking) && staff.blockedStudents.has(normalizeName_(need.student.name))) {
      return 'Staff is blocked from student ' + need.student.name + '.';
    }
    const typeReason = supportTypeRestrictionReasonV51228_(model, need, staff);
    if (typeReason) return typeReason;
  }
  if (group.length > getMaxGroupSizeForNeeds_(model, item, group)) return 'The attempted group exceeds the max group size.';
  const saved = periodResult.staffAssignments.get(staffToIgnore);
  periodResult.staffAssignments.delete(staffToIgnore);
  const allowed = canStaffTakeGroup_(model, staff, item, group, periodResult);
  if (saved) periodResult.staffAssignments.set(staffToIgnore, saved);
  return allowed ? 'Unknown reason after temporary assignment check.' : 'The assignment conflicts with existing location, individual-student, support-type, or capacity rules.';
}

function canStaffTakeGroupIgnoringCurrent_(model, staff, item, group, periodResult, staffToIgnore) {
  const saved = periodResult.staffAssignments.get(staffToIgnore);
  periodResult.staffAssignments.delete(staffToIgnore);
  const allowed = canStaffTakeGroup_(model, staff, item, group, periodResult);
  if (saved) periodResult.staffAssignments.set(staffToIgnore, saved);
  return allowed;
}

function removeNeedFromAssignment_(periodResult, staffName, studentName) {
  const assignment = periodResult.staffAssignments.get(staffName);
  if (!assignment) return;
  assignment.needs = assignment.needs.filter(function(n) { return n.student.name !== studentName; });
  assignment.studentNames = assignment.needs.map(function(n) { return n.student.name; });
  periodResult.studentToStaff.delete(studentName);
  if (!assignment.needs.length) periodResult.staffAssignments.delete(staffName);
}

