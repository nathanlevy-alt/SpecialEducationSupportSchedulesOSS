function buildPriorityHoldOptionsV5_(periods, locations, lunchLocations) {
  const out = ['Coach'];
  const assignmentLocations = uniqueByNormalizedName_((locations || []).map(clean_).filter(Boolean));
  const lunchList = uniqueByNormalizedName_((lunchLocations || []).map(clean_).filter(Boolean));
  (periods || []).forEach(function(p) {
    const key = periodDisplayToInternalKeyV5322_(p);
    if (!key) return;
    const type = (typeof getScheduleItemTypeV5308_ === 'function') ? getScheduleItemTypeV5308_(key) : '';
    const display = displayPeriodForPriorityHoldV5322_(key);
    if (type === 'break') return;
    if (type === 'lunch' || normalizeName_(key) === 'lunch') {
      lunchList.forEach(function(loc){ out.push(display + ' @ ' + loc); });
    } else {
      assignmentLocations.forEach(function(loc){ out.push(display + ' @ Room ' + loc); });
