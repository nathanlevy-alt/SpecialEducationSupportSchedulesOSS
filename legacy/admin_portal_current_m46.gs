}

function attachDisplayPeriodV5158_(row) {
  row = row || {};
  if (row.period && !row.periodDisplay) row.periodDisplay = getPeriodDisplayLabelForOutputV5158_(row.period);
  if (row.item && !row.itemDisplay) row.itemDisplay = getPeriodDisplayLabelForOutputV5158_(row.item);
  return row;
}

function getAssignmentAnalyzerOptionsV5119() {
  const ss = getActiveSpreadsheetV5_();
  if (typeof isBlankSchoolWorkbookFastV652_ === 'function' && isBlankSchoolWorkbookFastV652_(ss)) return { students: [], staff: [], periods: [], periodLabels: {}, blankWorkbook: true, cacheStatus: 'blank-fast-v654' };
  const model = loadModelV5_(ss);
  const periods = (model.schedule.assignmentItems || []).map(function(i){ return i.label; });
  const periodLabels = {};
  periods.forEach(function(p){ periodLabels[p] = getPeriodDisplayLabelForOutputV5158_(p); });
  return {
    students: model.students.filter(function(s){ return s && s.name; }).map(function(s){ return s.name; }).sort(),
    staff: model.staff.filter(function(s){ return s && s.name && !s.statusInactive; }).map(function(s){ return s.name; }).sort(),
    periods: periods,
    periodLabels: periodLabels
