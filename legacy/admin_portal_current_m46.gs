function getLatestModifiedDateInFolderV5_(folder) {
  let latest = folder.getLastUpdated();
  const files = folder.getFiles();
  while (files.hasNext()) {
    const fileDate = files.next().getLastUpdated();
    if (fileDate > latest) latest = fileDate;
  }
  const folders = folder.getFolders();
  while (folders.hasNext()) {
    const subDate = getLatestModifiedDateInFolderV5_(folders.next());
    if (subDate > latest) latest = subDate;
  }
  return latest;
}

