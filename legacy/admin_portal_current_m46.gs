function updateTodoItemV5(id, patch) {
  const ss = getActiveSpreadsheetV5_();
  const sheet = setupTodoSheetV5_(ss);
  id = String(id || '');
  patch = patch || {};
  if (sheet.getLastRow() < 2) return [];
  const values = sheet.getRange(2, 1, sheet.getLastRow() - 1, 6).getValues();
  for (let i = 0; i < values.length; i++) {
    if (String(values[i][0]) === id) {
      const row = i + 2;
      if (Object.prototype.hasOwnProperty.call(patch, 'completed')) {
        const done = patch.completed === true;
        sheet.getRange(row, 4).setValue(done);
        sheet.getRange(row, 6).setValue(done ? new Date() : '');
      }
      if (Object.prototype.hasOwnProperty.call(patch, 'text')) sheet.getRange(row, 3).setValue(String(patch.text || '').trim());
      break;
    }
  }
  return getTodoItemsV5();
}


function deleteTodoItemV5(id) {
  const ss = getActiveSpreadsheetV5_();
  const sheet = setupTodoSheetV5_(ss);
  id = String(id || '');
  if (!id || sheet.getLastRow() < 2) return getTodoItemsV5();
  const values = sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).getValues();
  for (let i = values.length - 1; i >= 0; i--) {
