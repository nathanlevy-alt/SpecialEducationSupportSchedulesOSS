    const userProps = PropertiesService.getUserProperties();
    const campusId = String(userProps.getProperty('V5_SELECTED_CAMPUS_ID') || '').trim();
    const spreadsheetId = String(userProps.getProperty('V5_SELECTED_CAMPUS_SPREADSHEET_ID') || '').trim();
    if (!campusId || !spreadsheetId) return '';
    if (typeof isSelectedCampusAllowedV5370_ === 'function' && !isSelectedCampusAllowedV5370_(campusId, spreadsheetId)) {
      try {
