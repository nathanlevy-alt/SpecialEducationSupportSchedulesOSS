function getScheduleChangeSummaryV5() {
  let current = null, published = null;
  try { current = buildCurrentScheduleViewsForPublishV5_(); } catch (e) {}
  try { published = getPublishedScheduleViewsV5(); } catch (e) {}
  function assignmentKeys(v) {
    const keys = {};
    ((v && v.studentSchedules) || []).forEach(function(st){(st.rows || []).forEach(function(r){keys[st.student + '|' + r.period] = String(r.staff || '');});});
    return keys;
  }
  const a = assignmentKeys(current), b = assignmentKeys(published);
  const all = {};
  Object.keys(a).forEach(function(k){all[k]=true;}); Object.keys(b).forEach(function(k){all[k]=true;});
  let changes = 0; Object.keys(all).forEach(function(k){if ((a[k]||'') !== (b[k]||'')) changes++;});
  const curUn = extractUnassignedFromViewsV5_(current).length;
  const pubUn = extractUnassignedFromViewsV5_(published).length;
  
  const workload = ((current && current.staffSchedules) || []).map(function(s){
    let assignments = 0, individual = 0, group = 0, free = 0;
    (s.rows || []).forEach(function(r){
      const students = r.students || [];
      if (students.length) assignments += students.length; else free++;
      const txt = JSON.stringify(r).toLowerCase();
      if (txt.indexOf('individual') >= 0) individual += students.length || 1;
      if (txt.indexOf('group') >= 0) group += students.length || 1;
    });
    return {staff:s.staff, assignments:assignments, individual:individual, group:group, free:free};
  }).sort(function(a,b){return b.assignments - a.assignments;});
  return {assignmentChanges:changes, currentUnassigned:curUn, publishedUnassigned:pubUn, workload:workload, message: changes ? 'The current generated schedule differs from the last published schedule.' : 'The current generated schedule matches the last published snapshot.'};
}


