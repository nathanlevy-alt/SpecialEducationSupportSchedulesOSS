REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@YOUR_UPSTASH_HOST:6379
GA_ACTIVE_SPREADSHEET_ID=default-school
GA_ACTIVE_USER_EMAIL=you@example.org
EMAIL_TRANSPORT=json
SMTP_FROM=GA Scheduler <you@example.org>

# Google OAuth admin authentication. Staff Portal /staff remains token-based and public-link accessible.
GOOGLE_AUTH_ENABLED=false
PUBLIC_BASE_URL=https://your-render-app.onrender.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=change-this-to-a-long-random-value
AUTH_ALLOWED_EMAILS=you@example.org
AUTH_ALLOWED_DOMAINS=

# Staff Portal token architecture.
# Leave STAFF_PORTAL_SCHOOLS_JSON blank to infer schools from Redis spreadsheet keys.
# Or set explicit JSON, example:
# {"myschool":{"name":"My School Name","spreadsheetId":"GA Scheduler - My School Name"}}
STAFF_PORTAL_SCHOOLS_JSON=
STAFF_PORTAL_DEFAULT_SCHOOL_ID=
STAFF_PORTAL_TOKEN_SECRET=

# Mobile app push notifications. See docs/PUSH_NOTIFICATIONS.md — not required for the rest
# of the app to work; push endpoints degrade gracefully (configured:false) without these.
# Generate your own with `npx web-push generate-vapid-keys` after `npm install`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.org
